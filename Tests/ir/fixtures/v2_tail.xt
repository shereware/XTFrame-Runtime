<xt version="2">

  <ports>
    groups: list<struct{name: string, rows: list<struct{t: string}>}>
  </ports>

  <body>
    <div id="P"></div>
    <repeat port="groups" id="Rows">
      <div id="row"><span id="name" bind:text="item(name)"></span></div>
    </repeat>
  </body>

  <layout>
    #row {
      width: 100px;
      height: 20px;
    }
  </layout>
  <style>
    #row {
      background-color: #3060a0;
      hit-slop: 4px 1em;
    }
  </style>
</xt>
