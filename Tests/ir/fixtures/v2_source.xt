<xt version="2">

  <ports>
    hp: number in
  </ports>

  <body>
    <div id="panel">
      <div id="bar"></div>
      <div id="dot" on:click="class(on, toggle)"></div>
      <div id="tab" bind:class.full="hp | ge(50)"></div>
    </div>
  </body>

  <layout>
    #panel {
      position: absolute;
      left: 20px;
      top: 20px;
      width: 220px;
      height: 140px;
    }
    #bar {
      position: absolute;
      left: 16px;
      top: 20px;
      width: 100px;
      height: 20px;
    }
    #dot {
      position: absolute;
      left: 24px;
      top: 70px;
      width: 40px;
      height: 40px;
    }
    #tab {
      position: absolute;
      left: 120px;
      top: 70px;
      width: 80px;
      height: 40px;
    }
  </layout>
  <style>
    @keyframes slide {
      from {
        translate: 0px 0px;
      }
      to {
        translate: 40px 0px;
      }
    }
    #panel {
      background-color: #204060;
      border-radius: 12px;
      border: 3px #80c0ff;
    }
    #bar {
      background-color: #ffcc00;
      animation: slide 1s linear infinite;
    }
    #dot {
      border-radius: 20px;
      background-color: #ff4060;
      opacity: 0.8;
    }
    #tab {
      background-color: #608020;
    }
    #tab.full {
      background-color: #40ff60;
    }
    #dot.on {
      background-color: #ffffff;
    }
  </style>
</xt>
