<xt>
  <head>
    <!-- T-198: preview of the InputGlyph standard symbol (golden states and thumbnail). -->
    <link href="../../../Assets/Symbols/tokens.xts"/>
    <link rel="symbols" href="../../../Assets/Symbols/InputGlyph.xt"/>
    <style>
      @font-face { font-family: "Noto Sans"; src: "../../fonts/NotoSans-Regular.subset.ttf"; }
      body {
        width: 240px;
        height: 80px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
      #Row { display: flex; column-gap: 16px; }
    </style>
  </head>
  <body>
    <div id="Row">
      <use symbol="InputGlyph" id="Jump" slot:label="Jump"/>
      <use symbol="InputGlyph" id="Use" slot:label="Use"><slot name="glyph"><glyph key="interact"/></slot></use>
    </div>
  </body>
</xt>
