<xt>
  <head>
    <!-- T-198: preview of the Toggle standard symbol (golden states and thumbnail). -->
    <link href="../../../Assets/Symbols/tokens.xts"/>
    <link rel="symbols" href="../../../Assets/Symbols/Toggle.xt"/>
    <style>
      @font-face { font-family: "Noto Sans"; src: "../../fonts/NotoSans-Regular.subset.ttf"; }
      body {
        width: 260px;
        height: 140px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="Toggle" id="Sound" slot:label="Sound"/>
    <use symbol="Toggle" id="Music" slot:label="Music"/>
    <use symbol="Toggle" id="Off" disabled="true" slot:label="Voice chat"/>
  </body>
</xt>
