/* T-683: drop shadows the Painter turns into DrawBoxShadow -- one term (an opaque card) and three (an
   opaque outline with a gap, T-680). */
#back {
  background-color: #e8ecf0;
}
#card {
  background-color: #3060c0;
  border-radius: 6px;
  effect: shadow(4px 6px 8px #000000a0);
}
#outlined {
  background-color: #e04040;
  border-radius: 4px;
  outline: 3px solid #b8322a;
  outline-offset: 4px;
  effect: shadow(3px 5px 10px #000000a0);
}
