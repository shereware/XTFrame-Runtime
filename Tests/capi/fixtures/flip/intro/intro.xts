/* Red, opaque at rest; the intro starts at opacity 0.25 (frame 0) and ends opaque after 0.5s. */
body {
  width: 100vw;
  height: 100vh;
}

#card {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background-color: #ff0000;
  opacity: 1;
}

@timeline intro {
  duration: 0.5s;
  #card {
    0s { opacity: 0.25 }
    0.5s { opacity: 1 }
  }
}
