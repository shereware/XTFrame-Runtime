<xt version="2">

  <ports>
    heavy: bool in = true
  </ports>

  <body>
    <div id="back"></div>
    <div id="a" class="panel" bind:visible="heavy">
      <div id="b" class="panel">
        <div id="c" class="panel">
          <div id="d" class="panel">
            <div id="e" class="panel"></div>
          </div>
        </div>
      </div>
    </div>
    <div id="f" class="side"></div>
    <div id="g" class="side"></div>
  </body>

  <layout src="effects.layout.xts"/>
  <style src="effects.xts"/>
</xt>
