<xt version="2">

  <ports>
    hp: number in
  </ports>

  <body>
    <div id="Bar" bind:width="hp | range(0, 100, 0px, 64px)"></div>
    <div id="Level" state-groups="Level: Warn|Ok"></div>
    <div id="Pulse"></div>
    <div id="Box">
      <div id="S1" class="stripe"></div>
      <div id="S2" class="stripe"></div>
      <div id="S3" class="stripe"></div>
      <div id="S4" class="stripe"></div>
    </div>
  </body>

  <layout src="state.layout.xts"/>
  <style src="state.xts"/>
  <timelines src="state.timelines.xts"/>
</xt>
