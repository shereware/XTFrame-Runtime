{
  "version": 1,
  "name": "L10n fixture",
  "id": "capi-l10n",
  "game": "L10n fixture",
  "spec": {
    "platforms": [
      {
        "name": "desktop",
        "resolutions": [
          [
            1920,
            1080
          ],
          [
            2560,
            1440
          ],
          [
            1280,
            720
          ]
        ]
      }
    ],
    "safeArea": {
      "default": 0,
      "console": 0.05
    },
    "logicalHeight": 64,
    "uiscaleRule": "height",
    "input": {
      "methods": [
        "mouse",
        "gamepad"
      ],
      "players": 1
    },
    "languages": [
      "en",
      "zh-TW"
    ],
    "fontFallback": {},
    "budget": {
      "frameMs": 4,
      "effectLayers": 12,
      "fillRate": 3
    },
    "engine": {
      "name": "",
      "version": ""
    }
  },
  "uis": [
    {
      "id": "l10n",
      "doc": "l10n/l10n.xt",
      "flow": "l10n/l10n.xtflow",
      "size": [
        64,
        64
      ],
      "tags": []
    }
  ],
  "shared": {
    "assetRoot": "shared",
    "fontDirs": [],
    "styles": [],
    "templateDirs": [],
    "symbols": "shared/symbols",
    "tokens": "shared/tokens.xts",
    "themes": "shared/themes",
    "strings": "shared/strings",
    "recipes": "shared/recipes"
  },
  "preview": {
    "dpr": 1
  },
  "target": "engine",
  "publish": {
    "outDir": "out",
    "languages": [],
    "embedImages": false,
    "embedFonts": false,
    "thumbnails": [
      320,
      180
    ],
    "atlas": {
      "enabled": false,
      "maxSize": 4096,
      "padding": 2,
      "mipmaps": false
    }
  }
}
