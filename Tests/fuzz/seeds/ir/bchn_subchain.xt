<!-- T-602: fuzz_ir seed for the BCHN chunk (02 §2.s.4, 03 §3.12.11). Converter sub-chains as a
     format() argument (T-585 F88), a select() value and a step() value. -->
<xt>
  <head><style></style></head>
  <body id="Root">
    <div id="P" port:target_hp="number" port:dmg="number" port:mode="string"></div>
    <span id="T" bind:text="format('{0} → {1}', target_hp, dmg | scale(-1) | offset(target_hp) | round(0))"></span>
    <span id="S" bind:text="mode | select(x: dmg | offset(1), default: 'none')"></span>
    <span id="N" bind:text="target_hp | step(10: port(dmg) | scale(3), default: 0)"></span>
  </body>
</xt>
