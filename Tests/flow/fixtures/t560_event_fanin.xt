<xt version="2">

  <ports>
    fire: event in
    hits: number in
    shot: event out
  </ports>

  <body id="Root"><div id="Hud"
      on:port(fire)="emit(shot)"></div>
    <div id="A"></div>
    <div id="B"></div></body>

  <layout>
    #A {
      width: 40px;
      height: 40px;
    }
    #B {
      width: 40px;
      height: 40px;
    }
  </layout>
</xt>
