<xt version="2">

  <body>
    <div id="none"></div>
    <div id="hidden"><div id="hiddenChild"></div></div>
  </body>

  <layout>
    #none {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 40px;
      height: 40px;
      display: none;
    }
    #hidden {
      position: absolute;
      left: 0px;
      top: 60px;
      width: 40px;
      height: 40px;
    }
    #hiddenChild {
      width: 10px;
      height: 10px;
    }
  </layout>
  <style>
    #hidden {
      visibility: hidden;
    }
    #hiddenChild {
      visibility: visible;
    }
  </style>
</xt>
