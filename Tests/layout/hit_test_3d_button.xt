<xt version="2">

  <body>
    <div id="stage"><div id="card"><div id="btn"></div></div></div>
  </body>

  <layout>
    #stage {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 300px;
      height: 300px;
      perspective: 400px;
    }
    #card {
      position: absolute;
      left: 50px;
      top: 50px;
      width: 150px;
      height: 150px;
      transform: rotateY(30deg);
    }
    #btn {
      position: absolute;
      left: 20px;
      top: 20px;
      width: 40px;
      height: 30px;
    }
  </layout>
  <style>
    #card {
      background-color: #cccccc;
    }
    #btn {
      background-color: #00aa00;
    }
  </style>
</xt>
