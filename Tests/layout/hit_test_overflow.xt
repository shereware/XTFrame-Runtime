<xt version="2">

  <body>
    <div id="outer"><div id="inner"></div></div>
  </body>

  <layout>
    #outer {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100px;
      height: 100px;
      overflow: hidden;
    }
    #inner {
      position: absolute;
      left: 120px;
      top: 0px;
      width: 50px;
      height: 50px;
    }
  </layout>
</xt>
