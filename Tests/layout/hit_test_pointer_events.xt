<xt version="2">

  <body>
    <div id="parent"><div id="child"></div></div>
  </body>

  <layout>
    #parent {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100px;
      height: 100px;
    }
    #child {
      position: absolute;
      left: 20px;
      top: 20px;
      width: 40px;
      height: 40px;
    }
  </layout>
  <style>
    #parent {
      pointer-events: none;
    }
    #child {
      pointer-events: auto;
    }
  </style>
</xt>
