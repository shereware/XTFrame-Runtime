<xt version="2">

  <body>
    <div id="inset"></div>
    <div id="circle"></div>
    <div id="ellipse"></div>
    <div id="polygon"><div id="child"></div></div>
    <div id="rect"><div id="rectchild"></div></div>
  </body>

  <layout>
    /* T-332 (05 §5.9.8, 08 §8.2): point-in-shape before entering an element. Four 100x100
         shapes in a row, the last one with a child that the shape cuts away. */
    div {
      position: absolute;
      width: 100px;
      height: 100px;
    }
    #inset {
      left: 0px;
      top: 0px;
    }
    #circle {
      left: 100px;
      top: 0px;
    }
    #ellipse {
      left: 200px;
      top: 0px;
    }
    #polygon {
      left: 300px;
      top: 0px;
    }
    #child {
      left: 0px;
      top: 0px;
      width: 100px;
      height: 20px;
    }
    #rect {
      left: 0px;
      top: 150px;
      width: 400px;
      height: 100px;
      overflow: hidden;
    }
    #rectchild {
      left: 50px;
      top: 10px;
      width: 100px;
      height: 30px;
    }
  </layout>
  <style>
    #inset {
      clip-path: inset(10px 20px round 30px);
    }
    #circle {
      clip-path: circle(40px at 50% 50%);
    }
    #ellipse {
      clip-path: ellipse(50px 20px);
    }
    #polygon {
      clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
    }
    #rect {
      clip-path: inset(0px 300px 0px 0px);
    }
  </style>
</xt>
