<xt>
  <head>
    <style>
      #stage { position: absolute; left: 0px; top: 0px; width: 300px; height: 300px; perspective: 400px; }
      #wrap { position: absolute; left: 0px; top: 0px; width: 300px; height: 300px; }
      #cardA { position: absolute; left: 20px; top: 20px; width: 80px; height: 80px; transform: rotateY(180deg); background-color: #ff0000; }
      #btn { position: absolute; left: 10px; top: 10px; width: 30px; height: 20px; background-color: #ffffff; }
      #cardB { position: absolute; left: 100px; top: 20px; width: 80px; height: 80px; transform: rotateY(180deg); background-color: #00ff00; }
      #plainDiv { position: absolute; left: 60px; top: 60px; width: 100px; height: 100px; background-color: #0000ff; }
    </style>
  </head>
  <body>
    <div id="stage">
      <div id="wrap">
        <div id="cardA"><div id="btn"></div></div>
        <div id="cardB"></div>
        <div id="plainDiv"></div>
      </div>
    </div>
  </body>
</xt>
