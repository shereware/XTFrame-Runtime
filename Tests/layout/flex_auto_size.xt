<xt version="2">

  <body>
    <div id="container">
      <div id="a"></div>
      <div id="b"></div>
      <div id="c"></div>
    </div>
  </body>

  <layout>
    #container {
      position: absolute;
      display: flex;
      height: 50px;
    }
    #a {
      width: 100px;
    }
    #b {
      width: 80px;
    }
    #c {
      width: 120px;
    }
  </layout>
</xt>
