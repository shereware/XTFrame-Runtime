<xt version="2">

  <body id="body">
    <div id="a"></div>
    <div id="b"></div>
  </body>

  <layout>
    body {
      height: 50px;
    }
    #a {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100px;
      height: 50px;
    }
    #b {
      position: absolute;
      left: 100px;
      top: 0px;
      width: 100px;
      height: 50px;
    }
  </layout>
</xt>
