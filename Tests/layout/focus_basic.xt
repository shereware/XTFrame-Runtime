<xt>
  <head>
    <style>
      body { height: 300px; }
      #btn { position: absolute; left: 0px; top: 0px; width: 80px; height: 30px; background-color: #000000; }
      #btn:focus { background-color: #ffffff; }
      #field { position: absolute; left: 0px; top: 40px; width: 200px; height: 30px; font-size: 10px; }
      #check { position: absolute; left: 0px; top: 80px; width: 20px; height: 20px; }
      #offBtn { position: absolute; left: 0px; top: 110px; width: 80px; height: 30px; }
      #hiddenField { position: absolute; left: 0px; top: 150px; width: 80px; height: 30px; display: none; }
      #plain { position: absolute; left: 200px; top: 200px; width: 60px; height: 40px; }
    </style>
  </head>
  <body id="body">
    <button id="btn">OK</button>
    <input id="field" type="text" />
    <input id="check" type="checkbox" />
    <button id="offBtn">No</button>
    <input id="hiddenField" type="text" />
    <div id="plain"></div>
  </body>
</xt>
