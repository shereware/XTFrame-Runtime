<xt version="2">

  <body>
    <div id="outer">
      <div id="middle">
        <div id="inner"></div>
      </div>
    </div>
  </body>

  <layout>
    #outer {
      position: relative;
      width: 300px;
      height: 200px;
      padding: 10px;
    }
    #middle {
      padding: 5px;
    }
    #inner {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 20px;
      height: 20px;
    }
  </layout>
</xt>
