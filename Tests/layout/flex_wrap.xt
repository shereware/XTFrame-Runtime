<xt>
  <head>
    <style>
      #container {
        display: flex;
        flex-wrap: wrap;
        align-content: space-between;
        width: 400px;
        height: 200px;
      }
      #container > div { width: 150px; height: 40px; }
    </style>
  </head>
  <body>
    <div id="container">
      <div id="a"></div>
      <div id="b"></div>
      <div id="c"></div>
      <div id="d"></div>
      <div id="e"></div>
    </div>
  </body>
</xt>
