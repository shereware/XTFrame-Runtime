<xt version="2">

  <body>
    <div id="l1"><div id="l2"><div id="l3"></div></div></div>
  </body>

  <layout>
    #l1 {
      padding: 10px;
    }
    #l2 {
      padding: 5px;
      transform-origin: 0 0;
    }
    #l3 {
      width: 10px;
      height: 10px;
      transform-origin: 0 0;
    }
  </layout>
  <style>
    #l1 {
      border-width: 2px;
    }
    #l2 {
      border-width: 1px;
    }
  </style>
</xt>
