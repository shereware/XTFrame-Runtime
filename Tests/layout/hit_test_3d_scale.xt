<xt>
  <head>
    <style>
      #stage { position: absolute; left: 0px; top: 0px; width: 300px; height: 300px; perspective: 200px; }
      #box { position: absolute; left: 100px; top: 100px; width: 50px; height: 50px; transform: translateZ(100px); background-color: #0000ff; }
    </style>
  </head>
  <body>
    <div id="stage"><div id="box"></div></div>
  </body>
</xt>
