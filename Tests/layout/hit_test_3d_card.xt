<xt>
  <head>
    <style>
      #stage { position: absolute; left: 0px; top: 0px; width: 300px; height: 300px; perspective: 400px; }
      #card { position: absolute; left: 100px; top: 100px; width: 100px; height: 100px; transform: rotateY(60deg); background-color: #ff0000; }
    </style>
  </head>
  <body>
    <div id="stage"><div id="card"></div></div>
  </body>
</xt>
