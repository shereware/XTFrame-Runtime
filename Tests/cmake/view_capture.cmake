# T-882 (Docs/design/59-visual-feedback.md §59.4, §59.8): xtframe-view's state stamp (`stamp:` on stdout,
# --stamp-json), --crop, --max-edge, --times / --sheet and JPEG output, on the software renderer
# (RENDERER empty) or on a GPU renderer (RENDERER=gl|wgpu, MODE gpu: the custom effect's `executed`).
#   cmake -DVIEW=<xtframe-view> -DDOC=<Tests/xt/view_capture.xt> -DOUT=<dir> -DMODE=<mode> [-DRENDERER=<r>]
#         -P view_capture.cmake
# MODE: stamp | sw_effect | crop | max_edge | frames | frame_count | sheet | limit | conflict | jpeg | gpu |
#       gpu_broken (T-892: DOC = Tests/xt/view_capture_broken.xt, a shader the device rejects)
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(doc "${DOC}" --width 160 --height 64 --headless)

# run(<var prefix> <arguments>...): one run; <prefix>_rc, <prefix>_out, <prefix>_err.
macro(run prefix)
    execute_process(COMMAND "${VIEW}" ${ARGN} RESULT_VARIABLE ${prefix}_rc OUTPUT_VARIABLE ${prefix}_out
                    ERROR_VARIABLE ${prefix}_err)
endmacro()

# ok(<prefix> <arguments>...): a run that must exit 0.
macro(ok prefix)
    run(${prefix} ${ARGN})
    if(NOT ${prefix}_rc EQUAL 0)
        message(FATAL_ERROR "xtframe-view ${ARGN}: exit ${${prefix}_rc}: ${${prefix}_out}${${prefix}_err}")
    endif()
endmacro()

# refused(<code> <regex> <arguments>...): a run that must exit <code> with <regex> in its output.
function(refused code regex)
    run(r ${ARGN})
    if(NOT r_rc EQUAL code OR NOT "${r_out}${r_err}" MATCHES "${regex}")
        message(FATAL_ERROR "xtframe-view ${ARGN}: expected exit ${code} and '${regex}', got exit ${r_rc}: "
                            "${r_out}${r_err}")
    endif()
endfunction()

# png_size(<file> <w var> <h var>): the IHDR size of a PNG.
function(png_size file wvar hvar)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "${file} was not written")
    endif()
    file(READ "${file}" hex OFFSET 16 LIMIT 8 HEX)
    string(SUBSTRING "${hex}" 0 8 w)
    string(SUBSTRING "${hex}" 8 8 h)
    math(EXPR w "0x${w}")
    math(EXPR h "0x${h}")
    set(${wvar} ${w} PARENT_SCOPE)
    set(${hvar} ${h} PARENT_SCOPE)
endfunction()

function(expect_size file ew eh)
    png_size("${file}" w h)
    if(NOT w EQUAL ew OR NOT h EQUAL eh)
        message(FATAL_ERROR "${file}: ${w}x${h}, expected ${ew}x${eh}")
    endif()
endfunction()

function(expect_same a b)
    file(SHA256 "${a}" ha)
    file(SHA256 "${b}" hb)
    if(NOT ha STREQUAL hb)
        message(FATAL_ERROR "${a} and ${b} differ")
    endif()
endfunction()

function(expect_different a b)
    file(SHA256 "${a}" ha)
    file(SHA256 "${b}" hb)
    if(ha STREQUAL hb)
        message(FATAL_ERROR "${a} and ${b} are the same picture")
    endif()
endfunction()

# stamp_of(<var> <stdout>): the JSON of the one `stamp: ` line of a run's stdout.
function(stamp_of var text)
    string(REGEX MATCHALL "(^|\n)stamp: [^\n]*" lines "${text}")
    list(LENGTH lines n)
    if(NOT n EQUAL 1)
        message(FATAL_ERROR "expected one 'stamp: ' line on stdout, found ${n}: ${text}")
    endif()
    string(REGEX REPLACE "^\n?stamp: " "" json "${lines}")
    string(JSON type ERROR_VARIABLE err TYPE "${json}")
    if(err OR NOT type STREQUAL "OBJECT")
        message(FATAL_ERROR "the stamp is not a JSON object (${err}): ${json}")
    endif()
    set(${var} "${json}" PARENT_SCOPE)
endfunction()

# expect_json(<json> <expected> <path>...): the member at <path> as text equals <expected>.
function(expect_json json expected)
    string(JSON value ERROR_VARIABLE err GET "${json}" ${ARGN})
    if(err OR NOT "${value}" STREQUAL "${expected}")
        message(FATAL_ERROR "stamp ${ARGN}: '${value}' (${err}), expected '${expected}': ${json}")
    endif()
endfunction()

function(expect_member json)
    string(JSON value ERROR_VARIABLE err GET "${json}" ${ARGN})
    if(err)
        message(FATAL_ERROR "stamp has no ${ARGN}: ${json}")
    endif()
endfunction()

# The custom effect's entry of a stamp: <var> = its JSON ("" when there is none).
function(custom_effect var json)
    set(${var} "" PARENT_SCOPE)
    string(JSON n LENGTH "${json}" effects)
    if(n EQUAL 0)
        return()
    endif()
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
        string(JSON kind GET "${json}" effects ${i} kind)
        if(kind STREQUAL "custom")
            string(JSON e GET "${json}" effects ${i})
            set(${var} "${e}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
endfunction()

if(MODE STREQUAL "stamp")
    ok(a ${doc} --frames 1 --play slide --screenshot "${OUT}/a.png" --stamp-json "${OUT}/a.json")
    stamp_of(s "${a_out}")
    expect_json("${s}" "sw" renderer)
    expect_json("${s}" "xt_sw" backend)
    expect_json("${s}" "scratch" source)
    expect_json("${s}" "160" device w)
    expect_json("${s}" "64" device h)
    expect_json("${s}" "1" device dpr)
    expect_member("${s}" device uiscale)
    expect_member("${s}" device safe)
    expect_member("${s}" lang)
    expect_json("${s}" "0" clock)
    expect_json("${s}" "ON" timelines slide playing)
    expect_member("${s}" timelines slide time)
    expect_member("${s}" effects)
    expect_member("${s}" notes 0)
    foreach(key ui space mode)
        string(JSON v ERROR_VARIABLE err GET "${s}" ${key})
        if(NOT err)
            message(FATAL_ERROR "the stamp has the editor's '${key}': ${s}")
        endif()
    endforeach()
    # The file: the same stamp, indented by two spaces.
    file(READ "${OUT}/a.json" f)
    if(NOT f MATCHES "^{\n  \"renderer\": \"sw\",\n")
        message(FATAL_ERROR "a.json is not the stamp indented by two spaces: ${f}")
    endif()
    string(JSON eq EQUAL "${s}" "${f}")
    if(NOT eq)
        message(FATAL_ERROR "a.json differs from the stdout stamp:\n${f}\n${s}")
    endif()
    # 60 frames (the default): the clock of the last one.
    ok(b ${doc} --screenshot "${OUT}/b.png")
    stamp_of(s "${b_out}")
    if(NOT s MATCHES "\"clock\": ?0\\.983333[,}]")  # 59/60, six decimals at most
        message(FATAL_ERROR "the clock of frame 59 is not 0.983333: ${s}")
    endif()
elseif(MODE STREQUAL "sw_effect")
    ok(a ${doc} --frames 1 --screenshot "${OUT}/a.png")
    stamp_of(s "${a_out}")
    custom_effect(e "${s}")
    if(e STREQUAL "")
        message(FATAL_ERROR "no custom effect in the stamp: ${s}")
    endif()
    expect_json("${e}" "#card" layer)
    expect_json("${e}" "0" index)
    expect_json("${e}" "OFF" executed)
    expect_json("${e}" "blur" fallback)
    expect_member("${e}" reason)
    if(NOT s MATCHES "custom effect was drawn with its fallback")
        message(FATAL_ERROR "the notes do not say the fallback was drawn: ${s}")
    endif()
elseif(MODE STREQUAL "crop")
    ok(a ${doc} --frames 1 --screenshot "${OUT}/full.png")
    ok(a ${doc} --frames 1 --screenshot "${OUT}/c1.png" --crop 10,8,40,20)
    expect_size("${OUT}/c1.png" 40 20)
    # Partly outside: cut to the picture.
    ok(a ${doc} --frames 1 --screenshot "${OUT}/c2.png" --crop 150,50,40,40)
    expect_size("${OUT}/c2.png" 10 14)
    # Wholly outside: an error.
    refused(1 "--crop" ${doc} --frames 1 --screenshot "${OUT}/c3.png" --crop 500,500,10,10)
    refused(2 "--crop" ${doc} --frames 1 --screenshot "${OUT}/c4.png" --crop 1,2,3)
    # An element: its box and its effects' reach (59.8 `--crop <#id>`).
    ok(a ${doc} --frames 1 --screenshot "${OUT}/c5.png" --crop "#card")
    png_size("${OUT}/c5.png" w h)
    if(w LESS 40 OR h LESS 32 OR w GREATER_EQUAL 160 OR h GREATER 64)
        message(FATAL_ERROR "--crop #card: ${w}x${h}")
    endif()
    refused(1 "no element 'nosuch'" ${doc} --frames 1 --screenshot "${OUT}/c6.png" --crop "#nosuch")
elseif(MODE STREQUAL "max_edge")
    ok(a ${doc} --frames 1 --screenshot "${OUT}/m1.png" --max-edge 80)
    expect_size("${OUT}/m1.png" 80 32)
    ok(a ${doc} --frames 1 --screenshot "${OUT}/m2.png" --max-edge 1000)
    expect_size("${OUT}/m2.png" 160 64)
    ok(a ${doc} --frames 1 --screenshot "${OUT}/m3.png" --max-edge 0)
    expect_size("${OUT}/m3.png" 160 64)
    # Cropped first, then shrunk.
    ok(a ${doc} --frames 1 --screenshot "${OUT}/m4.png" --crop 0,0,100,64 --max-edge 50)
    expect_size("${OUT}/m4.png" 50 32)
    refused(2 "--max-edge" ${doc} --frames 1 --screenshot "${OUT}/m5.png" --max-edge -3)
elseif(MODE STREQUAL "frames")
    ok(a ${doc} --screenshot "${OUT}/shot.png" --times 0.5,1,2)
    foreach(pair "01;0.5" "02;1" "03;2")
        list(GET pair 0 n)
        list(GET pair 1 t)
        ok(b ${doc} --advance ${t} --frames 1 --screenshot "${OUT}/single_${n}.png")
        expect_same("${OUT}/shot_${n}.png" "${OUT}/single_${n}.png")
        expect_size("${OUT}/shot_${n}.png" 160 64)
    endforeach()
    expect_different("${OUT}/shot_01.png" "${OUT}/shot_03.png")
    if(EXISTS "${OUT}/shot.png")
        message(FATAL_ERROR "--times without --sheet also wrote shot.png")
    endif()
    stamp_of(s "${a_out}")
    expect_json("${s}" "0.5" clock)
    string(JSON n LENGTH "${s}" frames)
    if(NOT n EQUAL 3)
        message(FATAL_ERROR "the stamp lists ${n} frames, expected 3: ${s}")
    endif()
    expect_json("${s}" "2" frames 2 clock)
    expect_json("${s}" "2.00s" frames 2 label)
    expect_member("${s}" frames 2 file)
    # With --clock: each time point is the clock it shows (--clock 10 --advance <t - 10>).
    ok(c ${doc} --clock 10 --screenshot "${OUT}/clk.png" --times 10.5,11)
    ok(d ${doc} --clock 10 --advance 0.5 --frames 1 --screenshot "${OUT}/clk_single.png")
    expect_same("${OUT}/clk_01.png" "${OUT}/clk_single.png")
    # One time point, written as an integer.
    ok(e ${doc} --screenshot "${OUT}/one.png" --times 2)
    expect_same("${OUT}/one_01.png" "${OUT}/single_03.png")
    stamp_of(s "${e_out}")
    string(JSON n LENGTH "${s}" frames)
    if(NOT n EQUAL 1)
        message(FATAL_ERROR "--times 2: the stamp lists ${n} frames, expected 1: ${s}")
    endif()
elseif(MODE STREQUAL "frame_count")
    # --frames is a frame count only (as before T-882): the value is read as an unsigned integer
    # (strtoul), so 1.5 and 1,2 are 1 frame -- one picture at the --screenshot path, no time points.
    ok(a ${doc} --frames 1 --screenshot "${OUT}/one.png")
    foreach(pair "dec;1.5" "list;1,2")
        list(GET pair 0 n)
        list(GET pair 1 v)
        ok(b ${doc} --frames ${v} --screenshot "${OUT}/${n}.png")
        expect_same("${OUT}/${n}.png" "${OUT}/one.png")
        if(EXISTS "${OUT}/${n}_01.png")
            message(FATAL_ERROR "--frames ${v} was taken as time points")
        endif()
        stamp_of(s "${b_out}")
        string(JSON f ERROR_VARIABLE err GET "${s}" frames)
        if(NOT err)
            message(FATAL_ERROR "--frames ${v}: the stamp lists time points: ${s}")
        endif()
    endforeach()
    # A plain count is unchanged: one picture at the --screenshot path.
    ok(c ${doc} --frames 3 --screenshot "${OUT}/three.png")
    expect_size("${OUT}/three.png" 160 64)
    if(EXISTS "${OUT}/three_01.png")
        message(FATAL_ERROR "--frames 3 wrote time point files")
    endif()
elseif(MODE STREQUAL "sheet")
    ok(a ${doc} --screenshot "${OUT}/sheet.png" --times 0.5,1,1.5,2,2.5 --sheet)
    # 5 cells of 160x64: 3 columns, 2 rows, 4 px between.
    expect_size("${OUT}/sheet.png" 488 132)
    if(EXISTS "${OUT}/sheet_01.png")
        message(FATAL_ERROR "--sheet also wrote the single frames")
    endif()
    stamp_of(s "${a_out}")
    expect_json("${s}" "0.50s" frames 0 label)
    string(JSON f ERROR_VARIABLE err GET "${s}" frames 0 file)
    if(NOT err)
        message(FATAL_ERROR "a --sheet frame names a file: ${s}")
    endif()
    # --max-edge shrinks the cells so the sheet fits.
    ok(b ${doc} --screenshot "${OUT}/sheet_small.png" --times 0.5,1,1.5,2,2.5 --sheet --max-edge 244)
    png_size("${OUT}/sheet_small.png" w h)
    if(w GREATER 244 OR h GREATER 244 OR w LESS 200)
        message(FATAL_ERROR "--sheet --max-edge 244: ${w}x${h}")
    endif()
elseif(MODE STREQUAL "limit")
    set(times "0.1")
    foreach(i RANGE 2 25)
        string(APPEND times ",${i}.1")
    endforeach()
    refused(2 "--times: at most 24 time points" ${doc} --screenshot "${OUT}/x.png" --times "${times}")
    refused(2 "--times: the times must increase" ${doc} --screenshot "${OUT}/x.png" --times 1,0.5)
    refused(2 "--times: expected document clock seconds" ${doc} --screenshot "${OUT}/x.png" --times 0.5,-1)
elseif(MODE STREQUAL "conflict")
    set(f --screenshot "${OUT}/x.png" --times 0.5,1)
    refused(2 "--times cannot be combined with --advance" ${doc} ${f} --advance 1)
    refused(2 "--times cannot be combined with --perf" ${doc} ${f} --perf)
    refused(2 "--times cannot be combined with --print-text" ${doc} ${f} --print-text card)
    # T-887: --frames N with --times was ignored silently.
    refused(2 "--times cannot be combined with --frames" ${doc} ${f} --frames 3)
    refused(2 "--times needs --headless" "${DOC}" --width 160 --height 64 ${f})
    refused(2 "--sheet needs --times" ${doc} --frames 1 --screenshot "${OUT}/x.png" --sheet)
    refused(2 "--times needs --screenshot" ${doc} --times 0.5,1)
    refused(2 "--stamp-json needs --screenshot" ${doc} --frames 1 --stamp-json "${OUT}/x.json")
    # --frames is the frame count, never time points: no conflict, whatever its value.
    ok(a ${doc} --frames 2 --advance 1 --screenshot "${OUT}/y.png")
    ok(a ${doc} --frames 1.5 --advance 1 --screenshot "${OUT}/y.png")
    refused(2 "--sheet needs --times" ${doc} --frames 0.5,1 --screenshot "${OUT}/x.png" --sheet)
elseif(MODE STREQUAL "jpeg")
    ok(a ${doc} --frames 1 --screenshot "${OUT}/a.jpg")
    file(READ "${OUT}/a.jpg" magic LIMIT 3 HEX)
    if(NOT magic STREQUAL "ffd8ff")
        message(FATAL_ERROR "a.jpg is not a JPEG (starts ${magic})")
    endif()
    ok(b ${doc} --frames 1 --screenshot "${OUT}/b.jpg" --jpeg-quality 30)
    file(SIZE "${OUT}/a.jpg" sa)
    file(SIZE "${OUT}/b.jpg" sb)
    if(NOT sb LESS sa)
        message(FATAL_ERROR "--jpeg-quality 30 (${sb} bytes) is not smaller than 80 (${sa} bytes)")
    endif()
    # Decodable: it is read back as a --scene image (stb_image).
    ok(c ${doc} --frames 1 --scene "${OUT}/a.jpg" --screenshot "${OUT}/decoded.png")
    expect_size("${OUT}/decoded.png" 160 64)
    refused(2 "--jpeg-quality" ${doc} --frames 1 --screenshot "${OUT}/c.jpg" --jpeg-quality 0)
elseif(MODE STREQUAL "gpu")
    ok(a ${doc} --frames 2 --renderer ${RENDERER} --screenshot "${OUT}/a.png")
    stamp_of(s "${a_out}")
    string(JSON renderer GET "${s}" renderer)
    custom_effect(e "${s}")
    if(e STREQUAL "")
        message(FATAL_ERROR "no custom effect in the stamp: ${s}")
    endif()
    if(renderer STREQUAL "sw")
        # The GPU renderer is unavailable here (the run fell back to sw, which the stamp says).
        expect_json("${e}" "OFF" executed)
        message("view capture ${MODE} ${RENDERER}: renderer unavailable, ran on sw")
    else()
        if(NOT renderer STREQUAL RENDERER)
            message(FATAL_ERROR "stamp renderer '${renderer}', expected '${RENDERER}': ${s}")
        endif()
        expect_json("${e}" "ON" executed)
        expect_json("${e}" "#card" layer)
    endif()
elseif(MODE STREQUAL "gpu_broken")
    # T-892 (59 §59.4): the device could not compile the shader; the reason carries the first line of
    # its compile message, every frame (the failure is cached with it).
    ok(a ${doc} --frames 2 --renderer ${RENDERER} --screenshot "${OUT}/a.png")
    stamp_of(s "${a_out}")
    string(JSON renderer GET "${s}" renderer)
    custom_effect(e "${s}")
    if(e STREQUAL "")
        message(FATAL_ERROR "no custom effect in the stamp: ${s}")
    endif()
    expect_json("${e}" "OFF" executed)
    if(renderer STREQUAL "sw")
        message("view capture ${MODE} ${RENDERER}: renderer unavailable, ran on sw")
    else()
        expect_json("${e}" "blur" fallback)
        string(JSON reason GET "${e}" reason)
        if(NOT reason MATCHES "^shader failed to compile on ${RENDERER}: .+")
            message(FATAL_ERROR "reason '${reason}' does not carry the compile message: ${s}")
        endif()
        message("view capture ${MODE} ${RENDERER}: ${reason}")
    endif()
else()
    message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
message("view capture ${MODE}: PASS")
