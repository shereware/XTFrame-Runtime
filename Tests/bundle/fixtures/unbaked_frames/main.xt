<xt>
  <head><style>
    #Icon { position: absolute; left: 0px; top: 0px; }
    @timeline grow { duration: 200s; #Icon/Off { 0s { amount: 0 } 200s { amount: 10 } } }
  </style></head>
  <body>
    <svg id="Icon" viewBox="0 0 100 100" width="100" height="100">
      <path id="A" d="M10 10 L50 10 L50 50 L10 50 Z" fill="#ff0000"/>
      <xt-offset id="Off" amount="0"/>
    </svg>
  </body>
</xt>
