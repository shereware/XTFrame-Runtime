@timeline intro {
  #Left {
    0s {
      opacity: 0;
      transform: translateX(-24px);
    }
    0.3s ease-out {
      opacity: 1;
      transform: translateX(0px);
    }
  }
  #Hints {
    0s {
      opacity: 0;
    }
    0.2s {
      opacity: 0;
    }
    0.4s linear {
      opacity: 1;
    }
  }
}
