/* Main menu layout: conventions/layouts/main-menu.xt's anchors. Colors come from tokens only. */
body {
  background-color: var(--color-bg);
  background-image: var(--tex-grain);
  background-repeat: repeat;
  background-size: 128px 128px;
  font-family: var(--font-family);
}
#Title {
  color: var(--color-text);
  font-size: 44px;
  font-weight: 700;
  letter-spacing: 2px;
}
#Subtitle {
  color: var(--color-text-dim);
  font-size: var(--font-size-m);
}
#Version {
  color: var(--color-text-dim);
  font-size: var(--font-size-xs);
}
/* The quit confirmation starts hidden; the host removes `closed` to open it. */
.closed {
  visibility: hidden;
}
