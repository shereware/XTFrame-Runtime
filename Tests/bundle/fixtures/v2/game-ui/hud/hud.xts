#ammoPanel {
  transition: effect 250ms;
}
.bar {
  background-color: #21262d;
  border-radius: 6px;
}
.fill {
  background-color: #3fb950;
  border-radius: 6px;
  transition: width 300ms, background-color 300ms;
}
#player.danger .fill {
  background-color: #f85149;
}
.value {
  font-size: 18px;
}
.big {
  font-size: 56px;
  line-height: 60px;
  transition: color 200ms;
}
#ammoPanel.empty .big {
  color: #f85149;
}
#ammoPanel.empty {
  effect: shadow(0 10px 28px 0 #000000 0.55) glow(18px #f85149 1.2);
}
.skill {
  background-color: #161b22;
  border: 1px #30363d;
  border-radius: 14px;
  color: #8b949e;
  font-size: 24px;
  line-height: 64px;
  text-align: center;
  transition: background-color 120ms;
}
.skill:hover {
  background-color: #21262d;
}
.ready {
  animation: sweep 2.4s linear infinite;
  border: 1px #58a6ff;
  color: #e6edf3;
  effect: glow(14px #58a6ff 1.1) shine(30deg 36px #ffffff 0.9 0.6 0);
}
#card {
  background-color: #161b22e6;
  border: 1px #30363d;
  border-radius: 12px;
  effect: shadow(0 10px 28px 0 #000000 0.55);
  text-align: center;
  transition: transform 800ms ease-in-out;
}
@keyframes sweep {
  0% {
    effect: glow(14px #58a6ff 1.1) shine(30deg 36px #ffffff 0.9 0.6 0);
  }
  60% {
    effect: glow(14px #58a6ff 1.1) shine(30deg 36px #ffffff 0.9 0.6 1);
  }
  100% {
    effect: glow(14px #58a6ff 1.1) shine(30deg 36px #ffffff 0.9 0.6 1);
  }
}
/* T-152: Lottie content. #radar plays shared/anim/radar.json in a loop; #alert plays
   shared/anim/alert.json only while HP is low (driven by hud.xtflow). */
#radar {
  opacity: 0.8;
}
#alert {
  transition: opacity 200ms;
}
#alert.hidden {
  opacity: 0;
}
#player.flash {
  border: 1px #f85149;
}
