<xt version="2">

  <symbol name="ButtonPrompt" requires="slots: text">
    <div id="Box" on:show="play(intro)">
      <span id="Text"><slot name="text">Press <glyph key="interact"/> to interact</slot></span>
    </div>
  </symbol>

  <layout>
    symbol(ButtonPrompt) {
      #Box {
        display: flex;
        align-items: center;
        padding: var(--space-2) var(--space-3);
      }
    }
  </layout>
  <style>
    symbol(ButtonPrompt) {
      #Box {
        border-width: var(--rule-thin);
        border-style: dashed;
        border-color: var(--color-border);
        background-color: var(--color-surface);
        background-image: var(--tex-grain);
        background-repeat: repeat;
        background-size: 128px 128px;
        font-family: var(--font-body);
      }
      #Text {
        color: var(--color-text);
        font-size: var(--font-size-m);
        white-space: nowrap;
      }
    }
  </style>
  <timelines>
    symbol(ButtonPrompt) {
      @timeline intro {
        #Box {
          0s {
            opacity: 0;
            transform: translateY(8px);
          }
          0.25s ease-out {
            opacity: 1;
            transform: translateY(0px);
          }
        }
      }
    }
  </timelines>
</xt>
