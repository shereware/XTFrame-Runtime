<xt version="2">

  <symbol name="Slider" requires="states: Hover, Pressed, Focus, Disabled; slots: label">
    <ports>
      value: number in
      min: number in
      max: number in
      decrease: event out
      increase: event out
    </ports>
    <div id="Box">
      <div id="Head">
        <span id="Label"><slot name="label">Value</slot></span>
        <span id="Readout" bind:text="value | round"></span>
      </div>
      <div id="Track" draggable="axis-x"
           on:drag.value="set(value, event.value | range(0, 1, min, max) | round)"
           on:nav.value="sound(ui_tick); if lt(0) emit(decrease) else emit(increase)">
        <div id="Fill" bind:width="value | range(min, max, 0%, 100%)"></div>
        <div id="Handle" bind:left="value | range(min, max, 0%, 100%)"></div>
      </div>
    </div>
  </symbol>

  <layout>
    symbol(Slider) {
      #Box {
        display: flex;
        flex-direction: column;
        row-gap: var(--space-2);
        width: 240px;
        padding: var(--space-2) var(--space-3);
      }
      #Head {
        display: flex;
        justify-content: space-between;
      }
      #Track {
        position: relative;
        height: 8px;
      }
      #Fill {
        position: absolute;
        left: 0px;
        top: 0px;
        width: 50%;
        height: 6px;
      }
      #Handle {
        position: absolute;
        left: 50%;
        top: -6px;
        width: 18px;
        height: 18px;
        margin-left: -9px;
      }
    }
  </layout>
  <style>
    symbol(Slider) {
      #Box {
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: var(--font-size-s);
      }
      #Label {
        white-space: nowrap;
      }
      #Readout {
        color: var(--color-text-dim);
        white-space: nowrap;
      }
      #Track {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        background-color: var(--color-track);
        background-image: var(--tex-hatch);
        background-repeat: repeat;
        background-size: 8px 8px;
      }
      #Fill {
        background-color: var(--color-accent);
      }
      #Handle {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        background-color: var(--color-accent);
        transition: background-color var(--motion-fast) linear;
      }
      #Box:hover #Handle {
        background-color: var(--color-surface);
      }
      #Box:active #Handle {
        background-color: var(--color-surface-sunken);
      }
      #Box:focus-within {
        outline: var(--focus-w) solid var(--color-focus);
        outline-offset: 2px;
      }
      #Track:focus #Handle {
        background-color: var(--color-surface);
      }
      :disabled #Box {
        outline: none !important;
      }
      :disabled #Track {
        border-color: var(--color-disabled-text) !important;
        background-color: var(--color-disabled-bg) !important;
        background-image: var(--tex-hatch) !important;
      }
      :disabled #Fill {
        background-color: var(--color-disabled-text) !important;
      }
      :disabled #Handle {
        background-color: var(--color-disabled-bg) !important;
        border-color: var(--color-disabled-text) !important;
      }
      :disabled #Label {
        color: var(--color-disabled-text);
      }
    }
  </style>
</xt>
