<xt version="2">

  <symbol name="Counter" requires="slots: label, icon">
    <ports>
      value: number in
      gain: event in
    </ports>
    <div id="Box" on:port(gain)="play(hit)">
      <div id="Icon"><slot name="icon"><div id="IconDot"></div></slot></div>
      <div id="Copy">
        <span id="Label"><slot name="label">Gold</slot></span>
        <span id="Value" bind:text="value | tween(0.4s, ease-out) | round | thousands"></span>
      </div>
    </div>
  </symbol>

  <layout>
    symbol(Counter) {
      #Box {
        display: flex;
        align-items: center;
        column-gap: var(--space-2);
      }
      #Icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
      }
      #IconDot {
        width: 18px;
        height: 18px;
      }
      #Copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 2px;
      }
      #Value {
        margin: 3px;
        padding: 0px var(--space-2);
      }
    }
  </layout>
  <style>
    symbol(Counter) {
      #Box {
        font-family: var(--font-body);
        color: var(--color-text);
      }
      #IconDot {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        background-color: var(--color-warning);
      }
      #Label {
        color: var(--color-text-dim);
        font-family: var(--font-display);
        font-size: var(--font-size-xs);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: var(--letter-display);
      }
      /* The number box: an ink block inside a double frame (its own 1px border and a 1px outline 2px out). */
      #Value {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        outline: var(--rule-thin) solid var(--color-border);
        outline-offset: 2px;
        background-color: var(--color-accent);
        color: var(--color-text-on-accent);
        font-family: var(--font-display);
        font-size: var(--font-size-l);
        font-weight: 900;
        letter-spacing: var(--letter-display);
        white-space: nowrap;
      }
    }
  </style>
  <timelines>
    symbol(Counter) {
      @timeline hit {
        #Box {
          0s {
            opacity: 1;
          }
          0.1s linear {
            opacity: 0.4;
          }
          0.2s linear {
            opacity: 1;
          }
        }
      }
    }
  </timelines>
</xt>
