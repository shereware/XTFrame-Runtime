<xt version="2">
  <head>
    <symbols src="../mobile/TouchButton.xt"/>
  </head>

  <body>
    <use symbol="TouchButton" id="Fire" slot:label="Fire"/>
    <use symbol="TouchButton" id="Jump" slot:label="Jump"/>
    <use symbol="TouchButton" id="Off" disabled="true" slot:label="Skill"/>
  </body>

  <layout>
    body {
      width: 340px;
      height: 130px;
      padding: 16px;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      column-gap: 16px;
      row-gap: 12px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-bg);
    }
  </style>
</xt>
