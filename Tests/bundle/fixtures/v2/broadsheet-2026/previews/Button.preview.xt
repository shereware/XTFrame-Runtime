<xt version="2">
  <head>
    <symbols src="../Button.xt"/>
  </head>

  <body>
    <use symbol="Button" id="Primary" slot:label="Play"/>
    <use symbol="Button" id="Secondary" variant:Kind="Secondary" slot:label="Options"/>
    <use symbol="Button" id="Ghost" variant:Kind="Ghost" variant:Size="S" slot:label="Credits"/>
    <use symbol="Button" id="Off" variant:Size="S" disabled="true" slot:label="Locked"/>
  </body>

  <layout>
    body {
      width: 320px;
      height: 200px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      row-gap: 12px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-bg);
    }
  </style>
</xt>
