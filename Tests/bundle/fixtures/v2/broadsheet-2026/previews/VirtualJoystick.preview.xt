<xt version="2">
  <head>
    <symbols src="../mobile/VirtualJoystick.xt"/>
  </head>

  <body>
    <use symbol="VirtualJoystick" id="Stick"/>
    <use symbol="VirtualJoystick" id="Float" variant:Mode="Floating"/>
  </body>

  <layout>
    body {
      width: 420px;
      height: 210px;
      padding: 16px;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      column-gap: 16px;
      row-gap: 12px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-bg);
    }
  </style>
</xt>
