<xt version="2">
  <head>
    <symbols src="../InputGlyph.xt"/>
  </head>

  <body>
    <div id="Row">
      <use symbol="InputGlyph" id="Jump" slot:label="Jump"/>
      <use symbol="InputGlyph" id="Use" slot:label="Use"><slot name="glyph"><glyph key="interact"/></slot></use>
    </div>
  </body>

  <layout>
    body {
      width: 240px;
      height: 80px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      row-gap: 12px;
    }
    #Row {
      display: flex;
      column-gap: 16px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-bg);
    }
  </style>
</xt>
