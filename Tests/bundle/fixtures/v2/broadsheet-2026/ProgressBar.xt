<xt version="2">

  <symbol name="ProgressBar" state-groups="Progress: Running|Complete" requires="states: Running, Complete; slots: label">
    <ports>
      value: number in
      value_max: number in
    </ports>
    <div id="Box"
         bind:state.Running="value | lt(100%)" bind:state.Complete="value | ge(100%)">
      <div id="Head">
        <span id="Label"><slot name="label">Loading</slot></span>
        <span id="Percent" bind:text="value | range(0, value_max, 0, 100) | round | format('{0}%')"></span>
      </div>
      <div id="Track">
        <div id="Fill" bind:width="value | clamp(0, value_max) | range(0, value_max, 0%, 100%) | tween(0.25s, ease-out)"></div>
      </div>
    </div>
  </symbol>

  <layout>
    symbol(ProgressBar) {
      #Box {
        display: flex;
        flex-direction: column;
        row-gap: var(--space-1);
        width: 320px;
      }
      #Head {
        display: flex;
        justify-content: space-between;
      }
      #Track {
        height: 10px;
        overflow: hidden;
      }
      #Fill {
        width: 0%;
        height: 8px;
      }
      #Box:state(Complete) #Percent {
        padding: 0px var(--space-1);
      }
    }
  </layout>
  <style>
    symbol(ProgressBar) {
      #Box {
        font-family: var(--font-body);
        font-size: var(--font-size-s);
        color: var(--color-text);
      }
      #Label,
      #Percent {
        font-family: var(--font-display);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: var(--letter-display);
        white-space: nowrap;
      }
      #Percent {
        color: var(--color-text-dim);
      }
      #Track {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        background-color: var(--color-track);
        background-image: var(--tex-hatch);
        background-repeat: repeat;
        background-size: 8px 8px;
      }
      #Fill {
        background-color: var(--color-accent);
        transition: background-color var(--motion-normal) linear;
      }
      #Box:state(Running) #Fill {
        background-color: var(--color-accent);
      }
      #Box:state(Complete) #Fill {
        background-color: var(--color-accent);
      }
      #Box:state(Complete) #Track {
        background-color: var(--color-accent);
        background-image: none;
      }
      #Box:state(Complete) #Percent {
        background-color: var(--color-accent);
        color: var(--color-text-on-accent);
      }
    }
  </style>
</xt>
