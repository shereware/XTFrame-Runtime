<xt version="2">

  <body>
    <div id="stretch"></div>
    <div id="fill"></div>
    <div id="round"></div>
    <div id="pct"></div>
  </body>

  <layout>
    div {
      position: absolute;
    }
    #stretch {
      left: 8px;
      top: 8px;
      width: 112px;
      height: 64px;
    }
    #fill {
      left: 136px;
      top: 8px;
      width: 112px;
      height: 64px;
    }
    #round {
      left: 8px;
      top: 88px;
      width: 112px;
      height: 64px;
    }
    #pct {
      left: 136px;
      top: 88px;
      width: 112px;
      height: 64px;
    }
  </layout>
  <style>
    #stretch {
      border-image: url(nine.png) 8 8 8 8;
    }
    #fill {
      border-image: url(nine.png) 8 fill repeat;
    }
    #round {
      border-width: 16px;
      border-image: url(nine.png) 8 round;
    }
    #pct {
      border-image: url(nine.png) 33.33% fill;
    }
  </style>
</xt>
