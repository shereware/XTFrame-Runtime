<xt version="2">

  <body>
    <div id="a"></div>
    <div id="b"></div>
    <div id="c"></div>
    <div id="d"></div>
    <div id="e"></div>
  </body>

  <layout>
    div {
      position: absolute;
      top: 100px;
      width: 40px;
      height: 40px;
    }
    #a {
      left: 8px;
    }
    #b {
      left: 56px;
    }
    #c {
      left: 104px;
    }
    #d {
      left: 152px;
    }
    #e {
      left: 200px;
    }
  </layout>
  <style>
    body {
      background-color: #202020;
    }
    div {
      background-color: #ff0000;
    }
    #a {
      opacity: 0;
    }
    #b {
      opacity: 0.0;
    }
    #c {
      opacity: 0.01;
    }
    #d {
      opacity: 0.5;
    }
    #e {
      opacity: 1;
    }
  </style>
</xt>
