<xt>
  <head>
    <style>
      /* T-160 (bench BUG-6, `#boot-scan`): a 3 px gradient-only line with a shadow glow, moved
         only by a `transform: translateY` animation inside a perspective root. At t = 0.5 s the
         line must have left its first-frame position (above the canvas) and carry its glow. */
      body { width: 256px; height: 256px; background-color: #030504; }
      #root { position: absolute; left: 0px; top: 0px; width: 256px; height: 256px;
              perspective: 1000px; perspective-origin: 50% 50%; overflow: hidden; }
      #scan { position: absolute; left: 0px; top: 0px; width: 256px; height: 3px;
              background-gradient: linear-gradient(90deg, #9fffc000 0%, #c8ffdcee 50%, #9fffc000 100%);
              effect: shadow(0px 0px 24px 4px #6fff9f88);
              animation: sweep 1s linear 0s 1 normal both; }
      @keyframes sweep {
        from { transform: translateY(-20px); opacity: 1; }
        to { transform: translateY(236px); opacity: 0.5; }
      }
    </style>
  </head>
  <body>
    <div id="root">
      <div id="scan"></div>
    </div>
  </body>
</xt>
