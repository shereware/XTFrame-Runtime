<xt version="2">

  <body>
    <div id="box"></div>
  </body>

  <layout>
    #box {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 80px;
      height: 40px;
    }
    #box:hover {
      width: 200px;
    }
  </layout>
  <style>
    #box {
      background-color: #ff0000;
      transition: width 0.4s linear;
    }
  </style>
</xt>
