<xt version="2">

  <body>
    <div id="under" class="row">Underline text</div>
    <div id="over" class="row">Overline text</div>
    <div id="through" class="row">Strike through</div>
    <div id="runs" class="row">Plain <s>struck</s> <u>under</u></div>
  </body>

  <layout>
    body {
      width: 256px;
      height: 256px;
    }
    .row {
      position: absolute;
      left: 16px;
    }
    #under {
      top: 24px;
    }
    #over {
      top: 84px;
    }
    #through {
      top: 144px;
    }
    #runs {
      top: 200px;
    }
  </layout>
  <style>
    @font-face {
      font-family: "Noto Sans";
      src: "../../fonts/NotoSans-Regular.subset.ttf";
    }
    body {
      background-color: #ffffff;
      font-family: "Noto Sans";
    }
    /* T-324 (05 §5.9.8): one line kind per row, the font's own underline metrics, `auto` and
         explicit thicknesses, a decoration color, and a run override (<s>) in the last row. */
    .row {
      font-size: 24px;
      color: #202020;
    }
    #under {
      text-decoration: underline;
    }
    #over {
      text-decoration: overline #d02020 3px;
    }
    #through {
      text-decoration-line: line-through;
      text-decoration-color: #2060d0;
    }
    #runs {
      color: #206020;
    }
  </style>
</xt>
