<xt>
  <head>
    <style>
      @font-face { font-family: "Noto Sans"; src: "../../fonts/NotoSans-Regular.subset.ttf"; }
      @font-face { font-family: "Noto Sans SC"; src: "../../fonts/NotoSansSC-Regular.subset.ttf"; }
      @font-fallback zh-TW { font-family: "Noto Sans SC"; }
      #title {
        margin: 16px;
        width: 224px;
        font-family: "Noto Sans";
        font-size: 28px;
        color: #202020;
      }
      #title:lang(zh) { color: #a01e1e; }
      #hint {
        margin: 0 16px;
        width: 224px;
        font-family: "Noto Sans";
        font-size: 20px;
        color: #1e5aa0;
      }
    </style>
  </head>
  <body>
    <div id="title">@title</div>
    <div id="hint">@hint</div>
  </body>
</xt>
