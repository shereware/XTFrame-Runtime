<xt version="2">

  <symbol name="Button" origin="center" variants="Kind=Primary|Secondary" requires="states: Hover; slots: label">
    <div id="Bg" class="btn-bg"></div>
    <span id="Label"><slot name="label">Button</slot></span>
  </symbol>

  <body>
    <use symbol="Button" id="Play" class="btn"/>
    <use symbol="Button" id="Options" class="btn" prop:Bg.background-color="#33aa88"/>
    <use symbol="Button" id="Quit" class="btn" variant:Kind="Primary" slot:label="Quit"/>
  </body>

  <layout>
    .btn {
      margin: 16px;
      width: 160px;
      height: 48px;
    }
    symbol(Button) {
      #Bg {
        width: 160px;
        height: 48px;
      }
    }
  </layout>
  <style>
    symbol(Button) {
      #Bg {
        background-color: #444444;
        border-radius: 8px;
      }
      :hover div#Bg {
        background-color: #666666;
      }
      #Label {
        visibility: hidden;
      }
      .v-Kind-Primary div#Bg {
        background-color: #2255dd;
      }
    }
  </style>
</xt>
