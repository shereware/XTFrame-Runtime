<xt version="2">

  <body>
    <div id="Trim" class="c_Trim">
      <svg id="TrimLayer" class="xl c_Trim" viewBox="0 0 256 256" width="256" height="256">
            <g transform="matrix(1 0 0 1 128 128)">
              <path id="n2" d="M 0 -80 C 44.1828 -80 80 -44.1828 80 0 C 80 44.1828 44.1828 80 0 80 C -44.1828 80 -80 44.1828 -80 0 C -80 -44.1828 -44.1828 -80 0 -80 Z" fill="none" stroke="#ffffff" stroke-width="10" stroke-linecap="round" stroke-linejoin="miter" stroke-miterlimit="0" path-trim="0 0.1 0"/>
            </g>
          </svg>
    </div>
  </body>

  <layout>
    .xl {
      position: absolute;
      left: 0px;
      top: 0px;
      transform-origin: 0px 0px;
    }
    .c_Trim {
      width: 256px;
      height: 256px;
    }
    #Trim {
      position: relative;
    }
    #TrimLayer {
      transform: translate(0px, 0px) rotate(0deg) skew(0deg, 0deg) scale(1, 1);
      transform-origin: 0px 0px;
    }
  </layout>
  <style src="trim.xts"/>
  <timelines>
    @timeline main from "trim.xtanim.json#main";
