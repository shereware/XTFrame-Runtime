<xt version="2">

  <body>
    <div id="latin">abc</div>
    <div id="arabic">مرحبا</div>
  </body>

  <layout>
    div {
      margin: 8px;
      width: 220px;
    }
  </layout>
  <style>
    @font-face {
      font-family: "Noto Sans";
      src: "../../fonts/NotoSans-Regular.subset.ttf";
    }
    @font-face {
      font-family: "Noto Naskh Arabic";
      src: "../../fonts/NotoNaskhArabic-Regular.subset.ttf";
    }
    div {
      letter-spacing: 4px;
      font-size: 20px;
      color: #202020;
    }
    #latin {
      font-family: "Noto Sans";
    }
    #arabic {
      font-family: "Noto Naskh Arabic";
    }
  </style>
</xt>
