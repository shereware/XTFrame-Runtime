<xt version="2">

  <body>
    <div id="outer">
      <div id="mid">
        <div id="inner"></div>
      </div>
    </div>
  </body>

  <layout>
    #outer {
      width: 200px;
      height: 200px;
      margin: 28px;
    }
    #mid {
      width: 80%;
      height: 80%;
      margin: 5%;
      max-width: 140px;
    }
    #inner {
      width: 50%;
      height: 50%;
      margin: 5%;
    }
  </layout>
  <style>
    #outer {
      background-color: #eeeeee;
    }
    #mid {
      background-color: #ffaa00;
    }
    #inner {
      background-color: #0000ff;
    }
  </style>
</xt>
