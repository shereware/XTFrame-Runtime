<xt version="2">

  <body>
    <div id="outer">
      <div id="inner"></div>
    </div>
  </body>

  <layout>
    #outer {
      position: relative;
      width: 160px;
      height: 160px;
      margin: 48px;
    }
    #inner {
      position: absolute;
      right: 10px;
      bottom: 10px;
      width: 50px;
      height: 50px;
    }
  </layout>
  <style>
    #outer {
      background-color: #dddddd;
    }
    #inner {
      background-color: #cc00cc;
    }
  </style>
</xt>
