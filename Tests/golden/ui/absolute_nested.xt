<xt>
  <head>
    <style>
      #outer { position: relative; width: 160px; height: 160px; margin: 48px; background-color: #dddddd; }
      #inner { position: absolute; right: 10px; bottom: 10px; width: 50px; height: 50px; background-color: #cc00cc; }
    </style>
  </head>
  <body>
    <div id="outer">
      <div id="inner"></div>
    </div>
  </body>
</xt>
