<xt version="2">

  <body>
    <div id="bg"></div>
    <div id="hp"><div id="hpfill"></div></div>
    <div id="map"></div>
    <div id="cross"></div>
    <div id="side"></div>
  </body>

  <layout>
    #bg {
      position: absolute;
      left: 0;
      top: 0;
      width: 100vw;
      height: 100vh;
    }
    #hp {
      anchor: left bottom;
      offset: 0 0;
      size: calc(30vh + 20px) 12px;
    }
    #hpfill {
      width: 70%;
      height: 100%;
    }
    #map {
      anchor: right top;
      offset: 0 0;
      size: 25vh 25vh;
    }
    #cross {
      position: absolute;
      left: calc(50vw - 4px);
      top: calc(50vh - 4px);
      width: 8px;
      height: 8px;
    }
    #side {
      display: none;
      position: absolute;
      left: 1safe-left;
      top: calc(50vh - 20px);
      width: 10vw;
      height: 40px;
    }
    @media (aspect-ratio >= 21/9) {
      #side {
        display: block;
      }
    }
  </layout>
  <style>
    /* T-176: one HUD, laid out on the actual screen. The background covers the whole viewport
         (bleed), the key elements anchor to the safe area, the side panel only shows at 21:9+. */
    #bg {
      background-gradient: linear-gradient(90deg, #203040 0%, #405060 50%, #203040 100%);
    }
    #hp {
      background-color: #401010;
    }
    #hpfill {
      background-color: #e03030;
    }
    #map {
      border-radius: 50%;
      background-color: #30a060;
    }
    #cross {
      background-color: #ffffff;
    }
    #side {
      background-color: #4080ff;
    }
    @media (aspect-ratio >= 21/9) {
    }
  </style>
</xt>
