<xt version="2">

  <body>
    <div id="a">Outline</div>
  </body>

  <layout>
    body {
      width: 256px;
      height: 256px;
    }
    #a {
      position: absolute;
      left: 38px;
      top: 108px;
    }
  </layout>
  <style>
    @font-face {
      font-family: "Noto Sans";
      src: "../../fonts/NotoSans-Regular.subset.ttf";
    }
    body {
      background-color: #4080c0;
    }
    #a {
      font-family: "Noto Sans";
      font-size: 40px;
      color: #ffffff;
      effect: outline(2px #000000 1px outer);
    }
  </style>
</xt>
