<xt version="2">

  <body>
    <div id="left">Left</div>
    <div id="center">Center</div>
    <div id="right">Right</div>
  </body>

  <layout>
    div {
      margin: 12px;
      width: 220px;
    }
  </layout>
  <style>
    @font-face {
      font-family: "Noto Sans";
      src: "../../fonts/NotoSans-Regular.subset.ttf";
    }
    div {
      font-family: "Noto Sans";
      font-size: 22px;
      color: #202020;
      background-color: #f0f0f0;
    }
    #left {
      text-align: left;
    }
    #center {
      text-align: center;
    }
    #right {
      text-align: right;
    }
  </style>
</xt>
