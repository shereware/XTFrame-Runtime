<xt version="2">

  <!-- T-822: SVG gradients whose first stop is transparent (linear and radial, fill and stroke);
       the first stop's alpha no longer scales the whole gradient. -->
  <body>
    <img id="icon" src="gradient_alpha.svg"/>
  </body>

  <layout>
    body {
      margin: 0;
    }
    #icon {
      width: 256px;
      height: 256px;
    }
  </layout>
  <style>
    #icon {
      object-fit: fill;
    }
  </style>
</xt>
