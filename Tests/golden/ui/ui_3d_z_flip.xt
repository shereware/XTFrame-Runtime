<xt version="2">

  <body>
    <div id="stage">
      <div id="floor"></div>
      <div id="card"><div id="mark"></div></div>
    </div>
  </body>

  <layout>
    body {
      width: 256px;
      height: 256px;
    }
    #stage {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 256px;
      height: 256px;
      perspective: 500px;
      perspective-origin: 50% 50%;
    }
    /* A flat reference square on the root plane (z = 0), so the card's depth reads by its size. */
    #floor {
      position: absolute;
      left: 88px;
      top: 88px;
      width: 80px;
      height: 80px;
    }
    #card {
      position: absolute;
      left: 78px;
      top: 68px;
      width: 100px;
      height: 120px;
    }
    /* Top-right in the card's own frame: once the card has turned past 90 deg it shows mirrored. */
    #mark {
      position: absolute;
      left: 60px;
      top: 12px;
      width: 28px;
      height: 28px;
    }
  </layout>
  <style>
    /* T-702 (19 §19.3 / §19.10): a 3D layer animated by `@keyframes` with real 3D transform
         functions: out along z and back (translateZ 0 -> 120 -> 0 px) while it flips about Y
         (rotateY 0 -> 135 -> 180 deg). The manifest samples 0.25 s (z 60, 67.5 deg), 0.5 s (z 120,
         135 deg) and 0.75 s (z 60, 157.5 deg). Before T-702 the translateZ keyframes compiled to
         a Length track the IR validator rejects (kInvalidIr). */
    body {
      background-color: #0b0e12;
    }
    #floor {
      border: 2px #3a4a5a;
    }
    #card {
      background-color: #1d3050;
      border: 4px #6fb7ff;
      animation: zflip 1s linear 0s 1 normal both;
    }
    #mark {
      background-color: #ffd166;
    }
    @keyframes zflip {
      0% {
        transform: translateZ(0px) rotateY(0deg);
      }
      50% {
        transform: translateZ(120px) rotateY(135deg);
      }
      100% {
        transform: translateZ(0px) rotateY(180deg);
      }
    }
  </style>
</xt>
