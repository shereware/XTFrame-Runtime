<xt>
  <head>
    <style>
      #i1 { width: 200px; height: 60px; margin: 8px; object-fit: fill; }
      #i2 { width: 200px; height: 60px; margin: 8px; object-fit: contain; }
      #i3 { width: 200px; height: 60px; margin: 8px; object-fit: cover; }
    </style>
  </head>
  <body>
    <img id="i1" src="checker.png"/>
    <img id="i2" src="checker.png"/>
    <img id="i3" src="checker.png"/>
  </body>
</xt>
