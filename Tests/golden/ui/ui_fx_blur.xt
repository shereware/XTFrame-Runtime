      position: absolute;
      left: 28px;
      top: 88px;
      width: 90px;
      height: 90px;
    }
    #b {
      position: absolute;
      left: 138px;
      top: 88px;
      width: 90px;
      height: 90px;
    }
  </layout>
  <style>
    #a {
      background-color: #ff4040;
      effect: blur(6px);
    }
    #b {
      background-color: #4080ff;
      effect: blur(6px);
    }
  </style>
</xt>
