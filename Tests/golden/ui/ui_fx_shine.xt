<xt version="2">

  <body>
    <div id="a"></div>
  </body>

  <layout>
    body {
      width: 256px;
      height: 256px;
    }
    #a {
      position: absolute;
      left: 58px;
      top: 108px;
      width: 140px;
      height: 40px;
    }
  </layout>
  <style>
    body {
      background-color: #f0f0f0;
    }
    @keyframes shinesweep {
      from {
        effect: shine(20deg 30px #fff 1 0.5 0);
      }
      to {
        effect: shine(20deg 30px #fff 1 0.5 1);
      }
    }
    #a {
      border-radius: 6px;
      background-color: #202030;
      effect: shine(20deg 30px #fff 1 0.5 0);
      animation: shinesweep 1s linear;
    }
  </style>
</xt>
