<xt version="2">

  <body>
    <div id="box">
      <anim id="clip" src="../../lottie/min_solid_anim.json" autoplay="false"/>
    </div>
  </body>

  <layout>
    #box {
      width: 120px;
      height: 120px;
      margin: 40px;
      padding: 10px;
    }
    #clip {
      width: 92px;
      height: 92px;
    }
  </layout>
  <style>
    #box {
      border: 4px #333333;
    }
    #clip {
      object-fit: contain;
    }
  </style>
</xt>
