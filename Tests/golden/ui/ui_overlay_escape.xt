<xt version="2">

  <body>
    <div id="clip">
      <div id="inside"></div>
      <div id="pop"></div>
    </div>
    <div id="cover"></div>
  </body>

  <layout>
    #clip {
      position: absolute;
      left: 30px;
      top: 30px;
      width: 100px;
      height: 80px;
      overflow: hidden;
    }
    #inside {
      position: absolute;
      left: -20px;
      top: 40px;
      width: 60px;
      height: 80px;
    }
    #pop {
      position: absolute;
      left: 50px;
      top: -20px;
      width: 120px;
      height: 100px;
      layer: overlay;
    }
    #cover {
      position: absolute;
      left: 120px;
      top: 90px;
      width: 110px;
      height: 110px;
    }
  </layout>
  <style>
    /* T-194 (08.9): #pop is inside the overflow-hidden #clip but is `layer: overlay`, so it is
         neither clipped nor covered by the later sibling #cover; #inside is clipped as usual. */
    #clip {
      background-color: #eeeeee;
    }
    #inside {
      background-color: #0066ff;
    }
    #pop {
      background-color: #ff5500;
    }
    #cover {
      background-color: #22aa44;
    }
  </style>
</xt>
