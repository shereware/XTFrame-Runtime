<xt version="2">

  <body>
    <div id="parent">
      <div id="child"></div>
    </div>
  </body>

  <layout>
    #parent {
      width: 120px;
      height: 120px;
      margin: 40px;
    }
    #child {
      width: 60px;
      height: 60px;
    }
  </layout>
  <style>
    #parent {
      background-color: #ff0000;
      visibility: hidden;
    }
    #child {
      background-color: #00aa00;
      visibility: visible;
    }
  </style>
</xt>
