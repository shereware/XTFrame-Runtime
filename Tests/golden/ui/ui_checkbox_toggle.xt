<xt version="2">

  <body>
    <input id="chk1" type="checkbox" />
    <input id="chk2" type="checkbox" />
  </body>

  <layout>
    input {
      position: absolute;
      width: 40px;
      height: 40px;
    }
    #chk1 {
      left: 20px;
      top: 20px;
    }
    #chk2 {
      left: 20px;
      top: 80px;
    }
  </layout>
  <style>
    input {
      background-color: #cccccc;
    }
    input:checked {
      background-color: #00aa00;
    }
  </style>
</xt>
