<xt version="2">

  <body>
    <div id="box">
      <anim id="clip" src="../lottie/scale_rotate.json" autoplay="true" loop="true"/>
    </div>
  </body>

  <layout>
    #box {
      width: 180px;
      height: 180px;
      margin: 38px;
    }
    #clip {
      width: 160px;
      height: 160px;
    }
  </layout>
  <style>
    #box {
      border: 2px #333333;
    }
    #clip {
      object-fit: contain;
    }
  </style>
</xt>
