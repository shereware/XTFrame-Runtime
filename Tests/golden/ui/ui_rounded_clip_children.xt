<xt version="2">

  <body>
    <div id="a"><div id="a-child"></div></div>
    <div id="b"><div id="b-child"></div><div id="b-inner"></div></div>
  </body>

  <layout>
    body {
      width: 256px;
      height: 256px;
    }
    #a {
      position: absolute;
      left: 16px;
      top: 48px;
      width: 104px;
      height: 120px;
      overflow: hidden;
    }
    #a-child {
      position: absolute;
      left: -10px;
      top: -10px;
      width: 124px;
      height: 140px;
    }
    #b {
      position: absolute;
      left: 136px;
      top: 48px;
      width: 104px;
      height: 120px;
      overflow: hidden;
    }
    #b-child {
      position: absolute;
      left: -20px;
      top: -20px;
      width: 144px;
      height: 160px;
    }
    #b-inner {
      position: absolute;
      left: 20px;
      top: 30px;
      width: 64px;
      height: 60px;
    }
  </layout>
  <style>
    /* T-572 (18 §18.13, improvement report F25): a parent with `border-radius` and
         `overflow: hidden` clips its children with the rounded padding box, on SW and GL alike
         (xt_gl_tests compares GL to this SW image). Left: a bordered parent (the clip follows
         the inner, padding-box radius); right: no border, a child that overhangs every corner. */
    body {
      background-color: #0b0e12;
    }
    #a {
      border-radius: 28px;
      border-width: 6px;
      border-color: #c9a24a;
      background-color: #161a21;
    }
    #a-child {
      background-color: #3ad0e6;
    }
    #b {
      border-radius: 40px 12px 40px 12px;
      background-color: #161a21;
    }
    #b-child {
      background-color: #ef476f;
    }
    #b-inner {
      background-color: #ffd166;
    }
  </style>
</xt>
