<xt version="2">

  <body>
    <video id="Intro" src="intro.mp4"></video>
    <external id="Map" source="engine://minimap"></external>
  </body>

  <layout>
    body {
      margin: 0;
    }
    #Intro {
      position: absolute;
      left: 16px;
      top: 16px;
      width: 224px;
      height: 96px;
    }
    #Map {
      position: absolute;
      left: 16px;
      top: 128px;
    }
  </layout>
  <style>
    @font-face {
      font-family: "Noto Sans";
      src: "../../fonts/NotoSans-Regular.subset.ttf";
    }
    body {
      font-family: "Noto Sans";
    }
  </style>
</xt>
