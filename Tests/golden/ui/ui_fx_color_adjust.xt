<xt version="2">

  <body>
    <div id="i1"></div>
    <div id="i2"></div>
    <div id="i3"></div>
  </body>

  <layout>
    body {
      width: 256px;
      height: 256px;
    }
    div {
      position: absolute;
      top: 88px;
      width: 70px;
      height: 70px;
    }
    #i1 {
      left: 8px;
    }
    #i2 {
      left: 93px;
    }
    #i3 {
      left: 178px;
    }
  </layout>
  <style>
    body {
      background-color: #ffffff;
    }
    div {
      background-color: #ff8800;
    }
    #i2 {
      effect: color-adjust(saturate(-1));
    }
    #i3 {
      effect: color-adjust(hue-rotate(120deg));
    }
  </style>
</xt>
