<xt version="2">

  <body>
    <div class="c0 r0 k0"></div><div class="c0 r0 k1"></div><div class="c0 r0 k2"></div><div class="c0 r0 k3"></div>
    <div class="c1 r1 k0"></div><div class="c1 r1 k1"></div><div class="c1 r1 k2"></div><div class="c1 r1 k3"></div>
    <div class="c2 r2 k0"></div><div class="c2 r2 k1"></div><div class="c2 r2 k2"></div><div class="c2 r2 k3"></div>
    <div class="c3 r3 k0"></div><div class="c3 r3 k1"></div><div class="c3 r3 k2"></div><div class="c3 r3 k3"></div>
  </body>

  <layout>
    body {
      width: 256px;
      height: 256px;
    }
    div {
      position: absolute;
      width: 56px;
      height: 56px;
    }
    .r0 {
      top: 8px;
    }
    .r1 {
      top: 70px;
    }
    .r2 {
      top: 132px;
    }
    .r3 {
      top: 194px;
    }
    .k0 {
      left: 8px;
    }
    .k1 {
      left: 70px;
    }
    .k2 {
      left: 132px;
    }
    .k3 {
      left: 194px;
    }
  </layout>
  <style>
    body {
      background-color: #ffffff;
    }
    .c0 {
      background-color: #ff8800;
    }
    .c1 {
      background-color: #2a7fd4;
    }
    .c2 {
      background-color: #33cc66;
    }
    .c3 {
      background-color: #808080;
    }
    .k0 {
      effect: color-adjust(invert(0.5));
    }
    .k1 {
      effect: color-adjust(invert(100%));
    }
    .k2 {
      effect: color-adjust(sepia(1));
    }
    .k3 {
      effect: color-adjust(brightness(0.1) hue-rotate(40deg) invert(0.3) sepia(0.6));
    }
  </style>
</xt>
