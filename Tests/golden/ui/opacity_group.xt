<xt version="2">

  <body>
    <div id="group">
      <div id="x"></div>
      <div id="y"></div>
    </div>
  </body>

  <layout>
    #group {
      position: relative;
      width: 150px;
      height: 150px;
      margin: 40px;
    }
    #x {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100px;
      height: 100px;
    }
    #y {
      position: absolute;
      left: 40px;
      top: 40px;
      width: 100px;
      height: 100px;
    }
  </layout>
  <style>
    #group {
      opacity: 0.5;
    }
    #x {
      background-color: #ff0000;
    }
    #y {
      background-color: #00ff00;
    }
  </style>
</xt>
