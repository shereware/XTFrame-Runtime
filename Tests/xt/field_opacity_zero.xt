<xt>
  <head>
    <style>
      div { width: 40px; height: 40px; background-color: #ff0000; }
      #o0 { opacity: 0; }
      #o0dot { opacity: 0.0; }
      #o001 { opacity: 0.01; }
      #o05 { opacity: 0.5; }
      #o1 { opacity: 1; }
    </style>
  </head>
  <body>
    <div id="o0"></div>
    <div id="o0dot"></div>
    <div id="o001"></div>
    <div id="o05"></div>
    <div id="o1"></div>
  </body>
</xt>
