<xt version="2">

  <body>
    <img id="shown" src="svg_icon.svg"/>
    <img id="rasterShown" src="field_checker.png"/>
    <img id="rasterSelf" src="field_checker.png"/>
    <img id="self" src="svg_icon.svg"/>
    <div id="hidingParent">
      <img id="inherited" src="svg_icon.svg"/>
      <img id="rasterInherited" src="field_checker.png"/>
    </div>
  </body>

  <layout>
    img,
    div {
      width: 40px;
      height: 40px;
    }
  </layout>
  <style>
    #self,
    #rasterSelf {
      visibility: hidden;
    }
    #hidingParent {
      visibility: hidden;
    }
  </style>
</xt>
