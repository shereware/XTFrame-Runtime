<xt version="2">

  <ports>
    items: list<struct{name: string}>
  </ports>

  <body>
    <div id="box">
      <div id="scroll">
        <repeat port="items" id="Item" virtualize>
          <div id="row"><span id="name" bind:text="item(name)"></span></div>
        </repeat>
      </div>
    </div>
  </body>

  <layout>
    #scroll {
      width: 200px;
      height: 0px;
      overflow: scroll;
    }
    #row {
      height: 20px;
    }
  </layout>
</xt>
