<xt version="2">

  <symbol name="Panel">
    <div id="Box"><slot name="body">Panel</slot></div>
  </symbol>

  <layout>
    symbol(Panel) {
      #Box {
        display: flex;
        width: 40px;
        height: 20px;
      }
    }
  </layout>
  <style>
    symbol(Panel) {
      #Box {
        background-image: url("textures/x.png");
        background-repeat: repeat;
      }
    }
  </style>
</xt>
