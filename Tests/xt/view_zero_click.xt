<xt version="2">

  <ports>
    count: number in
  </ports>

  <body>
    <div id="box">
      <div id="zero" on:click="set(count, 7)"></div>
      <span id="label" bind:text="count"></span>
    </div>
  </body>

  <layout>
    body {
      display: flex;
      flex-direction: column;
    }
    #zero {
      width: 0px;
      height: 0px;
    }
    #label {
      width: 100px;
      height: 24px;
    }
  </layout>
</xt>
