<xt version="2">

  <ports>
    count: number in
  </ports>

  <body>
    <div id="stage">
      <div id="field" tabindex="0" on:key(Escape)="set(count, 5)"></div>
      <span id="label" bind:text="count"></span>
      <div id="btn" on:click="set(count, 7)"></div>
      <div id="stamp-applied"></div>
    </div>
  </body>

  <layout>
    #stage {
      position: relative;
      width: 400px;
      height: 300px;
    }
    #field {
      width: 100px;
      height: 24px;
    }
    #label {
      width: 100px;
      height: 24px;
    }
    #btn {
      position: absolute;
      left: 0px;
      top: 120px;
      width: 100px;
      height: 40px;
    }
    #stamp-applied {
      position: absolute;
      left: 0px;
      top: 100px;
      width: 200px;
      height: 100px;
    }
  </layout>
</xt>
