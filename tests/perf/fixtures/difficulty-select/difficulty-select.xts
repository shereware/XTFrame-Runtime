/* import: Main.dc.html:1/4 */
#vignette {
  background-gradient: radial-gradient(75% 70% at 50% 48%, #00000000 55%, #000000b3 100%);
  height: 720px;
  left: 0px;
  pointer-events: none;
  position: absolute;
  top: 0px;
  width: 1280px;
}

.mi {
  background-color: transparent;
  border-width: 0px;
  cursor: pointer;
  transition: background-color 200ms ease-out;
}

.mi:hover {
  background-color: #dcf0eb14;
}

.hb {
  cursor: pointer;
  transition: background-color 200ms ease-out;
}

.hb:hover {
  background-color: #3c6e64e6;
}

@keyframes fall {from{transform:translateY(0px)}to{transform:translateY(1080px)}}

@keyframes slide {0%{transform:translateY(0px);opacity:1}85%{opacity:1}100%{transform:translateY(120px);opacity:0}}

@keyframes shaft {from{opacity:0.12}to{opacity:0.34}}

@keyframes sway {from{transform:rotateX(1.5deg) rotateY(-2.5deg)}to{transform:rotateX(-1.5deg) rotateY(2.5deg)}}

@keyframes drift {from{transform:translateX(-14px)}to{transform:translateX(14px)}}

@keyframes scan {from{transform:translateY(-40px)}to{transform:translateY(200px)}}

@keyframes blink {0%{opacity:1}50%{opacity:0.2}100%{opacity:1}}

@keyframes pulse {0%{opacity:0.5}50%{opacity:1}100%{opacity:0.5}}

