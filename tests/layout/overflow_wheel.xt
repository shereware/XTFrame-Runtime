<xt>
  <head>
    <style>
      #outer { position: absolute; left: 0px; top: 0px; width: 200px; height: 100px; overflow: scroll; }
      #inner { width: 100px; height: 80px; overflow: auto; }
      #inner-c { width: 50px; height: 50px; }
      #spacer { height: 400px; }
    </style>
  </head>
  <body>
    <div id="outer">
      <div id="inner"><div id="inner-c"></div></div>
      <div id="spacer"></div>
    </div>
  </body>
</xt>
