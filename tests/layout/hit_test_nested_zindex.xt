<xt>
  <head>
    <style>
      #parent { position: absolute; left: 0px; top: 0px; width: 100px; height: 100px; }
      #child { position: absolute; left: 10px; top: 10px; width: 20px; height: 20px; }
      #low { position: absolute; left: 150px; top: 0px; width: 60px; height: 60px; z-index: 0; }
      #high { position: absolute; left: 170px; top: 20px; width: 60px; height: 60px; z-index: 1; }
    </style>
  </head>
  <body>
    <div id="parent"><div id="child"></div></div>
    <div id="low"></div>
    <div id="high"></div>
  </body>
</xt>
