<xt>
  <head>
    <style>
      #rowRev { display: flex; flex-direction: row-reverse; width: 400px; height: 30px; }
      #ra { width: 80px; }
      #rb { width: 60px; }
      #rc { width: 100px; }

      #colRev { display: flex; flex-direction: column-reverse; width: 100px; height: 300px; }
      #ca { height: 80px; }
      #cb { height: 60px; }
      #cc { height: 100px; }
    </style>
  </head>
  <body>
    <div id="rowRev">
      <div id="ra"></div>
      <div id="rb"></div>
      <div id="rc"></div>
    </div>
    <div id="colRev">
      <div id="ca"></div>
      <div id="cb"></div>
      <div id="cc"></div>
    </div>
  </body>
</xt>
