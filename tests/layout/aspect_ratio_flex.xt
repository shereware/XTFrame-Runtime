<xt>
  <head>
    <style>
      #row { display: flex; height: 200px; }
      #r-stretch { width: 100px; aspect-ratio: 2; }
      #r-center { width: 100px; aspect-ratio: 2; align-self: center; }
      #r-basis { flex-basis: 60px; aspect-ratio: 3 / 2; align-self: flex-start; }
      #r-plain { width: 50px; }
      #col { display: flex; flex-direction: column; width: 300px; }
      #c-stretch { height: 40px; aspect-ratio: 2; }
      #c-center { height: 40px; aspect-ratio: 2; align-self: center; }
      #c-plain { height: 30px; }
    </style>
  </head>
  <body>
    <div id="row">
      <div id="r-stretch"></div>
      <div id="r-center"></div>
      <div id="r-basis"></div>
      <div id="r-plain"></div>
    </div>
    <div id="col">
      <div id="c-stretch"></div>
      <div id="c-center"></div>
      <div id="c-plain"></div>
    </div>
  </body>
</xt>
