<xt>
  <head>
    <style>
      /* T-338 (06 §6.15, CSS Grid §12.8): with the initial justify-content / align-content
         (normal = stretch) and a definite size, the `auto` tracks share the free space -- empty
         items fill the cells; an `fr` row takes the space first, so the `auto` row keeps its
         content size; `align-content: start` turns the stretch off. */
      #s1 { display: grid; width: 200px; height: 100px; grid-template-columns: 50px auto; }
      #s2 { display: grid; width: 200px; height: 100px; grid-template-rows: auto 1fr; }
      #a2 { height: 20px; }
      #s3 { display: grid; width: 100px; height: 100px; grid-template-columns: 100px;
            align-content: start; }
    </style>
  </head>
  <body>
    <div id="s1"><div id="p"></div><div id="q"></div><div id="r"></div><div id="t"></div></div>
    <div id="s2"><div id="a2"></div><div id="b2"></div></div>
    <div id="s3"><div id="u"></div><div id="v"></div></div>
  </body>
</xt>
