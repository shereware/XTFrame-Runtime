<xt>
  <head>
    <style>
      #parent { position: absolute; left: 0px; top: 0px; width: 100px; height: 100px; pointer-events: none; }
      #child { position: absolute; left: 20px; top: 20px; width: 40px; height: 40px; pointer-events: auto; }
    </style>
  </head>
  <body>
    <div id="parent"><div id="child"></div></div>
  </body>
</xt>
