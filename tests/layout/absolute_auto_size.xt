<xt>
  <head>
    <style>
      #cb { position: relative; width: 300px; height: 200px; }
      #a { position: absolute; left: 10px; top: 10px; width: 100px; padding: 10px; }
      .row { height: 20px; }
      #b { position: absolute; right: 20px; bottom: 30px; padding: 10px; }
      .wide { width: 120px; height: 20px; }
    </style>
  </head>
  <body>
    <div id="cb">
      <div id="a">
        <div class="row"></div>
        <div class="row"></div>
      </div>
      <div id="b">
        <div class="wide"></div>
      </div>
    </div>
  </body>
</xt>
