<xt>
  <head>
    <style>
      @keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }
      #animEl { width: 10px; height: 10px; animation: fadeIn 0.1s; }
      #transEl { width: 10px; height: 10px; background-color: #000000; transition: background-color 0.1s; }
      #transEl.on { background-color: #ffffff; }
    </style>
  </head>
  <body id="body">
    <div id="animEl"></div>
    <div id="transEl"></div>
  </body>
</xt>
