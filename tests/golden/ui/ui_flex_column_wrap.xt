<xt>
  <head>
    <style>
      #container {
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        width: 232px;
        height: 200px;
        margin: 12px;
        gap: 4px;
        background-color: #eeeeee;
      }
      #container > div { width: 100px; height: 60px; }
      #a { background-color: #ff0000; }
      #b { background-color: #00aa00; }
      #c { background-color: #0000ff; }
      #d { background-color: #ff8800; }
      #e { background-color: #8800ff; }
    </style>
  </head>
  <body>
    <div id="container">
      <div id="a"></div>
      <div id="b"></div>
      <div id="c"></div>
      <div id="d"></div>
      <div id="e"></div>
    </div>
  </body>
</xt>
