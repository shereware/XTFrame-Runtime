<xt>
  <head>
    <style>
      /* T-243b (32 §32.2.2): a skinned shape with its own transform. The box's points start at
         x = 0 and its transform moves them 60 to the right, onto two bones from (60, 140), each
         60 long; the inverse bind is inverse(rest) x own, so the box sits where an unskinned copy
         would (the grey outline) and only the right half follows the second bone, which an IK
         constraint (chain 1) aims up at the red dot. */
      svg { position: absolute; left: 28px; top: 28px; width: 200px; height: 200px; }
    </style>
  </head>
  <body>
    <svg id="Rig1" viewBox="0 0 200 200" width="200" height="200">
      <path id="Ref" d="M0 128 L120 128 L120 152 L0 152 Z" transform="translate(60 0)" fill="none"
            stroke="#999999" stroke-width="1"/>
      <path id="Arm" d="M0 128 L60 128 L120 128 L120 152 L60 152 L0 152 Z" transform="translate(60 0)"
            fill="#3366cc" stroke="#112244" stroke-width="2" xt-skin="Skel">
        <xt-weights bones="A B">0 0:1
1 0:.5 1:.5
2 1:1
3 1:1
4 0:.5 1:.5
5 0:1</xt-weights>
      </path>
      <xt-skeleton id="Skel">
        <xt-bone id="A" length="60" translate="60 140">
          <xt-bone id="B" length="60">
            <xt-constraint kind="ik" target="#Hand" chain="1"/>
          </xt-bone>
        </xt-bone>
      </xt-skeleton>
      <circle id="Hand" cx="0" cy="0" r="5" transform="translate(160 70)" fill="#dd2222"/>
    </svg>
  </body>
</xt>
