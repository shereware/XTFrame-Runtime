<xt>
  <head>
    <style>
      div {
        position: absolute;
        background-color: #3060c0;
      }
      /* Plain inset shadow on a rounded rect: a dark rim on every side. */
      #a {
        left: 24px;
        top: 24px;
        width: 96px;
        height: 72px;
        border-radius: 16px;
        effect: shadow(0px 0px 12px #000000cc 1 inset);
      }
      /* Offset inset shadow: darker along the top-left inner edge. */
      #b {
        left: 144px;
        top: 24px;
        width: 88px;
        height: 88px;
        border-radius: 44px;
        background-color: #c06030;
        effect: shadow(8px 8px 10px #000000cc 1 inset);
      }
      /* spread > 0 pushes the shadow further inside the shape. */
      #c {
        left: 24px;
        top: 136px;
        width: 96px;
        height: 96px;
        border-radius: 48px;
        background-color: #30a060;
        effect: shadow(0px 0px 8px 8px #000000cc 1 inset);
      }
      /* Same rounded rect, offset and spread together. */
      #d {
        left: 144px;
        top: 144px;
        width: 88px;
        height: 72px;
        border-radius: 12px;
        effect: shadow(-6px 4px 10px 4px #000000cc 1 inset);
      }
    </style>
  </head>
  <body>
    <div id="a"></div>
    <div id="b"></div>
    <div id="c"></div>
    <div id="d"></div>
  </body>
</xt>
