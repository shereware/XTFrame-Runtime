<xt>
  <head>
    <style>
      #box {
        width: 120px;
        height: 120px;
        margin: 40px;
        padding: 10px;
        border: 4px #333333;
      }
      #clip {
        width: 92px;
        height: 92px;
        object-fit: contain;
      }
