<xt>
  <head>
    <style>
      #box {
        position: absolute;
        left: 20px;
        top: 20px;
        width: 100px;
        height: 100px;
        overflow: scroll;
        background-color: #eeeeee;
      }
      #content {
        width: 60px;
        height: 300px;
      }
      #a { width: 60px; height: 100px; background-color: #ff0000; }
      #b { width: 60px; height: 100px; background-color: #00aa00; }
      #c { width: 60px; height: 100px; background-color: #0000ff; }
    </style>
  </head>
  <body>
    <div id="box">
      <div id="content">
        <div id="a"></div>
        <div id="b"></div>
        <div id="c"></div>
      </div>
    </div>
  </body>
</xt>
