<xt>
  <head>
    <style>
      #group { position: relative; width: 150px; height: 150px; margin: 40px; opacity: 0.5; }
      #x { position: absolute; left: 0px; top: 0px; width: 100px; height: 100px; background-color: #ff0000; }
      #y { position: absolute; left: 40px; top: 40px; width: 100px; height: 100px; background-color: #00ff00; }
    </style>
  </head>
  <body>
    <div id="group">
      <div id="x"></div>
      <div id="y"></div>
    </div>
  </body>
</xt>
