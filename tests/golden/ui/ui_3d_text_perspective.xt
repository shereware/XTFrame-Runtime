<xt>
  <head>
    <style>
      @font-face { font-family: "Noto Sans"; src: "../../fonts/NotoSans-Regular.subset.ttf"; }
      #stage { position: absolute; left: 0px; top: 0px; width: 256px; height: 256px; perspective: 400px; }
      #card {
        position: absolute; left: 58px; top: 88px; width: 140px; height: 80px;
        transform: rotateX(45deg); background-color: #f0f0f0; border: 2px #202020;
        font-family: "Noto Sans"; font-size: 22px; color: #202020; text-align: center;
      }
    </style>
  </head>
  <body>
    <div id="stage"><div id="card">XTFrame</div></div>
  </body>
</xt>
