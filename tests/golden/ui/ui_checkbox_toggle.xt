<xt>
  <head>
    <style>
      input {
        position: absolute;
        width: 40px;
        height: 40px;
        background-color: #cccccc;
      }
      input:checked {
        background-color: #00aa00;
      }
      #chk1 { left: 20px; top: 20px; }
      #chk2 { left: 20px; top: 80px; }
    </style>
  </head>
  <body>
    <input id="chk1" type="checkbox" />
    <input id="chk2" type="checkbox" />
  </body>
</xt>
