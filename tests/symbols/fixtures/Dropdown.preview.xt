<xt>
  <head>
    <!-- T-198: preview of the Dropdown standard symbol (golden states and thumbnail). -->
    <link href="../../../editor/symbols/tokens.xts"/>
    <link rel="symbols" href="../../../editor/symbols/Dropdown.xt"/>
    <style>
      @font-face { font-family: "Noto Sans"; src: "../../fonts/NotoSans-Regular.subset.ttf"; }
      body {
        width: 300px;
        height: 220px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="Dropdown" id="Quality" slot:label="Quality"/>
  </body>
</xt>
