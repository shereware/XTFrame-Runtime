<xt>
  <head>
    <!-- T-241: preview of the VirtualJoystick standard mobile symbol (golden states and thumbnail). -->
    <link href="../../../editor/symbols/tokens.xts"/>
    <link rel="symbols" href="../../../editor/symbols/mobile/VirtualJoystick.xt"/>
    <style>
      @font-face { font-family: "Noto Sans"; src: "../../fonts/NotoSans-Regular.subset.ttf"; }
      body {
        width: 420px;
        height: 210px;
        padding: 16px;
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        column-gap: 16px;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="VirtualJoystick" id="Stick"/>
    <use symbol="VirtualJoystick" id="Float" variant:Mode="Floating"/>
  </body>
</xt>
