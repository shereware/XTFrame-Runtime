<xt>
  <head>
    <!-- ProgressBar: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="ProgressBar" state-groups="Progress: Running|Complete"
            requires="states: Running, Complete; slots: label">
      <div id="Box" port:value="number in" port:value_max="number in"
           bind:state.Running="value | lt(100%)" bind:state.Complete="value | ge(100%)">
        <div id="Head">
          <span id="Label"><slot name="label">Loading</slot></span>
          <span id="Percent" bind:text="value | range(0, value_max, 0, 100) | round | format('{0}%')"></span>
        </div>
        <div id="Track">
          <div id="Fill" bind:width="value | clamp(0, value_max) | range(0, value_max, 0%, 100%) | tween(0.25s, ease-out)"></div>
        </div>
      </div>
    </symbol>
    <style>
      symbol(ProgressBar) {
        #Box {
          display: flex;
          flex-direction: column;
          row-gap: var(--space-1);
          width: 320px;
          font-family: var(--font-family);
          font-size: var(--font-size-s);
          color: var(--color-text);
        }
        #Head { display: flex; justify-content: space-between; }
        #Percent { color: var(--color-text-dim); }
        #Track {
          height: 8px;
          border-radius: var(--radius-full);
          background-color: var(--color-track);
          overflow: hidden;
        }
        #Fill {
          width: 0%;
          height: 8px;
          border-radius: var(--radius-full);
          background-color: var(--color-accent);
          transition: background-color var(--motion-normal) linear;
        }
        #Box:state(Running) #Fill { background-color: var(--color-accent); }
        #Box:state(Complete) #Fill { background-color: var(--color-success); }
      }
    </style>
  </head>
</xt>
