<xt>
  <head>
    <!-- Notification: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="Notification" state-groups="Tone: Info|Warning|Danger"
            requires="states: Info, Warning, Danger; slots: title, text">
      <div id="Box" port:tone="number in"
           bind:state.Info="tone | eq(0)" bind:state.Warning="tone | eq(1)" bind:state.Danger="tone | eq(2)"
           on:show="sound(ui_notify); play(intro)" on:hide="play(outro) then hide">
        <div id="Stripe"></div>
        <div id="Badge"></div>
        <div id="Copy">
          <span id="Title"><slot name="title">Notification</slot></span>
          <span id="Text"><slot name="text">Details.</slot></span>
        </div>
      </div>
    </symbol>
    <style>
      symbol(Notification) {
        #Box {
          display: flex;
          align-items: center;
          column-gap: var(--space-3);
          width: 340px;
          padding: var(--space-3) var(--space-4) var(--space-3) 0px;
          border-radius: var(--radius-s);
          background-color: var(--color-surface);
          font-family: var(--font-family);
          effect: shadow(0 6px 16px 0 var(--color-shadow) 1);
        }
        #Stripe { width: 4px; align-self: stretch; border-radius: var(--radius-s) 0px 0px var(--radius-s); background-color: var(--color-info); }
        #Badge { width: 12px; height: 12px; border-radius: var(--radius-full); background-color: var(--color-info); }
        #Copy { display: flex; flex-direction: column; row-gap: 2px; }
        #Title { color: var(--color-text); font-size: var(--font-size-m); font-weight: 700; }
        #Text { color: var(--color-text-dim); font-size: var(--font-size-s); }
        #Box:state(Info) #Stripe { background-color: var(--color-info); }
        #Box:state(Info) #Badge { background-color: var(--color-info); }
        #Box:state(Warning) #Stripe { background-color: var(--color-warning); }
        #Box:state(Warning) #Badge { background-color: var(--color-warning); }
        #Box:state(Danger) #Stripe { background-color: var(--color-danger); }
        #Box:state(Danger) #Badge { background-color: var(--color-danger); }
        @timeline intro {
          #Box { 0s { opacity: 0; transform: translateY(-12px) } 0.25s ease-out { opacity: 1; transform: translateY(0px) } }
        }
        @timeline outro {
          #Box { 0s { opacity: 1; transform: translateY(0px) } 0.2s ease-in { opacity: 0; transform: translateY(-12px) } }
        }
      }
    </style>
  </head>
</xt>
