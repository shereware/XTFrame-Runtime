<xt>
  <head>
    <!-- Tabs: standard symbol (docs/design/30-ui-project.md 30.4). See README.md.
         A tab click selects it at once (`state(TabN, on, target=#Box)`) and emits `select` from
         that tab's element (`Pages/T3`); the host (or flow) may also set `value` (0-3). -->
    <symbol name="Tabs" state-groups="Tab: Tab1|Tab2|Tab3|Tab4"
            requires="states: Hover, Focus, Tab1, Tab2, Tab3, Tab4; slots: tab1, tab2, tab3, tab4">
      <div id="Box" port:value="number in" port:select="event out"
           bind:state.Tab1="value | eq(0)" bind:state.Tab2="value | eq(1)"
           bind:state.Tab3="value | eq(2)" bind:state.Tab4="value | eq(3)">
        <div id="Row">
          <button id="T1" on:click="sound(ui_tab); state(Tab1, on, target=#Box); emit(select)"><span id="T1Text"><slot name="tab1">General</slot></span></button>
          <button id="T2" on:click="sound(ui_tab); state(Tab2, on, target=#Box); emit(select)"><span id="T2Text"><slot name="tab2">Video</slot></span></button>
          <button id="T3" on:click="sound(ui_tab); state(Tab3, on, target=#Box); emit(select)"><span id="T3Text"><slot name="tab3">Audio</slot></span></button>
          <button id="T4" on:click="sound(ui_tab); state(Tab4, on, target=#Box); emit(select)"><span id="T4Text"><slot name="tab4">Controls</slot></span></button>
        </div>
        <div id="Rule"></div>
      </div>
    </symbol>
    <style>
      symbol(Tabs) {
        #Box {
          display: flex;
          flex-direction: column;
          flex-grow: 1;
          font-family: var(--font-family);
          font-size: var(--font-size-m);
        }
        #Row { display: flex; column-gap: var(--space-1); }
        #Rule { height: 1px; background-color: var(--color-border); }
        #T1, #T2, #T3, #T4 {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          row-gap: var(--space-2);
          padding: var(--space-2) var(--space-4) var(--space-2) var(--space-4);
          border-width: 0px 0px 3px 0px;
          border-color: transparent;
          border-radius: var(--radius-s) var(--radius-s) 0px 0px;
          background-color: transparent;
          color: var(--color-text-dim);
          transition: color var(--motion-instant) linear;
        }
        #T1:hover, #T2:hover, #T3:hover, #T4:hover { color: var(--color-text); }
        #T1:focus, #T2:focus, #T3:focus, #T4:focus { background-color: var(--color-surface-raised); }
        #Box:state(Tab1) #T1, #Box:state(Tab2) #T2, #Box:state(Tab3) #T3, #Box:state(Tab4) #T4 {
          color: var(--color-text);
        }
        #Box:state(Tab1) #T1, #Box:state(Tab2) #T2, #Box:state(Tab3) #T3, #Box:state(Tab4) #T4 {
          border-color: var(--color-accent);
        }
      }
    </style>
  </head>
</xt>
