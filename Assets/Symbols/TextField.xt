<xt>
  <head>
    <!-- TextField: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="TextField" requires="states: Hover, Focus, Disabled; slots: label">
      <div id="Box" port:submit="event out">
        <span id="Label"><slot name="label">Name</slot></span>
        <input type="text" id="Field" placeholder="@xt_textfield_placeholder" value=""
               on:key(Enter)="sound(ui_confirm); emit(submit)"/>
      </div>
    </symbol>
    <style>
      symbol(TextField) {
        #Box {
          display: flex;
          flex-direction: column;
          row-gap: var(--space-1);
          width: 280px;
          color: var(--color-text);
          font-family: var(--font-family);
          font-size: var(--font-size-m);
        }
        #Label { color: var(--color-text-dim); font-size: var(--font-size-s); }
        #Field {
          height: var(--control-m);
          padding: var(--space-2) var(--space-3);
          border-width: var(--border-w);
          border-color: var(--color-border);
          border-radius: var(--radius-m);
          background-color: var(--color-surface-sunken);
          color: var(--color-text);
          transition: border-color var(--motion-fast) linear;
        }
        #Field:hover { border-color: var(--color-border-strong); }
        #Field:focus { border-color: var(--color-focus); }
        :disabled #Field {
          background-color: var(--color-disabled-bg) !important;
          color: var(--color-disabled-text) !important;
          border-color: transparent !important;
        }
      }
    </style>
  </head>
</xt>
