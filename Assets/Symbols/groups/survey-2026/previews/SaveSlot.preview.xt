<xt version="2">
  <head>
    <symbols src="../SaveSlot.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stack">
      <use symbol="SaveSlot" id="Normal"/>
      <use symbol="SaveSlot" id="Picked"/>
      <use symbol="SaveSlot" id="Blank" variant:State="Empty" slot:chapter="Empty Slot"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 480px;
      height: 220px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stack {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 16px;
      row-gap: 4px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
