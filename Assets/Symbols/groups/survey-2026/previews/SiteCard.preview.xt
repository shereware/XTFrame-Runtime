<xt version="2">
  <head>
    <symbols src="../SiteCard.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <div id="Right">
        <use symbol="SiteCard" id="Site"/>
      </div>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 260px;
      height: 100px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      padding: 16px;
    }
    #Right {
      display: flex;
      justify-content: flex-end;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }

  </style>
</xt>
