<xt version="2">
  <head>
    <symbols src="../MenuItem.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stack">
      <use symbol="MenuItem" id="NewGame" slot:label="New Game"/>
      <use symbol="MenuItem" id="Continue" slot:label="Continue"/>
      <use symbol="MenuItem" id="Options" slot:label="Options"/>
      <use symbol="MenuItem" id="Quit" slot:label="Quit" disabled="true"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 280px;
      height: 220px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stack {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 16px;
      row-gap: 4px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
