<xt version="2">
  <head>
    <symbols src="../KeyHint.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <div id="Row">
        <use symbol="KeyHint" id="Select" variant:Keys="Two" slot:key="W" slot:key2="S" slot:label="Select"/>
        <use symbol="KeyHint" id="Confirm" variant:Sep="Before" slot:key="E" slot:label="Confirm"/>
        <use symbol="KeyHint" id="Back" variant:Sep="Before" slot:key="B" slot:label="Back"/>
      </div>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 420px;
      height: 56px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      padding: 12px 16px;
    }
    #Row {
      display: flex;
      align-items: center;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }

  </style>
</xt>
