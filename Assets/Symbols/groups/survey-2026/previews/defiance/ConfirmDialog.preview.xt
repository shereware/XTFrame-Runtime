<xt version="2">
  <head>
    <symbols src="../../ConfirmDialog.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <use symbol="ConfirmDialog" id="Confirm">
      <slot name="actions">
        <div id="HintStay"><span id="CapStay">B</span><span id="WordStay">Stay</span></div>
        <div id="HintLeave"><span id="CapLeave">A</span><span id="WordLeave">Leave</span></div>
      </slot>
    </use>
  </body>
  <layout>
    body {
      position: relative;
      width: 560px;
      height: 320px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #HintStay,
    #HintLeave {
      display: flex;
      align-items: center;
      column-gap: var(--space-2);
      padding: var(--space-1) var(--space-2);
    }
    #CapStay,
    #CapLeave {
      padding: 0px var(--space-2);
    }
  </layout>
  <style src="../../tokens-defiance.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
    #HintStay,
    #HintLeave {
      font-family: var(--font-body);
      font-size: var(--font-size-s);
      color: var(--color-text-label);
    }
    #CapStay,
    #CapLeave {
      border-width: var(--rule-thin);
      border-color: var(--color-text-label);
      border-radius: var(--radius-s);
      color: var(--color-text-label);
    }
  </style>
</xt>
