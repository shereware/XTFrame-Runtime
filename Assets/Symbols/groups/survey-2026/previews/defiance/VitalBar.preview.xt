<xt version="2">
  <head>
    <symbols src="../../VitalBar.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <use symbol="VitalBar" id="Health" slot:label="Health"/>
      <use symbol="VitalBar" id="Stamina" variant:Icon="Runner" slot:label="Stamina"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 300px;
      height: 110px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 16px;
    }
  </layout>
  <style src="../../tokens-defiance.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
