<xt version="2">
  <head>
    <symbols src="../ScreenShade.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <div id="Art"></div>
      <div id="Row">
        <use symbol="ScreenShade" id="Vig"/>
        <use symbol="ScreenShade" id="Left" variant:Kind="Left"/>
        <use symbol="ScreenShade" id="Bottom" variant:Kind="Bottom"/>
      </div>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 360px;
      height: 160px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Art {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      width: 100%;
      height: 100%;
    }
    #Row {
      position: relative;
      display: flex;
      column-gap: 12px;
      padding: 16px;
    }
    #Vig,
    #Left,
    #Bottom,
    #Vig/Box,
    #Left/Box,
    #Bottom/Box {
      width: 104px;
      height: 128px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
    #Art {
      background-color: var(--color-text-quiet);
    }
  </style>
</xt>
