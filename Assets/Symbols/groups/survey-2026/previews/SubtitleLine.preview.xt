<xt version="2">
  <head>
    <symbols src="../SubtitleLine.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stack">
      <use symbol="SubtitleLine" id="Named"/>
      <use symbol="SubtitleLine" id="Narration" variant:Speaker="Narrator" slot:line="Narration appears in italics, with no speaker."/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 720px;
      height: 150px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stack {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px;
      row-gap: var(--space-3);
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
