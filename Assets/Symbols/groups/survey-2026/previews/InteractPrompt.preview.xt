<xt version="2">
  <head>
    <symbols src="../InteractPrompt.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <use symbol="InteractPrompt" id="Door"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 240px;
      height: 70px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 16px;
      align-items: flex-start;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
