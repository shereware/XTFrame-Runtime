<xt version="2">
  <head>
    <symbols src="../FilmGrain.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <div id="Art"></div>
      <use symbol="FilmGrain" id="Grain"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 200px;
      height: 120px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Art {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      width: 100%;
      height: 100%;
    }
    #Grain {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 200px;
      height: 120px;
    }
    #Grain/Box {
      width: 200px;
      height: 120px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
    #Art {
      background-color: var(--color-text-quiet);
    }
  </style>
</xt>
