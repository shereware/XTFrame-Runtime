<xt version="2">
  <head>
    <symbols src="../ActionRow.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stack">
      <use symbol="ActionRow" id="Test" slot:label="Test Audio" slot:action="Play Test Sound"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 420px;
      height: 64px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stack {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 12px 20px;
      row-gap: 0px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
