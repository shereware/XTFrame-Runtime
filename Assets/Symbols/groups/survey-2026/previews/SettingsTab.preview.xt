<xt version="2">
  <head>
    <symbols src="../SettingsTab.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stack">
      <use symbol="SettingsTab" id="Gameplay" slot:label="Gameplay"/>
      <use symbol="SettingsTab" id="Graphics" slot:label="Graphics"/>
      <use symbol="SettingsTab" id="Audio" slot:label="Audio"/>
      <use symbol="SettingsTab" id="Controls" slot:label="Controls"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 220px;
      height: 220px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stack {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 22px 17px;
      row-gap: 0px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
