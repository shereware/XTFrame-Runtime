<xt version="2">
  <head>
    <symbols src="../RainLayer.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <div id="Art"></div>
      <use symbol="RainLayer" id="Light"/>
      <use symbol="RainLayer" id="Heavy" variant:Density="Heavy"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 320px;
      height: 180px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Art {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      width: 100%;
      height: 100%;
    }
    #Light,
    #Heavy {
      position: absolute;
      left: 0px;
      width: 320px;
      height: 90px;
    }
    #Light/Box,
    #Heavy/Box {
      width: 320px;
      height: 90px;
    }
    #Light {
      top: 0px;
    }
    #Heavy {
      top: 90px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
    #Art {
      background-color: var(--color-text-quiet);
    }
    #Art {
      background-color: var(--color-text-dim);
    }
  </style>
</xt>
