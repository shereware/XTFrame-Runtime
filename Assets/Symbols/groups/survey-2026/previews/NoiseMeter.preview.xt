<xt version="2">
  <head>
    <symbols src="../NoiseMeter.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <use symbol="NoiseMeter" id="Calm"/>
      <use symbol="NoiseMeter" id="Alert"/>
      <use symbol="NoiseMeter" id="Loud"/>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 320px;
      height: 120px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 6px 10px;
      row-gap: 2px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
