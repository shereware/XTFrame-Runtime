<xt version="2">
  <head>
    <symbols src="../FocusDot.xt"/>
  </head>
  <body>
    <div id="Ground"/>
    <div id="Stage">
      <div id="Pair">
        <use symbol="FocusDot" id="Idle"/>
        <use symbol="FocusDot" id="Aimed"/>
      </div>
    </div>
  </body>
  <layout>
    body {
      position: relative;
      width: 120px;
      height: 60px;
    }
    #Ground {
      position: absolute;
      left: 0px;
      top: 0px;
      width: 100%;
      height: 100%;
    }
    #Stage {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 16px;
    }
    #Pair {
      display: flex;
      column-gap: 24px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-text-dim);
    }
    #Ground {
      background-color: var(--color-bg);
      opacity: 0.85;
    }
  </style>
</xt>
