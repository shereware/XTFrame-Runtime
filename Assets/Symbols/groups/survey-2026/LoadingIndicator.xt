<xt version="2">

  <symbol name="LoadingIndicator" requires="slots: label, tip">
    <ports>
      progress: number in
    </ports>
    <div id="Box" on:show="play(pulse, loop)">
      <div id="Head">
        <span id="Label"><slot name="label">Loading</slot></span>
        <span id="Percent" bind:text="format('{0}%', progress | clamp(0, 100) | round)"></span>
      </div>
      <div id="Track">
        <div id="Fill" bind:scale-x="progress | clamp(0, 100) | range(0, 100, 0, 1) | tween(0.3s, ease-out)"></div>
      </div>
      <span id="Tip"><slot name="tip">Tip text: one or two sentences shown while the next area loads.</slot></span>
    </div>
  </symbol>

  <layout>
    symbol(LoadingIndicator) {
      #Box {
        display: flex;
        flex-direction: column;
        row-gap: var(--space-2);
        width: 360px;
      }
      #Head {
        display: flex;
        justify-content: space-between;
      }
      #Track {
        position: relative;
        height: 1px;
      }
      #Fill {
        position: absolute;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        transform-origin: 0% 50%;
      }
    }
  </layout>
  <style>
    symbol(LoadingIndicator) {
      #Label {
        font-family: var(--font-body);
        font-size: var(--font-size-xs);
        text-transform: uppercase;
        letter-spacing: var(--letter-label);
        color: var(--color-text-label);
      }
      #Percent {
        font-family: var(--font-body);
        font-size: var(--font-size-caption);
        letter-spacing: 1px;
        color: var(--color-text-quiet);
      }
      #Track {
        background-color: var(--color-line);
      }
      #Fill {
        background-color: var(--color-accent);
      }
      #Tip {
        font-family: var(--font-body);
        font-style: italic;
        font-size: var(--font-size-s);
        line-height: 20px;
        color: var(--color-text-dim);
      }
    }
  </style>
  <timelines>
    symbol(LoadingIndicator) {
      @timeline pulse {
        #Label {
          0s {
            opacity: 1;
          }
          0.25s ease-in-out {
            opacity: 0.4;
          }
          0.5s ease-in-out {
            opacity: 1;
          }
        }
      }
    }
  </timelines>
</xt>
