<xt version="2">

  <symbol name="SaveSlot" variants="State=Filled|Empty" requires="states: Hover, Pressed, Focus, Disabled, Selected; slots: chapter, location, stamp">
    <ports>
      selected: bool in
      pressed: event out
    </ports>
    <button id="Box" bind:state.Selected="selected"
            on:hover="sound(ui_hover); play(hover-in)" on:leave="play(hover-out)"
            on:press="sound(ui_confirm); play(press)" on:click="emit(pressed)">
      <div id="Band"></div>
      <div id="Main">
        <span id="Chapter"><slot name="chapter">Chapter One · Chapter Title</slot></span>
        <span id="Location"><slot name="location">Location Name</slot></span>
      </div>
      <span id="Stamp"><slot name="stamp">2026-01-01 · 00:00</slot></span>
    </button>
  </symbol>

  <layout>
    symbol(SaveSlot) {
      #Box {
        position: relative;
        display: flex;
        align-items: center;
        width: 440px;
        height: 60px;
        column-gap: var(--space-3);
        padding: 0px var(--space-4);
      }
      #Band {
        position: absolute;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
      }
      #Main {
        position: relative;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        row-gap: 2px;
      }
      #Stamp {
        position: relative;
      }
      .v-State-Empty #Location {
        display: none;
      }
      .v-State-Empty #Stamp {
        display: none;
      }
    }
  </layout>
  <style>
    symbol(SaveSlot) {
      #Box {
        background-color: transparent;
        border-width: 0px 0px var(--rule-thin) 0px;
        border-color: var(--color-line-hairline);
      }
      #Band {
        background-image: var(--tex-band);
        background-size: 100% 100%;
        background-repeat: no-repeat;
        border-width: 0px 0px 0px var(--rule-thick);
        border-color: var(--color-band-edge);
        opacity: 0;
        transition: opacity var(--motion-normal) ease-out;
      }
      #Chapter {
        font-family: var(--font-display);
        font-size: var(--font-size-m);
        letter-spacing: 1px;
        color: var(--color-text-label);
        white-space: nowrap;
        transition: color var(--motion-normal) ease-out;
      }
      #Location {
        font-family: var(--font-body);
        font-size: var(--font-size-xs);
        text-transform: uppercase;
        letter-spacing: var(--letter-label);
        color: var(--color-text-quiet);
      }
      #Stamp {
        font-family: var(--font-body);
        font-size: var(--font-size-caption);
        letter-spacing: 1px;
        color: var(--color-text-dim);
        white-space: nowrap;
      }
      .v-State-Empty #Chapter {
        font-style: italic;
        color: var(--color-text-dim);
      }
      #Box:hover #Band {
        opacity: 1;
      }
      #Box:state(Selected) #Band {
        opacity: 1;
      }
      #Box:hover #Chapter {
        color: var(--color-text-strong);
      }
      #Box:state(Selected) #Chapter {
        color: var(--color-text-strong);
      }
      #Box:active #Chapter {
        color: var(--color-accent-pressed);
      }
      #Box:focus #Band {
        opacity: 1;
        border-color: var(--color-focus);
      }
      :disabled #Chapter {
        color: var(--color-disabled-text) !important;
      }
      :disabled #Band {
        opacity: 0 !important;
      }
    }
  </style>
  <timelines>
    symbol(SaveSlot) {
      @timeline hover-in {
        #Band {
          0s {
            transform: translateX(-12px);
          }
          0.16s ease-out {
            transform: translateX(0px);
          }
        }
      }
      @timeline hover-out {
        #Band {
          0s {
            transform: translateX(0px);
          }
          0.16s ease-in {
            transform: translateX(-12px);
          }
        }
      }
      @timeline press {
        #Box {
          0s {
            transform: translateX(2px);
          }
          0.14s ease-out {
            transform: translateX(0px);
          }
        }
      }
    }
  </timelines>
</xt>
