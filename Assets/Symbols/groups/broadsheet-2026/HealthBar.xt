<xt version="2">

  <symbol name="HealthBar" state-groups="Level: Normal|Low" requires="states: Normal, Low; slots: label">
    <ports>
      hp: number in
      hp_max: number in
      hit: event in
    </ports>
    <div id="Box"
         bind:state.Normal="hp | ge(25%)" bind:state.Low="hp | lt(25%)" on:port(hit)="play(hit)">
      <div id="Head">
        <span id="Label"><slot name="label">HP</slot></span>
        <span id="Value" bind:text="format('{0} / {1}', hp, hp_max)"></span>
      </div>
      <div id="Track">
        <div id="Fill" bind:scale-x="hp | clamp(0, hp_max) | range(0, hp_max, 0, 1) | tween(0.3s, ease-out)"></div>
      </div>
    </div>
  </symbol>

  <layout>
    symbol(HealthBar) {
      #Box {
        display: flex;
        flex-direction: column;
        row-gap: var(--space-1);
        width: 280px;
      }
      #Head {
        display: flex;
        justify-content: space-between;
      }
      #Track {
        height: 12px;
        padding: 2px;
      }
      #Fill {
        width: 100%;
        height: 6px;
        transform-origin: 0% 50%;
      }
    }
  </layout>
  <style>
    symbol(HealthBar) {
      #Box {
        font-family: var(--font-body);
        font-size: var(--font-size-s);
        color: var(--color-text);
      }
      #Label {
        font-family: var(--font-display);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: var(--letter-display);
      }
      #Value {
        color: var(--color-text-dim);
      }
      #Track {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        background-color: var(--color-track);
        background-image: var(--tex-hatch);
        background-repeat: repeat;
        background-size: 8px 8px;
      }
      #Fill {
        background-color: var(--color-accent);
        transition: background-color var(--motion-normal) linear;
      }
      #Box:state(Normal) #Fill {
        background-color: var(--color-accent);
      }
      #Box:state(Low) #Fill {
        background-color: var(--color-danger);
      }
      #Box:state(Low) #Value {
        color: var(--color-danger);
      }
    }
  </style>
  <timelines>
    symbol(HealthBar) {
      @timeline hit {
        #Box {
          0s {
            opacity: 1;
          }
          0.1s linear {
            opacity: 0.4;
          }
          0.2s linear {
            opacity: 1;
          }
        }
      }
    }
  </timelines>
</xt>
