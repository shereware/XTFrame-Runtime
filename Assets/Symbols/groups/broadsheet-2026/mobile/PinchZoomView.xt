<xt>
  <head>
    <!-- PinchZoomView: standard mobile symbol (docs/design/23-host-integration.md 23.11.2,
         30-ui-project.md 30.4). See ../README.md.
         Style: Broadsheet (docs/design/47-symbol-visual-style.md).
         A clipping container whose `content` slot is scaled by `scale`, clamped to min..max.
         A two-finger pinch emits `pinch` and a double tap emits `reset`; the gesture scale is
         not an event value, so the host turns the pinch into a new `scale` (and resets it to 1
         on `reset`). `zoom` pulses the frame when the host applies a step. -->
    <symbol name="PinchZoomView" requires="states: Zoomed; slots: content">
      <div id="Box" port:scale="number in" port:min="number in" port:max="number in"
           port:pinch="event out" port:reset="event out"
           bind:state.Zoomed="scale | gt(1)"
           on:gesture(pinch)="emit(pinch)"
           on:gesture(doubletap)="sound(ui_select); emit(reset); play(zoom)">
        <div id="Stage" bind:scale-x="scale | clamp(min, max)" bind:scale-y="scale | clamp(min, max)">
          <slot name="content"><div id="Sample"><div id="SampleA"></div><div id="SampleB"></div></div></slot>
        </div>
        <div id="Badge"><span id="BadgeValue" bind:text="scale | clamp(min, max) | scale(100) | round"></span><span id="BadgeUnit">%</span></div>
      </div>
    </symbol>
    <style>
      symbol(PinchZoomView) {
        /* A drawing board: hatched sunken face in a double frame (1px border, 1px outline 2px out). */
        #Box {
          position: relative;
          display: flex;
          align-items: center;
          justify-content: center;
          width: 320px;
          height: 240px;
          overflow: hidden;
          border-width: var(--rule-thin);
          border-color: var(--color-border);
          outline: var(--rule-thin) solid var(--color-border);
          outline-offset: 2px;
          background-color: var(--color-surface-sunken);
          background-image: var(--tex-hatch);
          background-repeat: repeat;
          background-size: 8px 8px;
          font-family: var(--font-body);
          font-size: var(--font-size-xs);
        }
        #Stage { display: flex; align-items: center; justify-content: center; }
        #Sample { display: flex; column-gap: var(--space-2); }
        #SampleA { width: 64px; height: 64px; background-color: var(--color-accent); }
        #SampleB { width: 64px; height: 64px; background-color: var(--color-success); }
        #Badge {
          position: absolute;
          right: var(--space-2);
          top: var(--space-2);
          padding: 2px var(--space-2);
          border-width: var(--rule-thin);
          border-style: dashed;
          border-color: var(--color-border);
          background-color: var(--color-surface);
          background-image: var(--tex-grain);
          background-repeat: repeat;
          background-size: 128px 128px;
          color: var(--color-text-dim);
          display: flex;
        }
        #Box:state(Zoomed) { border-width: var(--rule-thick); }
        #Box:state(Zoomed) #Badge { color: var(--color-text); }
        @timeline zoom {
          #Badge { 0s { transform: translateY(1px) } 0.2s ease-out { transform: translateY(0px) } }
        }
      }
    </style>
  </head>
</xt>
