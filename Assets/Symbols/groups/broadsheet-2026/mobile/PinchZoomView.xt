<xt version="2">

  <symbol name="PinchZoomView" requires="states: Zoomed; slots: content">
    <ports>
      scale: number in
      min: number in
      max: number in
      pinch: event out
      reset: event out
    </ports>
    <div id="Box"
         bind:state.Zoomed="scale | gt(1)"
         on:gesture(pinch)="emit(pinch)"
         on:gesture(doubletap)="sound(ui_select); emit(reset); play(zoom)">
      <div id="Stage" bind:scale-x="scale | clamp(min, max)" bind:scale-y="scale | clamp(min, max)">
        <slot name="content"><div id="Sample"><div id="SampleA"></div><div id="SampleB"></div></div></slot>
      </div>
      <div id="Badge"><span id="BadgeValue" bind:text="scale | clamp(min, max) | scale(100) | round"></span><span id="BadgeUnit">%</span></div>
    </div>
  </symbol>

  <layout>
    symbol(PinchZoomView) {
      #Box {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 320px;
        height: 240px;
        overflow: hidden;
      }
      #Stage {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #Sample {
        display: flex;
        column-gap: var(--space-2);
      }
      #SampleA {
        width: 64px;
        height: 64px;
      }
      #SampleB {
        width: 64px;
        height: 64px;
      }
      #Badge {
        position: absolute;
        right: var(--space-2);
        top: var(--space-2);
        padding: 2px var(--space-2);
        display: flex;
      }
    }
  </layout>
  <style>
    symbol(PinchZoomView) {
      /* A drawing board: hatched sunken face in a double frame (1px border, 1px outline 2px out). */
      #Box {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        outline: var(--rule-thin) solid var(--color-border);
        outline-offset: 2px;
        background-color: var(--color-surface-sunken);
        background-image: var(--tex-hatch);
        background-repeat: repeat;
        background-size: 8px 8px;
        font-family: var(--font-body);
        font-size: var(--font-size-xs);
      }
      #SampleA {
        background-color: var(--color-accent);
      }
      #SampleB {
        background-color: var(--color-success);
      }
      #Badge {
        border-width: var(--rule-thin);
        border-style: dashed;
        border-color: var(--color-border);
        background-color: var(--color-surface);
        background-image: var(--tex-grain);
        background-repeat: repeat;
        background-size: 128px 128px;
        color: var(--color-text-dim);
      }
      #Box:state(Zoomed) {
        border-width: var(--rule-thick);
      }
      #Box:state(Zoomed) #Badge {
        color: var(--color-text);
      }
    }
  </style>
  <timelines>
    symbol(PinchZoomView) {
      @timeline zoom {
        #Badge {
          0s {
            transform: translateY(1px);
          }
          0.2s ease-out {
            transform: translateY(0px);
          }
        }
      }
    }
  </timelines>
</xt>
