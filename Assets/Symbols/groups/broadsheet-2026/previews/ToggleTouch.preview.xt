<xt>
  <head>
    <!-- T-241: preview of the ToggleTouch standard mobile symbol (golden states and thumbnail; T-499: moved into the group). -->
    <link href="../tokens.xts"/>
    <link rel="symbols" href="../mobile/ToggleTouch.xt"/>
    <style>
      body {
        width: 340px;
        height: 170px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        column-gap: 16px;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="ToggleTouch" id="Sound" slot:label="Sound"/>
    <use symbol="ToggleTouch" id="Music" slot:label="Music"/>
    <use symbol="ToggleTouch" id="Off" disabled="true" slot:label="Voice chat"/>
  </body>
</xt>
