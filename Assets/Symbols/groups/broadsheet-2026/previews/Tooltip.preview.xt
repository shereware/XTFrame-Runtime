<xt>
  <head>
    <!-- T-198: preview of the Tooltip standard symbol (golden states and thumbnail; T-499: moved into the group). -->
    <link href="../tokens.xts"/>
    <link rel="symbols" href="../Tooltip.xt"/>
    <style>
      body {
        width: 320px;
        height: 120px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="Tooltip" id="Help" slot:tip="Hold to sprint"/>
  </body>
</xt>
