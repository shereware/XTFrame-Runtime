<xt>
  <head>
    <!-- T-198: preview of the Toggle standard symbol (golden states and thumbnail; T-499: moved into the group). -->
    <link href="../tokens.xts"/>
    <link rel="symbols" href="../Toggle.xt"/>
    <style>
      body {
        width: 260px;
        height: 140px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="Toggle" id="Sound" slot:label="Sound"/>
    <use symbol="Toggle" id="Music" slot:label="Music"/>
    <use symbol="Toggle" id="Off" disabled="true" slot:label="Voice chat"/>
  </body>
</xt>
