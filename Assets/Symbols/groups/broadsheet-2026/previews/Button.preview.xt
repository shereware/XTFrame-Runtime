<xt>
  <head>
    <!-- T-198: preview of the Button standard symbol (golden states and thumbnail; T-499: moved into the group). -->
    <link href="../tokens.xts"/>
    <link rel="symbols" href="../Button.xt"/>
    <style>
      body {
        width: 320px;
        height: 200px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="Button" id="Primary" slot:label="Play"/>
    <use symbol="Button" id="Secondary" variant:Kind="Secondary" slot:label="Options"/>
    <use symbol="Button" id="Ghost" variant:Kind="Ghost" variant:Size="S" slot:label="Credits"/>
    <use symbol="Button" id="Off" variant:Size="S" disabled="true" slot:label="Locked"/>
  </body>
</xt>
