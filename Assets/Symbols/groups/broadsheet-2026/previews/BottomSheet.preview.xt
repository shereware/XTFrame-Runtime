<xt version="2">
  <head>
    <symbols src="../mobile/BottomSheet.xt"/>
  </head>

  <body>
    <use symbol="BottomSheet" id="Sheet" slot:title="Settings"/>
  </body>

  <layout>
    body {
      width: 360px;
      height: 420px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      column-gap: 16px;
      row-gap: 12px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-bg);
    }
  </style>
</xt>
