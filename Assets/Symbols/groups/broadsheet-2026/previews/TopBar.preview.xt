<xt version="2">
  <head>
    <symbols src="../mobile/TopBar.xt"/>
  </head>

  <body>
    <use symbol="TopBar" id="Top" slot:title="Mission 3"/>
  </body>

  <layout>
    body {
      width: 420px;
      height: 130px;
      padding: 16px;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      column-gap: 16px;
      row-gap: 12px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-bg);
    }
  </style>
</xt>
