<xt version="2">
  <head>
    <symbols src="../Stepper.xt"/>
  </head>

  <body>
    <use symbol="Stepper" id="Count" slot:label="Bots"/>
  </body>

  <layout>
    body {
      width: 300px;
      height: 90px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      row-gap: 12px;
    }
  </layout>
  <style src="../tokens.xts"/>
  <style>
    body {
      background-color: var(--color-bg);
    }
  </style>
</xt>
