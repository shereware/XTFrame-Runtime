<xt>
  <head>
    <!-- T-198: preview of the Modal standard symbol (golden states and thumbnail; T-499: moved into the group). -->
    <link href="../../tokens-night.xts"/>
    <link rel="symbols" href="../../Modal.xt"/>
    <link rel="symbols" href="../../Button.xt"/>
    <style>
      body {
        width: 480px;
        height: 300px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
      body { position: relative; padding: 0px; }
    </style>
  </head>
  <body>
    <use symbol="Modal" id="Confirm" slot:title="Quit to menu">
      <slot name="body"><span id="Warn">Unsaved progress will be lost</span></slot>
      <slot name="actions">
        <use symbol="Button" id="Cancel" variant:Kind="Secondary" variant:Size="S" slot:label="Cancel"/>
        <use symbol="Button" id="Quit" variant:Size="S" slot:label="Quit"/>
      </slot>
    </use>
  </body>
</xt>
