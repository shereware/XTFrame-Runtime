<xt>
  <head>
    <!-- T-241: preview of the SliderTouch standard mobile symbol (golden states and thumbnail; T-499: moved into the group). -->
    <link href="../tokens.xts"/>
    <link rel="symbols" href="../mobile/SliderTouch.xt"/>
    <style>
      body {
        width: 360px;
        height: 130px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        column-gap: 16px;
        row-gap: 12px;
        background-color: var(--color-bg);
      }
    </style>
  </head>
  <body>
    <use symbol="SliderTouch" id="Volume" slot:label="Volume"/>
  </body>
</xt>
