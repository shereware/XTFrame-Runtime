<xt version="2">

  <symbol name="RadioGroup" requires="states: Hover, Focus, Selected, Disabled">
    <ports>
      options: list<struct{label: string}> in
      value: number in
      select: event out
    </ports>
    <div id="Box">
      <repeat port="options" id="Option">
        <div id="Row" bind:state.Selected="index | eq(value)" on:press="sound(ui_select); emit(select)">
          <div id="Dot"><div id="Pip"></div></div>
          <span id="Text" bind:text="item(label)"></span>
        </div>
      </repeat>
    </div>
  </symbol>

  <layout>
    symbol(RadioGroup) {
      #Box {
        display: flex;
        flex-direction: column;
        width: 220px;
      }
      #Option {
        display: flex;
        flex-direction: column;
        row-gap: var(--space-1);
      }
      #Row {
        display: flex;
        align-items: center;
        column-gap: var(--space-2);
        padding: var(--space-1) var(--space-2);
      }
      #Dot {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
      }
      #Pip {
        width: 10px;
        height: 10px;
      }
      #Row:focus {
        transform: rotate(-1.5deg);
      }
      :disabled #Row {
        transform: none !important;
      }
    }
  </layout>
  <style>
    symbol(RadioGroup) {
      #Box {
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: var(--font-size-m);
      }
      #Row {
        transition: transform var(--motion-fast) ease-out;
      }
      #Text {
        white-space: nowrap;
      }
      #Dot {
        border-width: var(--rule-thin);
        border-color: var(--color-border);
        border-radius: var(--radius-full);
        background-color: var(--color-surface);
      }
      #Pip {
        border-radius: var(--radius-full);
        background-color: var(--color-accent);
        opacity: 0;
      }
      #Row:hover #Dot {
        background-color: var(--color-surface-sunken);
      }
      #Row:focus {
        outline: var(--focus-w) solid var(--color-focus);
        outline-offset: 2px;
      }
      #Row:state(Selected) #Pip {
        opacity: 1;
      }
      :disabled #Row {
        color: var(--color-disabled-text);
        outline: none !important;
      }
      :disabled #Dot {
        border-color: var(--color-disabled-text) !important;
        background-color: var(--color-disabled-bg) !important;
        background-image: var(--tex-hatch) !important;
        background-repeat: repeat;
        background-size: 8px 8px;
      }
      :disabled #Pip {
        background-color: var(--color-disabled-text) !important;
      }
    }
  </style>
</xt>
