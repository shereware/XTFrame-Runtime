<xt>
  <head>
    <!-- InputGlyph: standard symbol (docs/design/30-ui-project.md 30.4). See README.md.
         Style: Broadsheet (docs/design/47-symbol-visual-style.md).
         The key cap shows the host's glyph for an input action (27.7, IGlyphProvider); fill the
         `glyph` slot with `<glyph key="<action>"/>` to pick the action. -->
    <symbol name="InputGlyph" requires="slots: glyph, label">
      <div id="Box">
        <div id="Cap"><span id="Key"><slot name="glyph"><glyph key="jump"/></slot></span></div>
        <span id="Label"><slot name="label">Jump</slot></span>
      </div>
    </symbol>
    <style>
      symbol(InputGlyph) {
        #Box {
          display: flex;
          align-items: center;
          column-gap: var(--space-2);
          font-family: var(--font-body);
          font-size: var(--font-size-s);
          color: var(--color-text);
        }
        /* A typewriter key: paper face, thin ink top / left, thick letterpress right / bottom. */
        #Cap {
          display: flex;
          align-items: center;
          justify-content: center;
          min-width: 28px;
          height: 28px;
          padding: 0px var(--space-1);
          border-width: var(--rule-thin) var(--rule-thick) var(--rule-thick) var(--rule-thin);
          border-top-color: var(--color-border);
          border-left-color: var(--color-border);
          border-right-color: var(--color-shadow);
          border-bottom-color: var(--color-shadow);
          background-color: var(--color-surface);
        }
        #Key {
          color: var(--color-text);
          font-family: var(--font-display);
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: var(--letter-display);
          white-space: nowrap;
        }
        #Label { white-space: nowrap; }
      }
    </style>
  </head>
</xt>
