<xt version="2">

  <symbol name="Hotbar" requires="states: Hover, Selected, Empty">
    <ports>
      slots: list<struct{key: string, count: number, empty: bool}> in
      selected: number in
      select: event out
    </ports>
    <div id="Box">
      <repeat port="slots" id="Slot">
        <div id="Cell" bind:state.Selected="index | eq(selected)" bind:state.Empty="item(empty)"
             on:press="sound(ui_select); emit(select)">
          <div id="Icon"></div>
          <span id="Key" bind:text="item(key)"></span>
          <span id="Count" bind:text="item(count)"></span>
        </div>
      </repeat>
    </div>
  </symbol>

  <layout>
    symbol(Hotbar) {
      #Box {
        display: flex;
      }
      #Slot {
        display: flex;
      }
      #Cell {
        position: relative;
        flex-shrink: 0;
        width: 52px;
        height: 52px;
      }
      #Icon {
        position: absolute;
        left: 12px;
        top: 12px;
        width: 24px;
        height: 24px;
      }
      #Key {
        position: absolute;
        left: 4px;
        top: 2px;
      }
      #Count {
        position: absolute;
        right: 4px;
        bottom: 2px;
      }
      #Cell:focus {
        transform: rotate(-1.5deg);
      }
    }
  </layout>
  <style>
    symbol(Hotbar) {
      #Box {
        font-family: var(--font-body);
        color: var(--color-text);
      }
      #Slot {
        border-width: var(--rule-thin) 0px var(--rule-thin) var(--rule-thin);
        border-color: var(--color-border);
      }
      #Cell {
        border-width: 0px var(--rule-thin) 0px 0px;
        border-color: var(--color-border);
        background-color: var(--color-surface);
        color: var(--color-text);
        transition: background-color var(--motion-fast) linear, transform var(--motion-fast) ease-out;
      }
      #Icon {
        background-color: var(--color-text-dim);
      }
      #Key {
        color: var(--color-text-dim);
        font-family: var(--font-display);
        font-size: var(--font-size-xs);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: var(--letter-display);
      }
      #Count {
        font-size: var(--font-size-xs);
        font-weight: 700;
      }
      #Cell:state(Empty) {
        background-color: var(--color-surface-sunken);
        background-image: var(--tex-dots);
        background-repeat: repeat;
        background-size: 4px 4px;
      }
      #Cell:hover {
        background-color: var(--color-accent);
        background-image: none;
        color: var(--color-text-on-accent);
      }
      #Cell:hover #Icon {
        background-color: var(--color-text-on-accent);
      }
      #Cell:hover #Key {
        color: var(--color-text-on-accent);
      }
      #Cell:state(Selected) {
        background-color: var(--color-accent);
        background-image: none;
        color: var(--color-text-on-accent);
      }
      #Cell:state(Selected) #Icon {
        background-color: var(--color-text-on-accent);
      }
      #Cell:state(Selected) #Key {
        color: var(--color-text-on-accent);
      }
      #Cell:state(Selected):hover {
        background-color: var(--color-accent-hover);
      }
      #Cell:focus {
        outline: var(--focus-w) solid var(--color-focus);
        outline-offset: 2px;
      }
      #Cell:state(Empty) #Icon {
        opacity: 0;
      }
      #Cell:state(Empty) #Count {
        opacity: 0;
      }
    }
  </style>
</xt>
