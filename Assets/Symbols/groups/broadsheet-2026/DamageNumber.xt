<xt>
  <head>
    <!-- DamageNumber: standard symbol (docs/design/30-ui-project.md 30.4). See README.md.
         Style: Broadsheet (docs/design/47-symbol-visual-style.md).
         A field that pops a number per hit: the host sets `amount`, `crit` and the offset `x` / `y`
         from the field's top-left, then fires `hit`; each hit spawns a DamagePop there (27.2.3
         `spawn()`), which keeps the values it was spawned with, plays `pop` and is recycled after
         0.45 s. DamageNumberList below is the list-port alternative (a `<repeat>` whose entries
         enter and exit with item-enter / item-exit). -->
    <symbol name="DamageNumber" requires="states: Crit">
      <div id="Box" port:amount="number in" port:crit="bool in" port:x="number in" port:y="number in"
           port:hit="event in" on:port(hit)="spawn(DamagePop, at=#Origin, lifetime=0.45s, timeline=pop)">
        <div id="Origin"></div>
      </div>
    </symbol>
    <!-- One popped number, spawned by DamageNumber (its bindings read DamageNumber's ports). -->
    <symbol name="DamagePop">
      <div id="Hit" class="dmg-hit" bind:left="x" bind:top="y" bind:state.Crit="crit">
        <span id="Amount" class="dmg-amount" bind:text="amount | round | thousands"></span>
      </div>
    </symbol>
    <!-- The list-port alternative: numbers are entries of `numbers` (listInsert shows one,
         listRemove fades it out and removes it). -->
    <symbol name="DamageNumberList" requires="states: Crit">
      <div id="Box" port:numbers="list&lt;struct{amount: number, x: number, y: number, crit: bool}&gt; in">
        <repeat port="numbers" id="Pop" item-enter="play(pop-in)" item-exit="play(pop-out) then remove">
          <div id="Hit" class="dmg-hit" bind:left="item(x)" bind:top="item(y)" bind:state.Crit="item(crit)">
            <span id="Amount" class="dmg-amount" bind:text="item(amount) | round | thousands"></span>
          </div>
        </repeat>
      </div>
    </symbol>
    <style>
      symbol(DamageNumber) {
        #Box { position: relative; width: 320px; height: 200px; pointer-events: none; font-family: var(--font-display); }
        #Origin { position: absolute; left: 0px; top: 0px; width: 0px; height: 0px; }
        /* The spawned DamagePop elements are inside the instance: classes reach them. */
        .dmg-hit { position: absolute; left: 0px; top: 0px; padding: 0px var(--space-1); }
        .dmg-amount {
          color: var(--color-text);
          font-family: var(--font-display);
          font-size: var(--font-size-l);
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: var(--letter-display);
          white-space: nowrap;
        }
        /* No stamp outline: a spawned absolute box has no shrink-to-fit width, so an outline would
           draw as a thin bar. The crit is the red ink and the larger size. */
        .dmg-hit:state(Crit) .dmg-amount { color: var(--color-danger); font-size: var(--font-size-xl); }
      }
      symbol(DamagePop) {
        @timeline pop {
          #Hit {
            0s { opacity: 0; transform: translateY(8px) }
            0.12s ease-out { opacity: 1; transform: translateY(0px) }
            0.2s { opacity: 1; transform: translateY(-4px) }
            0.45s ease-in { opacity: 0; transform: translateY(-24px) }
          }
        }
      }
      symbol(DamageNumberList) {
        #Box { position: relative; width: 320px; height: 200px; pointer-events: none; font-family: var(--font-display); }
        #Pop { position: relative; }
        .dmg-hit { position: absolute; left: 0px; top: 0px; padding: 0px var(--space-1); }
        .dmg-amount {
          color: var(--color-text);
          font-family: var(--font-display);
          font-size: var(--font-size-l);
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: var(--letter-display);
          white-space: nowrap;
        }
        /* No stamp outline: a spawned absolute box has no shrink-to-fit width, so an outline would
           draw as a thin bar. The crit is the red ink and the larger size. */
        .dmg-hit:state(Crit) .dmg-amount { color: var(--color-danger); font-size: var(--font-size-xl); }
        @timeline pop-in {
          #Hit { 0s { opacity: 0; transform: translateY(8px) } 0.15s ease-out { opacity: 1; transform: translateY(0px) } }
        }
        @timeline pop-out {
          #Hit { 0s { opacity: 1; transform: translateY(0px) } 0.3s ease-in { opacity: 0; transform: translateY(-24px) } }
        }
      }
    </style>
  </head>
</xt>
