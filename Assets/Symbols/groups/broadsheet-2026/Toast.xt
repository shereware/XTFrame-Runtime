<xt version="2">

  <symbol name="Toast" requires="states: Hover">
    <ports>
      toasts: list<struct{title: string, text: string}> in
      dismiss: event out
    </ports>
    <div id="Box">
      <repeat port="toasts" id="Queue" item-enter="play(item-in)" item-exit="play(item-out) then remove">
        <div id="Card" on:click="emit(dismiss)">
          <span id="Mark">!</span>
          <div id="Stripe"></div>
          <div id="Copy">
            <span id="Title" bind:text="item(title)"></span>
            <span id="Text" bind:text="item(text)"></span>
          </div>
        </div>
      </repeat>
    </div>
  </symbol>

  <layout>
    symbol(Toast) {
      #Box {
        width: 320px;
      }
      #Queue {
        display: flex;
        flex-direction: column;
        row-gap: var(--space-2);
      }
      #Card {
        display: flex;
        column-gap: var(--space-3);
        padding: var(--space-3);
      }
      #Mark {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
      }
      #Stripe {
        width: var(--rule-thin);
      }
      #Copy {
        display: flex;
        flex-direction: column;
        row-gap: var(--space-1);
      }
    }
  </layout>
  <style>
    symbol(Toast) {
      #Box {
        font-family: var(--font-body);
      }
      #Card {
        border-width: var(--rule-thin);
        border-style: dashed;
        border-color: var(--color-border);
        background-color: var(--color-surface);
        background-image: var(--tex-grain);
        background-repeat: repeat;
        background-size: 128px 128px;
      }
      #Card:hover {
        background-color: var(--color-surface-sunken);
        background-image: none;
      }
      #Mark {
        color: var(--color-text);
        font-family: var(--font-display);
        font-size: var(--font-size-xl);
        font-weight: 900;
        white-space: nowrap;
      }
      #Stripe {
        background-color: var(--color-border);
      }
      #Title {
        color: var(--color-text);
        font-family: var(--font-display);
        font-size: var(--font-size-m);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: var(--letter-display);
        white-space: nowrap;
      }
      #Text {
        color: var(--color-text-dim);
        font-size: var(--font-size-s);
      }
    }
  </style>
  <timelines>
    symbol(Toast) {
      @timeline item-in {
        #Card {
          0s {
            opacity: 0;
            transform: translateX(24px);
          }
          0.25s ease-out {
            opacity: 1;
            transform: translateX(0px);
          }
        }
      }
      @timeline item-out {
        #Card {
          0s {
            opacity: 1;
            transform: translateX(0px);
          }
          0.2s ease-in {
            opacity: 0;
            transform: translateX(24px);
          }
        }
      }
    }
  </timelines>
</xt>
