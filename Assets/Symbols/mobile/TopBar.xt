<xt>
  <head>
    <!-- TopBar: standard mobile symbol (docs/design/23-host-integration.md 23.11.2,
         30-ui-project.md 30.4). See ../README.md.
         A full-width top bar that clears the status bar / notch (its top padding is the
         top safe-area inset, `1safe-top`). Three slots: `left` (e.g. a back or pause button),
         `title` (centred) and `right` (e.g. counters). `intro` slides it in from the top. -->
    <symbol name="TopBar" requires="slots: title, left, right">
      <div id="Box">
        <div id="Bar">
          <div id="Left"><slot name="left"></slot></div>
          <span id="Title"><slot name="title">Title</slot></span>
          <div id="Right"><slot name="right"></slot></div>
        </div>
      </div>
    </symbol>
    <style>
      symbol(TopBar) {
        #Box {
          display: flex;
          flex-direction: column;
          flex-grow: 1;
          padding-top: 1safe-top;
          background-color: var(--color-surface);
          border-width: 0px 0px var(--border-w) 0px;
          border-color: var(--color-border);
          font-family: var(--font-family);
          color: var(--color-text);
        }
        #Bar {
          display: flex;
          align-items: center;
          column-gap: var(--space-3);
          min-height: 56px;
          padding: 0px var(--space-3);
        }
        #Left, #Right {
          display: flex;
          align-items: center;
          column-gap: var(--space-2);
          min-width: var(--touch-min);
          min-height: var(--touch-min);
        }
        #Title {
          flex-grow: 1;
          text-align: center;
          font-size: var(--font-size-l);
          font-weight: 600;
          white-space: nowrap;
        }
        @timeline intro {
          #Bar { 0s { transform: translateY(-56px); opacity: 0 } 0.25s ease-out { transform: translateY(0px); opacity: 1 } }
        }
      }
    </style>
  </head>
</xt>
