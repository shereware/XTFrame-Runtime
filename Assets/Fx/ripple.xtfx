// XTFrame built-in shader example (Docs/design/18-effects.md §18.7, §18.16.3): rippling water.
name: Ripple
blurb: Rippling water distortion
param amplitude float 4 [0, 32]
param speed float 1.5 [0, 10]
param tint color #ffffff
fallback: blur(2px)
expand: 8px
---
float4 xtMain(XtInput i)
{
    float2 uv = i.uv + sin(i.uv.yx * 40 + xtTime * speed) * (amplitude * i.texelSize);
    return xtSample(uv) * tint;
}
