*.actual.txt

# T-357: derived per-project caches (offline UI thumbnails, 40 §40.3.3)
.xtcache/

# Qt SDKs live beside the other SDKs but are never committed (45 §45.3); only the README is
# (Code/SDKs/Qt/README.md: auto-detection, XT_QT_DIR / XT_QT512_DIR / XT_QT6_DIR; T-442).
/Code/SDKs/Qt/*
!/Code/SDKs/Qt/README.md
