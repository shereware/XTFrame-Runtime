# Embeds the WGSL shaders of src/shaders into one generated header (T-438): one
# `inline constexpr const char* k_<stem>` raw string per file. Run by CMakeLists.txt at build time:
#   cmake -DOUT=<header> -DSOURCES=<a.wgsl|b.wgsl|...> -P embed_wgsl.cmake
string(REPLACE "|" ";" files "${SOURCES}")
set(content "// Generated by Code/Runtime/wgpu/embed_wgsl.cmake from src/shaders/*.wgsl -- do not edit.\n#pragma once\n\nnamespace xt::wgpu::shaders {\n\n")
foreach(f IN LISTS files)
  get_filename_component(stem "${f}" NAME_WE)
  string(MAKE_C_IDENTIFIER "${stem}" id)
  file(READ "${f}" text)
  string(APPEND content "inline constexpr const char* k_${id} = R\"xtwgsl(${text})xtwgsl\";\n\n")
endforeach()
string(APPEND content "}  // namespace xt::wgpu::shaders\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${content}")
