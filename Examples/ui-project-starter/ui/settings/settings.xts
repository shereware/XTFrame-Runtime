/* Settings layout: a centred panel (overlay: dim, no blur, per contracts/motion-spec.yaml).
   Colors come from tokens only. */

body {
  width: 100vw;
  height: 100vh;
  background-color: var(--color-bg);
  font-family: var(--font-family);
}

#Screen {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

#Panel {
  width: 960px;
  display: flex;
  flex-direction: column;
  row-gap: var(--space-4);
  padding: var(--space-6);
  border-width: var(--border-w);
  border-color: var(--color-border);
  border-radius: var(--radius-l);
  background-color: var(--color-surface);
}

#Header {
  display: flex;
  flex-direction: column;
  row-gap: var(--space-3);
}

#Heading {
  color: var(--color-text);
  font-size: var(--font-size-xl);
  font-weight: 700;
}

#Columns {
  display: flex;
  column-gap: 48px;
}

#ColumnA,
#ColumnB {
  display: flex;
  flex-direction: column;
  row-gap: var(--space-4);
}

#DifficultyRow {
  display: flex;
  align-items: center;
  column-gap: var(--space-2);
}

#DifficultyLabel {
  color: var(--color-text-dim);
  font-size: var(--font-size-s);
}

#Footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

#Divider {
  height: 1px;
  background-color: var(--color-border);
}

#Hints,
#Actions {
  display: flex;
  align-items: center;
  column-gap: var(--space-4);
}
