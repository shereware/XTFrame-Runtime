body {
  width: 100vw;
  height: 100vh;
}
#Screen {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}
#TopLeft {
  position: absolute;
  left: var(--safe-x);
  top: var(--safe-y);
  display: flex;
  flex-direction: column;
  row-gap: var(--space-3);
}
#TopCenter {
  position: absolute;
  left: calc(50% - 180px);
  top: var(--safe-y);
}
#TopRight {
  position: absolute;
  right: var(--safe-x);
  top: var(--safe-y);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  row-gap: var(--space-3);
}
#Right {
  position: absolute;
  right: var(--safe-x);
  top: 50%;
}
#Center {
  position: absolute;
  left: calc(50% - 40px);
  top: calc(50% - 40px);
}
#Damage {
  position: absolute;
  left: calc(50% - 160px);
  top: calc(42.31% - 84.62px);
  width: 320px;
  height: 200px;
}
#LowCenter {
  anchor: left bottom;
  offset: 288px 142px;
  width: 640px;
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: var(--space-3);
}
#BottomCenter {
  position: absolute;
  left: 36.09%;
  bottom: var(--safe-y);
}
#BottomRight {
  position: absolute;
  right: var(--safe-x);
  bottom: var(--safe-y);
  display: flex;
  justify-content: flex-end;
  column-gap: var(--space-4);
}
.ability {
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: var(--space-2);
}
