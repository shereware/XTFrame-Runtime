/* Starter UI Project: "Night desk" theme (id "dark"). Only token declarations; activating the theme (xtframe-pack
   lists it in the manifest's `themes[]`, the host calls loadThemes / Context::setTheme("dark"))
   swaps these values without recompiling. */
:root {
  --color-bg: #262320;
  --color-surface: #302c27;
  --color-surface-raised: #38342e;
  --color-surface-sunken: #1b1916;
  --color-border: #d9d3c4;
  --color-border-strong: #d9d3c4;
  --color-text: #d9d3c4;
  --color-text-dim: #9a9386;
  --color-text-on-accent: #262320;
  --color-accent: #d9d3c4;
  --color-accent-hover: #9a9386;
  --color-accent-pressed: #1b1916;
  --color-focus: #d7493b;
  --color-disabled-bg: #1b1916;
  --color-disabled-text: #5e5950;
  --color-danger: #d7493b;
  --color-warning: #c9a24a;
  --color-success: #7fa877;
  --color-info: #8fb0cf;
  --color-scrim: #000000cc;
  --color-track: #1b1916;
  --color-shadow: #9a9386;
}
