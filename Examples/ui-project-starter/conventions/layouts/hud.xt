<xt version="2">

  <body>
    <div id="Screen">
      <div id="TopLeft" class="anchor"><span id="TopLeftGuide" class="guide">TopLeft</span></div>
      <div id="TopCenter" class="anchor"><span id="TopCenterGuide" class="guide">TopCenter</span></div>
      <div id="TopRight" class="anchor"><span id="TopRightGuide" class="guide">TopRight</span></div>
      <div id="Center" class="anchor"><span id="CenterGuide" class="guide">Center</span></div>
      <div id="LowCenter" class="anchor"><span id="LowCenterGuide" class="guide">LowCenter</span></div>
      <div id="BottomLeft" class="anchor"><span id="BottomLeftGuide" class="guide">BottomLeft</span></div>
      <div id="BottomCenter" class="anchor"><span id="BottomCenterGuide" class="guide">BottomCenter</span></div>
      <div id="BottomRight" class="anchor"><span id="BottomRightGuide" class="guide">BottomRight</span></div>
    </div>
  </body>

  <layout>
    body {
      width: 100vw;
      height: 100vh;
    }
    #Screen {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }
    .anchor {
      position: absolute;
      display: flex;
    }
    .guide {
      padding: var(--space-1);
    }
    #TopLeft {
      left: var(--safe-x);
      top: var(--safe-y);
      width: 300px;
      height: 120px;
    }
    #TopCenter {
      left: 460px;
      top: var(--safe-y);
      width: 360px;
      height: 40px;
    }
    #TopRight {
      right: var(--safe-x);
      top: var(--safe-y);
      width: 200px;
      height: 200px;
    }
    #Center {
      left: 600px;
      top: 320px;
      width: 80px;
      height: 80px;
    }
    #LowCenter {
      left: 320px;
      top: 500px;
      width: 640px;
      height: 90px;
    }
    #BottomLeft {
      left: var(--safe-x);
      bottom: var(--safe-y);
      width: 240px;
      height: 80px;
    }
    #BottomCenter {
      left: 462px;
      bottom: var(--safe-y);
      width: 356px;
      height: 64px;
    }
    #BottomRight {
      right: var(--safe-x);
      bottom: var(--safe-y);
      width: 240px;
      height: 100px;
    }
  </layout>
  <style>
    body {
      font-family: var(--font-family);
    }
    .anchor {
      border-width: var(--border-w);
      border-color: var(--color-border);
      border-radius: var(--radius-s);
    }
    .guide {
      color: var(--color-text-dim);
      font-size: var(--font-size-xs);
    }
  </style>
</xt>
