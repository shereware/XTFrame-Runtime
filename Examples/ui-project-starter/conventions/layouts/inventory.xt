<xt version="2">

  <body>
    <div id="Screen">
      <div id="Header" class="anchor"><span id="HeaderGuide" class="guide">Header</span></div>
      <div id="List" class="anchor"><span id="ListGuide" class="guide">List</span></div>
      <div id="Model" class="anchor"><span id="ModelGuide" class="guide">Model</span></div>
      <div id="Details" class="anchor"><span id="DetailsGuide" class="guide">Details</span></div>
      <div id="Footer" class="anchor"><span id="FooterGuide" class="guide">Footer</span></div>
    </div>
  </body>

  <layout>
    body {
      width: 100vw;
      height: 100vh;
    }
    #Screen {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }
    .anchor {
      position: absolute;
      display: flex;
    }
    .guide {
      padding: var(--space-1);
    }
    #Header {
      left: var(--safe-x);
      top: var(--safe-y);
      width: 1216px;
      height: 56px;
    }
    #List {
      left: var(--safe-x);
      top: 96px;
      width: 420px;
      height: 540px;
    }
    #Model {
      left: 468px;
      top: 96px;
      width: 400px;
      height: 540px;
    }
    #Details {
      right: var(--safe-x);
      top: 96px;
      width: 364px;
      height: 540px;
    }
    #Footer {
      left: var(--safe-x);
      bottom: var(--safe-y);
      width: 1216px;
      height: 32px;
    }
  </layout>
  <style>
    body {
      font-family: var(--font-family);
    }
    .anchor {
      border-width: var(--border-w);
      border-color: var(--color-border);
      border-radius: var(--radius-s);
    }
    .guide {
      color: var(--color-text-dim);
      font-size: var(--font-size-xs);
    }
  </style>
</xt>
