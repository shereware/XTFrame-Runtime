body {
  height: 100%;
}
#root {
  height: 100%;
  padding: 20px;
}
h1 {
  margin: 0px 0px 12px 0px;
}
.panel {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
  margin: 4px;
}
#inc {
  width: 72px;
  height: 34px;
}
#name {
  width: 260px;
  height: 34px;
  padding: 0px 8px 0px 8px;
}
#darkToggle {
  width: 20px;
  height: 20px;
}
