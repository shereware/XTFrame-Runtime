{
  "version": 1,
  "name": "World Layers demo",
  "id": "world-layers",
  "game": "World Layers demo",
  "spec": {
    "behavior": 1,
    "platforms": [
      {
        "name": "desktop",
        "resolutions": [
          [
            1280,
            720
          ],
          [
            1920,
            1080
          ]
        ]
      }
    ],
    "safeArea": {
      "default": 0,
      "console": 0.05
    },
    "logicalHeight": 720,
    "uiscaleRule": "height",
    "input": {
      "methods": [
        "mouse"
      ],
      "players": 1
    },
    "languages": [
      "en"
    ],
    "fontFallback": {},
    "budget": {
      "frameMs": 4,
      "effectLayers": 12,
      "fillRate": 3
    },
    "engine": {
      "name": "",
      "version": ""
    }
  },
  "uis": [
    {
      "id": "stage",
      "doc": "stage/stage.xt",
      "size": [
        1280,
        720
      ],
      "tags": [
        "world"
      ]
    }
  ],
  "shared": {
    "assetRoot": "shared",
    "fontDirs": [],
    "styles": [],
    "templateDirs": [],
    "symbols": "shared/symbols",
    "tokens": "",
    "themes": "shared/themes",
    "strings": "shared/strings",
    "recipes": "shared/recipes"
  },
  "preview": {
    "dpr": 1
  },
  "target": "engine",
  "publish": {
    "outDir": "out",
    "languages": [],
    "embedImages": false,
    "embedFonts": false,
    "thumbnails": [
      320,
      180
    ],
    "atlas": {
      "enabled": false,
      "maxSize": 4096,
      "padding": 2,
      "mipmaps": false
    }
  }
}
