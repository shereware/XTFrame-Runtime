{
 "version": 1,
 "nodes": [
  {
   "id": "sel",
   "type": "radio",
   "params": {
    "count": 6,
    "initial": 5
   }
  },
  {
   "id": "idx_recruit",
   "type": "constant",
   "params": {
    "value": 0
   }
  },
