<xt version="2">
  <head>
    <symbols src="../../shared/symbols/TopBar.xt"/>
    <symbols src="../../shared/symbols/BottomSheet.xt"/>
    <symbols src="../../shared/symbols/TabBar.xt"/>
    <symbols src="../../shared/symbols/ToggleTouch.xt"/>
    <symbols src="../../shared/symbols/SliderTouch.xt"/>
  </head>

  <body>
    <div id="Screen">
      <div id="TopSlot"><use symbol="TopBar" id="Top" slot:title="Paused"/></div>
      <use symbol="BottomSheet" id="Sheet" slot:title="Settings">
        <slot name="content">
          <div id="Sections"><use symbol="TabBar" id="Pages" variant:Count="3" slot:tab1="Game" slot:tab2="Audio" slot:tab3="Controls"/></div>
          <use symbol="ToggleTouch" id="Vibration" slot:label="Vibration"/>
          <use symbol="ToggleTouch" id="LeftHanded" slot:label="Left-handed controls"/>
          <use symbol="SliderTouch" id="Sensitivity" slot:label="Stick sensitivity"/>
        </slot>
      </use>
    </div>
  </body>

  <layout src="settings.layout.xts"/>
  <style src="settings.xts"/>
</xt>
