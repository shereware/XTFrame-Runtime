/* Mobile HUD demo layout: portrait, 1080 px wide at uiscale 1 (spec.uiscaleRule shortEdge).
   Colors and sizes come from the standard tokens only; the bars and buttons keep clear of the
   safe area through the `safe-*` units. */
body {
  background-color: var(--color-bg);
  background-image: var(--tex-grain);
  background-repeat: repeat;
  background-size: 128px 128px;
  font-family: var(--font-family);
}
#Pause {
  border-radius: var(--radius-m);
  background-color: var(--color-surface-raised);
}
#Pause:active {
  background-color: var(--color-accent-pressed);
}
#PauseBarA, #PauseBarB {
  border-radius: var(--radius-s);
  background-color: var(--color-text);
}
#MapSlot {
  border-width: var(--focus-w);
  border-color: var(--color-border-strong);
  border-radius: var(--radius-l);
  background-color: var(--color-surface-sunken);
}
.ring {
  border-width: 4px;
  border-color: var(--color-accent);
  border-radius: var(--radius-full);
  opacity: 0;
}
