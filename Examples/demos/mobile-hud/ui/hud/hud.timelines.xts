@timeline intro {
  #TopSlot {
    0s {
      opacity: 0;
      transform: translateY(-40px);
    }
    0.3s ease-out {
      opacity: 1;
      transform: translateY(0px);
    }
  }
  #MapSlot {
    0.1s {
      opacity: 0;
      transform: scale(0.9);
    }
    0.4s ease-out {
      opacity: 1;
      transform: scale(1);
    }
  }
  #StickSlot {
    0.15s {
      opacity: 0;
      transform: translateX(-60px);
    }
    0.45s ease-out {
      opacity: 1;
      transform: translateX(0px);
    }
  }
  #Actions {
    0.15s {
      opacity: 0;
      transform: translateX(60px);
    }
    0.45s ease-out {
      opacity: 1;
      transform: translateX(0px);
    }
  }
}
@timeline attack-cooldown {
  #AttackRing {
    0s {
      opacity: 1;
      transform: scale(1);
    }
    0.5s ease-out {
      opacity: 0;
      transform: scale(1.25);
    }
  }
}
@timeline jump-cooldown {
  #JumpRing {
    0s {
      opacity: 1;
      transform: scale(1);
    }
    0.5s ease-out {
      opacity: 0;
      transform: scale(1.25);
    }
  }
}
