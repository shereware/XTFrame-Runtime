@timeline intro {
  #settings-tabs {
    0ms {
      opacity: 0;
    }
    500ms ease-out {
      opacity: 1;
    }
  }
  #settings-panel {
    0ms {
      opacity: 0;
    }
    150ms {
      opacity: 0;
    }
    650ms ease-out {
      opacity: 1;
    }
  }
}
@timeline tabhover_gameplay {
  #tab-gameplay-hover {
    0ms {
      opacity: 0;
      transform: translateX(-21px);
    }
    160ms ease-out {
      opacity: 0.6;
    }
    180ms ease-out {
      transform: translateX(0px);
    }
  }
  #tab-gameplay-label {
    0ms {
      opacity: 1;
      transform: translateX(0px);
    }
    30ms {
      opacity: 0.35;
    }
    60ms {
      opacity: 1;
    }
    100ms {
      opacity: 0.6;
    }
    140ms {
      opacity: 1;
    }
    180ms ease-out {
      transform: translateX(9px);
    }
  }
}
