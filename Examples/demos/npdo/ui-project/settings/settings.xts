  line-height: 60px;
  text-align: right;
  font-size: 21px;
  color: #e8e2d4;
}
.sw-state {
  line-height: 60px;
  font-size: 21px;
  color: #e8e2d4;
}
.sw {
  border-radius: 16.5px;
  background-color: #ffffff40;
}
.sw-knob {
  border-radius: 12px;
  background-color: #f6f1e6;
  transition: left 140ms ease-out;
}
