.menu-item {
  position: relative;
  width: 450px;
  height: 63px;
}

.menu-band {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 450px;
  height: 63px;
  opacity: 0;
  border-left-width: 3px;
  border-left-color: #5c2320;
  transition: opacity 160ms ease-out;
}

.band-tex {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 100%;
  height: 100%;
  object-fit: fill;
}

.menu-label {
  position: absolute;
  left: 39px;
  top: 0px;
  height: 63px;
  line-height: 63px;
  white-space: nowrap;
  font-size: 34.5px;
  letter-spacing: 3px;
  color: #d6d0c2;
  transition: color 160ms ease-out;
}

.menu-item:hover .menu-band {
  opacity: 1;
}

.menu-item:hover .menu-label {
  color: #f6f1e6;
}

.key {
  width: 33px;
  height: 33px;
  line-height: 30px;
  text-align: center;
  font-size: 18px;
  border: 1.5px #e8e2d4b3;
  border-radius: 4.5px;
  color: #e8e2d4;
}

.hint {
  font-size: 21px;
  letter-spacing: 1.5px;
  color: #d6d0c2;
  white-space: nowrap;
}

