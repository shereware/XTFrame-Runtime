#hud {
  height: 100vh;
  margin-bottom: 0;
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  overflow: hidden;
  position: relative;
  width: 100vw;
  z-index: 1;
}
#hud-vignette {
  height: 100%;
  left: 0%;
  position: absolute;
  top: 0%;
  width: 100%;
}
/* import: Hud.dc.html:1/2 */
#objective {
  anchor: left top;
  offset: 60px 51px;
  size: 420px 78px;
}
#objective-rule {
  height: 78px;
  left: 0px;
  position: absolute;
  top: 0px;
  width: 3px;
}
#objective-label {
  height: 33px;
  left: 24px;
  position: absolute;
  top: 0px;
}
#objective-line {
  height: 1.5px;
  left: 24px;
  position: absolute;
  top: 37.5px;
  width: 330px;
}
#objective-text {
  height: 36px;
  left: 24px;
  position: absolute;
  top: 42px;
}
/* import: Hud.dc.html:1/3 */
#location {
  align-items: flex-end;
  display: flex;
  flex-direction: column;
  anchor: right top;
  offset: 48px 51px;
  size: 390px 73.5px;
}
#location-name {
  height: 33px;
}
#location-line {
  height: 1.5px;
  margin-bottom: 6px;
  margin-top: 4.5px;
  width: 390px;
}
#location-clock {
  height: 30px;
}
#interact-prompt {
  align-items: center;
  display: flex;
  flex-direction: row;
  gap: 15px;
  height: 48px;
  left: calc(100% - 1safe-right - 231px);
  padding-bottom: 6px;
  padding-left: 6px;
  padding-right: 18px;
  padding-top: 6px;
  position: absolute;
  top: 58.33%;
}
#interact-key {
  height: 36px;
  width: 36px;
}
/* import: Hud.dc.html:1/5 */
#vitals {
  anchor: left bottom;
  offset: 42px 0;
  size: 450px 159px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
/* import: Hud.dc.html:1/5/0/2/0 */
#health-fill {
  width: 64%;
}
/* import: Hud.dc.html:1/5/1/2/0 */
#stamina-fill {
  width: 78%;
}
/* import: Hud.dc.html:1/5/2/2 */
#noise-wave {
  height: 30px;
  left: 168px;
  position: absolute;
  top: 10.5px;
  width: 180px;
}
#noise-value {
  height: 51px;
  left: 366px;
  position: absolute;
  top: 0px;
  width: 84px;
}
/* import: Hud.dc.html:1/6 */
#inventory {
  anchor: right bottom;
  offset: 48px 33px;
  size: 489px 105px;
  display: flex;
  flex-direction: row;
  gap: 39px;
}
.vital {
  position: relative;
  width: 450px;
  height: 51px;
  flex-shrink: 0;
}
.vital-icon {
  position: absolute;
  left: 0px;
  top: 10.5px;
  width: 30px;
  height: 30px;
}
.vital-label {
  position: absolute;
  left: 51px;
  top: 0px;
  height: 51px;
}
.bar-track {
  position: absolute;
  left: 168px;
  top: 21px;
  width: 180px;
  height: 9px;
  overflow: hidden;
}
.bar-fill {
  position: absolute;
  left: 0px;
  top: 0px;
  height: 6px;
}
.gone {
  display: none;
}
.slot {
  position: relative;
  width: 93px;
  height: 105px;
  flex-shrink: 0;
}
.slot-badge {
  position: absolute;
  left: 4.5px;
  top: 4.5px;
  width: 21px;
  height: 21px;
}
.slot-icon {
  position: absolute;
  left: 19.5px;
  top: 28.5px;
  width: 54px;
  height: 54px;
}
.slot-caption {
  position: absolute;
  left: -18px;
  top: 114px;
  width: 129px;
  height: 24px;
}
