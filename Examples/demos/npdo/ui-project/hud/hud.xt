<xt>
  <head>
    <link href="../shared/base.xts"/>
    <link href="hud.xts"/>
    <title>In-game HUD</title>
  </head>
  <body>
    <div id="hud" on:port(active)="if eq(1) show() else hide(); if eq(1) play(intro)" port:objective="string in = &quot;Reach the Main Entrance&quot;" port:location="string in = &quot;St. Ren Hospital Grounds&quot;" port:clock="string in = &quot;17:42&quot;" port:hp="number in = 64" port:stamina="number in = 78" port:noise_label="string in = &quot;Low&quot;" port:interact_label="string in = &quot;Open Gate&quot;" port:interact_visible="bool in = true" port:active="bool in = true">
      <img id="hud-preview-bg" class="s-43161f" src="../shared/img/hud-preview-bg.png"/>
      <div id="hud-vignette"/>
      <div id="objective">
        <div id="objective-rule"/>
        <span id="objective-label">Objective:</span>
        <div id="objective-line"/>
        <span id="objective-text" bind:text="objective">Reach the Main Entrance</span>
      </div>
      <div id="location">
        <span id="location-name" bind:text="location">St. Ren Hospital Grounds</span>
        <div id="location-line"/>
        <span id="location-clock" bind:text="clock">17:42</span>
      </div>
      <div id="interact-prompt" bind:class.gone="interact_visible | not">
        <span id="interact-key">E</span>
        <span id="interact-label" bind:text="interact_label">Open Gate</span>
      </div>
      <div id="vitals">
        <div id="vital-health" class="vital">
          <svg id="health-icon" class="vital-icon" viewBox="0 0 30 30">
            <path id="Pulse" d="M2 15 L9 15 L11.5 9 L15 22 L18 11 L20.5 15 L28 15" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span id="health-label" class="vital-label">Health</span>
          <div id="health-track" class="bar-track">
            <div id="health-fill" class="bar-fill" bind:width="hp | range(0,100,0%,100%)"/>
          </div>
        </div>
        <div id="vital-stamina" class="vital">
          <svg id="stamina-icon" class="vital-icon" viewBox="0 0 30 30">
            <circle id="Head" cx="18.5" cy="5" r="2.4" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Body" d="M17 9.5 L13.5 16.5 L18 20 L16.5 27" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Arm" d="M9.5 13 L14 9.5 L19 12 L22.5 15" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Leg" d="M13.5 16.5 L10.5 21.5 L5.5 22.5" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span id="stamina-label" class="vital-label">Stamina</span>
          <div id="stamina-track" class="bar-track">
            <div id="stamina-fill" class="bar-fill" bind:width="stamina | range(0,100,0%,100%)"/>
          </div>
        </div>
        <div id="vital-noise" class="vital">
          <svg id="noise-icon" class="vital-icon" viewBox="0 0 30 30">
            <rect id="Capsule" x="11" y="3" width="8" height="14" rx="4" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Cradle" d="M7.5 13.5 C7.5 18 10.5 21 15 21 C19.5 21 22.5 18 22.5 13.5" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Stem" d="M15 21 L15 26" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Base" d="M10.5 26 L19.5 26" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span id="noise-label" class="vital-label">Noise</span>
          <svg id="noise-wave" viewBox="0 0 180 30">
            <path id="Wave" d="M0 15 L4 15 L6 10 L8 20 L10 6 L12 24 L14 9 L16 19 L18 12 L20 17 L22 4 L24 26 L26 11 L28 18 L30 14 L32 16 L34 13 L36 15 L45 15" fill="none" stroke="#8fbf8a" stroke-width="1.5" stroke-linejoin="round"/>
            <path id="Rest" d="M48 15 L180 15" fill="none" stroke="#ffffff40" stroke-width="1.5" stroke-dasharray="1.5 4.5"/>
          </svg>
          <span id="noise-value" bind:text="noise_label">Low</span>
        </div>
      </div>
      <div id="inventory">
        <div id="slot-1" class="slot active">
          <span id="slot-1-badge" class="slot-badge">1</span>
          <svg id="slot-1-icon" class="slot-icon" viewBox="0 0 54 54">
            <path id="Body" d="M12 40 L30 22 L36 28 L18 46 Z" fill="#bdb6a8" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Head" d="M30 22 L37 15 L43 21 L36 28 Z" fill="#e8e2d4" cx="18.5" cy="5" r="2.4" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path id="Switch" d="M20 34 L23 31 L25 33 L22 36 Z" fill="#a39e93"/>
          </svg>
          <span id="slot-1-caption" class="slot-caption">Flashlight</span>
        </div>
        <div id="slot-2" class="slot">
          <span id="slot-2-badge" class="slot-badge">2</span>
          <svg id="slot-2-icon" class="slot-icon" viewBox="0 0 54 54">
            <path id="Bar" d="M15 45 L35 14 C37.5 10 42.5 10 44 14" fill="none" stroke="#d6d0c2" stroke-width="3.6" stroke-linecap="round"/>
          </svg>
          <span id="slot-2-caption" class="slot-caption">Crowbar</span>
        </div>
        <div id="slot-3" class="slot">
          <span id="slot-3-badge" class="slot-badge">3</span>
          <svg id="slot-3-icon" class="slot-icon" viewBox="0 0 54 54">
            <rect id="Board" x="15" y="11" width="24" height="34" rx="2" fill="#a39e93"/>
            <rect id="Clip" x="21" y="7.5" width="12" height="6" rx="1.5" fill="#e8e2d4"/>
            <rect id="Line1" x="19.5" y="20" width="15" height="2" fill="#e8e2d4"/>
            <rect id="Line2" x="19.5" y="26" width="15" height="2" fill="#e8e2d4"/>
            <rect id="Line3" x="19.5" y="32" width="10" height="2" fill="#e8e2d4"/>
          </svg>
          <span id="slot-3-caption" class="slot-caption">Clipboard</span>
        </div>
        <div id="slot-4" class="slot">
          <span id="slot-4-badge" class="slot-badge">4</span>
          <svg id="slot-4-icon" class="slot-icon" viewBox="0 0 54 54">
            <circle id="Bow" cx="18" cy="21" r="7.5" fill="none" stroke="#e8e2d4" stroke-width="3"/>
            <path id="Shaft" d="M23.5 26.5 L42 45" fill="none" stroke="#e8e2d4" stroke-width="3" stroke-linecap="round"/>
            <path id="Tooth1" d="M35.5 38.5 L39.5 34.5" fill="none" stroke="#e8e2d4" stroke-width="3" stroke-linecap="round"/>
            <path id="Tooth2" d="M39.5 42.5 L43.5 38.5" fill="none" stroke="#e8e2d4" stroke-width="3" stroke-linecap="round"/>
          </svg>
          <span id="slot-4-caption" class="slot-caption">East Wing Key</span>
        </div>
      </div>
    </div>
  </body>
</xt>
