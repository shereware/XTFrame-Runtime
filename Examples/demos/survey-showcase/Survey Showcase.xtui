{
  "version": 1,
  "name": "Survey Showcase",
  "id": "survey-showcase",
  "game": "",
  "spec": {
    "behavior": 1,
    "platforms": [],
    "safeArea": { "default": 0.025, "console": 0.05 },
    "uiscaleRule": "fit",
    "input": { "methods": [], "players": 1 },
    "languages": [],
    "fontFallback": {},
    "budget": { "frameMs": 0, "effectLayers": 0, "fillRate": 0 },
    "engine": { "name": "", "version": "" },
    "logicalHeight": 720
  },
  "uis": [
    { "id": "title", "doc": "title/title.xt", "size": [1280, 720] },
    { "id": "options", "doc": "options/options.xt", "size": [1280, 720] },
    { "id": "load", "doc": "load/load.xt", "size": [1280, 720] },
    { "id": "hud", "doc": "hud/hud.xt", "size": [1280, 720] },
    { "id": "pause", "doc": "pause/pause.xt", "size": [1280, 720] }
  ],
  "shared": {
    "assetRoot": "shared",
    "fontDirs": ["shared/fonts"],
    "styles": [],
    "templateDirs": [],
    "symbols": "shared/symbols",
    "tokens": "shared/tokens.xts",
    "themes": "shared/themes",
    "strings": "shared/strings",
    "recipes": "shared/recipes",
    "design": "design"
  },
  "preview": { "dpr": 1 },
  "target": "engine",
  "publish": { "outDir": "publish", "languages": [], "embedImages": false, "embedFonts": false,
    "thumbnails": [320, 180], "atlas": { "enabled": false, "maxSize": 4096, "padding": 2, "mipmaps": false, "scope": "ui" }, "targets": [] }
}
