body {
  width: 100vw;
  height: 100vh;
}
#Screen {
  position: relative;
  width: 100vw;
  height: 100vh;
}
/* The editor-only reference frame (references/make_images.py), stretched over the whole UI. */
#GameShot {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 100vw;
  height: 100vh;
}
#Vignette {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 100vw;
  height: 100vh;
}
/* 2. Health and stamina, top left. */
#Status {
  position: absolute;
  left: 48px;
  top: 44px;
  width: 460px;
  height: 80px;
}
.track {
  position: absolute;
  left: 0px;
  overflow: hidden;
}
#HpTrack {
  top: 0px;
  width: 364px;
  height: 26px;
}
#HpFill {
  position: absolute;
  left: 3px;
  top: 3px;
  width: 356px;
  height: 18px;
}
#HpLow {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 362px;
  height: 24px;
}
.value {
  position: absolute;
  top: -2px;
  left: 376px;
}
#StaminaTrack {
  top: 36px;
  width: 284px;
  height: 16px;
}
#StaminaFill {
  position: absolute;
  left: 3px;
  top: 3px;
  width: 276px;
  height: 8px;
}
/* 3. Glass skill bar, bottom left. */
#Skills {
  position: absolute;
  left: 48px;
  bottom: 48px;
  display: flex;
  column-gap: 14px;
}
.skill {
  position: relative;
  width: 76px;
  height: 76px;
  overflow: hidden;
}
.icon {
  position: absolute;
  left: 22px;
  top: 18px;
  width: 32px;
  height: 32px;
}
.blade {
  transform: rotate(45deg);
}
#Cooldown {
  position: absolute;
  left: -14px;
  top: -14px;
  width: 104px;
  height: 104px;
}
.key {
  position: absolute;
  right: 6px;
  bottom: 2px;
}
/* 4. Minimap, top right: a circular clip of the map texture, a ring and a screen-blended glow. */
#MapFrame {
  position: absolute;
  right: 52px;
  top: 44px;
  width: 248px;
  height: 248px;
}
#MapClip {
  position: absolute;
  left: 4px;
  top: 4px;
  width: 240px;
  height: 240px;
}
#MapImage {
  width: 240px;
  height: 240px;
}
#MapGlow {
  position: absolute;
  left: 4px;
  top: 4px;
  width: 240px;
  height: 240px;
}
#MapRing {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 244px;
  height: 244px;
}
#MapPlayer {
  position: absolute;
  left: 116px;
  top: 112px;
  width: 16px;
  height: 22px;
}
#Crosshair {
  position: absolute;
  left: 930px;
  top: 510px;
  width: 60px;
  height: 60px;
}
.hair {
  position: absolute;
}
.hair.v {
  left: 29px;
  width: 2px;
  height: 18px;
}
.hair.h {
  top: 29px;
  width: 18px;
  height: 2px;
}
#CrossTop {
  top: 0px;
}
#CrossBottom {
  top: 42px;
}
#CrossLeft {
  left: 0px;
}
#CrossRight {
  left: 42px;
}
#CrossDot {
  position: absolute;
  left: 28px;
  top: 28px;
  width: 4px;
  height: 4px;
}
#Quests {
  position: absolute;
  right: 48px;
  bottom: 160px;
  width: 400px;
  padding: 18px 20px 18px 20px;
  display: flex;
  flex-direction: column;
  row-gap: 10px;
}
.quest {
  width: 360px;
}
#Ammo {
  position: absolute;
  left: 810px;
  bottom: 40px;
  width: 300px;
  height: 84px;
  display: grid;
  grid-template-columns: 56px 1fr 80px;
  align-items: center;
  column-gap: 8px;
}
#AmmoIcon {
  display: flex;
  column-gap: 4px;
  justify-content: center;
}
.round {
  width: 8px;
  height: 28px;
}
/* Clears `.hurt` after one flash so the next hit plays it again (#HurtClock is an empty box
   that only gives the timeline its length). */
#HurtClock {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 0px;
  height: 0px;
}
