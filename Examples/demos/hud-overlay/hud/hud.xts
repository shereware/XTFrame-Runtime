/* HUD overlay demo: 1920x1080 design (spec.logicalHeight 1080, uiscaleRule height). Nothing here
   paints the root: the host composites the UI over its own frame, so every panel is translucent
   and the blend modes and backdrop blur work against whatever the game draws. */
body {
  font-family: "Segoe UI", "Noto Sans", "Helvetica", "DejaVu Sans";
  color: var(--hud-text, #f2f5f8);
}
/* 7. Damage vignette: multiplied over the frame; `.hurt` on <body> plays the flash once. */
#Vignette {
  background-gradient: radial-gradient(72% 72% at 50% 50%, rgba(180, 0, 0, 0) 55%, rgba(180, 0, 0, 0.55) 100%);
  mix-blend-mode: multiply;
  opacity: 0;
  pointer-events: none;
}
body.hurt #Vignette {
  animation: hurt-flash 0.9s linear(0, 0.4 20%, 0.75 45%, 0.93 75%, 1) 1 forwards;
}
@keyframes hurt-flash {
  0% {
    opacity: 0;
  }
  30% {
    opacity: 0.8;
  }
  100% {
    opacity: 0;
  }
}
.track {
  background-color: rgba(0, 0, 0, 0.45);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.25);
  border-radius: 8px;
}
#HpFill {
  border-radius: 5px;
  background-gradient: linear-gradient(90deg, #b3122a 0%, #ff4d5e 70%, #ff9a8a 100%);
}
#HpLow {
  border-radius: 7px;
  background-color: rgba(255, 60, 60, 0.45);
  animation: hp-pulse 0.9s linear(0, 0.1 25%, 0.5 50%, 0.9 75%, 1) infinite;
}
@keyframes hp-pulse {
  0% {
    opacity: 0.15;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.15;
  }
}
.value {
  font-size: 22px;
  font-variant-numeric: tabular-nums;
  text-effect: shadow 0px 1px 3px rgba(0, 0, 0, 0.8);
}
#StaminaFill {
  border-radius: 4px;
  background-gradient: linear-gradient(90deg, #2f9e5a 0%, #8be07a 100%);
}
.skill {
  border-radius: 14px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.22);
  background-color: var(--hud-glass, rgba(255, 255, 255, 0.08));
  effect: backdrop-blur(8px);
}
/* The focused slot (autofocus on the second one) shows the focus ring. */
.skill:focus {
  outline-width: 3px;
  outline-style: solid;
  outline-color: var(--hud-accent, #7fd4ff);
  outline-offset: 3px;
}
.blade {
  background-gradient: linear-gradient(135deg, #e8eef5 0%, #7f93a8 100%);
  border-radius: 4px;
}
.shield {
  background-gradient: linear-gradient(180deg, #7fd4ff 0%, #2a6fd1 100%);
  border-radius: 6px 6px 16px 16px;
}
.bolt {
  background-gradient: linear-gradient(180deg, #ffe680 0%, #f5a623 100%);
  clip-path: polygon(60% 0%, 10% 55%, 45% 55%, 35% 100%, 90% 40%, 55% 40%);
}
.heal {
  background-gradient: radial-gradient(50% 50% at 50% 50%, #b6ffb0 0%, #2e9a3e 100%);
  border-radius: 16px;
}
.dash {
  background-gradient: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, #ffffff 100%);
  clip-path: polygon(0% 30%, 70% 30%, 70% 10%, 100% 50%, 70% 90%, 70% 70%, 0% 70%);
}
/* Cooldown dial: a dark conic wedge clipped to a circle, turned once by the `demo` timeline. */
#Cooldown {
  background-gradient: conic-gradient(from 0deg, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.62) 69%, rgba(0, 0, 0, 0) 69%);
  clip-path: circle(closest-side at 50% 50%);
}
.key {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.75);
}
#MapClip {
  clip-path: circle(closest-side at 50% 50%);
  opacity: 0.85;
}
#MapGlow {
  border-radius: 120px;
  background-gradient: radial-gradient(50% 50% at 50% 50%, rgba(140, 210, 255, 0.55) 0%, rgba(140, 210, 255, 0) 100%);
  mix-blend-mode: screen;
}
#MapRing {
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.3);
  border-radius: 124px;
}
#MapPlayer {
  background-color: #ffd166;
  clip-path: polygon(50% 0%, 100% 100%, 50% 75%, 0% 100%);
}
/* 5. Crosshair: thin lines in difference mode, readable on bright sky and dark towers alike. */
#Crosshair {
  mix-blend-mode: difference;
}
.hair {
  background-color: #ffffff;
}
#CrossDot {
  border-radius: 2px;
  background-color: #ffffff;
}
/* 6. Quest tracker, bottom right: blurred dark glass, underlined uppercase title, clamped lines. */
#Quests {
  border-radius: 12px;
  background-color: rgba(10, 14, 20, 0.6);
  effect: backdrop-blur(12px);
}
#QuestTitle {
  font-size: 16px;
  letter-spacing: 3px;
  text-transform: uppercase;
  text-decoration-line: underline;
  text-decoration-color: var(--hud-accent, #7fd4ff);
  color: var(--hud-accent, #7fd4ff);
}
.quest {
  font-size: 17px;
  line-height: 24px;
  line-clamp: 2;
  color: rgba(242, 245, 248, 0.9);
}
/* 8. Ammo, bottom centre: icon / count / reserve on a three-column grid. */
#Ammo {
  border-radius: 14px;
  background-color: rgba(0, 0, 0, 0.35);
}
.round {
  border-radius: 4px 4px 1px 1px;
  background-gradient: linear-gradient(180deg, #ffd88a 0%, #c08a2a 100%);
}
#AmmoCount {
  font-size: 56px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  color: #fff4d6;
  text-effect: glow 6px #ffb347;
}
#AmmoReserve {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.6);
}
