.menu-item {
  background-color: #ffffff00;
  border: 0px #ffffff00;
  border-radius: 18px;
  cursor: pointer;
}
.item-hl {
  border-radius: 18px;
  background-color: #fff8e2c7;
  opacity: 0;
  transition: opacity 160ms linear;
}
.menu-item:hover .item-hl {
  opacity: 1;
}
.icon {
  object-fit: contain;
}
.icon-color {
  opacity: 0;
  transition: opacity 160ms linear;
}
.menu-item:hover .icon-color {
  opacity: 1;
}
.label {
  font-family: "Noto Serif", serif;
  font-size: 30px;
  line-height: 40px;
  font-weight: 700;
  letter-spacing: 1px;
  white-space: nowrap;
}
.label-gray {
  color: #6e6e6e;
}
.label-color {
  opacity: 0;
  transition: opacity 160ms linear;
}
.menu-item:hover .label-color {
  opacity: 1;
}
.title {
  text-align: center;
  font-size: 112px;
  line-height: 140px;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 2px;
  text-effect: shadow 0px 0px 8px #ffffffe6, shadow 0px 2px 2px #ffffffb3;
}
@keyframes fireflies-rise {
  from {
    transform: translateY(0px);
  }
  to {
    transform: translateY(-720px);
  }
}
@keyframes petals-fall {
  from {
    transform: translateY(-720px);
  }
  to {
    transform: translateY(0px);
  }
}
@media (prefers-reduced-motion: reduce) {
  #fx-fireflies {
    animation: fireflies-rise 60s linear 0s infinite paused;
  }
  #fx-petals {
    animation: petals-fall 26s linear 0s infinite paused;
  }
}
