<xt>
  <head>
    <!-- HealthBar: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="HealthBar" state-groups="Level: Normal|Low"
            requires="states: Normal, Low; slots: label">
      <div id="Box" port:hp="number in" port:hp_max="number in" port:hit="event in"
           bind:state.Normal="hp | ge(25%)" bind:state.Low="hp | lt(25%)" on:port(hit)="play(hit)">
        <div id="Head">
          <span id="Label"><slot name="label">HP</slot></span>
          <span id="Value" bind:text="format('{0} / {1}', hp, hp_max)"></span>
        </div>
        <div id="Track">
          <div id="Fill" bind:scale-x="hp | clamp(0, hp_max) | range(0, hp_max, 0, 1) | tween(0.3s, ease-out)"></div>
        </div>
      </div>
    </symbol>
    <style>
      symbol(HealthBar) {
        #Box {
          display: flex;
          flex-direction: column;
          row-gap: var(--space-1);
          width: 280px;
          font-family: var(--font-family);
          font-size: var(--font-size-s);
          color: var(--color-text);
        }
        #Head { display: flex; justify-content: space-between; }
        #Label { font-weight: 700; letter-spacing: 1px; }
        #Value { color: var(--color-text-dim); }
        #Track {
          height: 12px;
          padding: 2px;
          border-width: var(--border-w);
          border-color: var(--color-border);
          border-radius: var(--radius-s);
          background-color: var(--color-surface-sunken);
        }
        #Fill {
          width: 100%;
          height: 6px;
          transform-origin: 0% 50%;
          border-radius: 2px;
          background-color: var(--color-success);
          transition: background-color var(--motion-normal) linear;
        }
        #Box:state(Normal) #Fill { background-color: var(--color-success); }
        #Box:state(Low) #Fill { background-color: var(--color-danger); }
        #Box:state(Low) #Value { color: var(--color-danger); }
        @timeline hit {
          #Track { 0s { transform: translateX(0px) } 0.05s { transform: translateX(-3px) } 0.1s { transform: translateX(3px) } 0.15s ease-out { transform: translateX(0px) } }
        }
      }
    </style>
  </head>
</xt>
