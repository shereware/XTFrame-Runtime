<xt>
  <head>
    <!-- Subtitle: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="Subtitle" state-groups="Voice: Character|Narrator" requires="states: Character, Narrator">
      <div id="Box" port:speaker="string in" port:line="string in" port:narrator="bool in"
           bind:state.Narrator="narrator" bind:state.Character="narrator | not" bind:visible="line | ne('')"
           on:port(line)="play(intro)" on:hide="play(outro) then hide">
        <span id="Speaker" bind:text="speaker"></span>
        <span id="Line" bind:text="line"></span>
      </div>
    </symbol>
    <style>
      symbol(Subtitle) {
        #Box {
          display: flex;
          flex-direction: column;
          align-items: center;
          row-gap: var(--space-1);
          max-width: 640px;
          padding: var(--space-2) var(--space-4);
          border-radius: var(--radius-s);
          background-color: var(--color-scrim);
          font-family: var(--font-family);
          text-align: center;
        }
        #Speaker { color: var(--color-accent); font-size: var(--font-size-s); font-weight: 700; }
        #Line { color: var(--color-text); font-size: var(--font-size-m); }
        #Box:state(Character) #Speaker { display: block; }
        #Box:state(Narrator) #Speaker { display: none; }
        #Box:state(Narrator) #Line { color: var(--color-text-dim); font-style: italic; }
        @timeline intro {
          #Box { 0s { opacity: 0 } 0.15s linear { opacity: 1 } }
          #Line { 0s { text-reveal: 0 } 0.35s linear { text-reveal: 1 } }
        }
        @timeline outro {
          #Box { 0s { opacity: 1 } 0.2s linear { opacity: 0 } }
        }
      }
    </style>
  </head>
</xt>
