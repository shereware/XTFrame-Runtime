<xt>
  <head>
    <!-- OptionCycler: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="OptionCycler" requires="states: Hover, Focus, Disabled; slots: label">
      <div id="Box" tabindex="0" port:current="string in" port:prev="event out" port:next="event out"
           on:key(Left)="sound(ui_tick); emit(prev)" on:key(Right)="sound(ui_tick); emit(next)">
        <span id="Label"><slot name="label">Option</slot></span>
        <div id="Picker">
          <button id="Prev" on:press="sound(ui_tick)" on:click="emit(prev)"><div id="PrevArrow"></div></button>
          <span id="Current" bind:text="current"></span>
          <button id="Next" on:press="sound(ui_tick)" on:click="emit(next)"><div id="NextArrow"></div></button>
        </div>
      </div>
    </symbol>
    <style>
      symbol(OptionCycler) {
        #Box {
          display: flex;
          align-items: center;
          justify-content: space-between;
          column-gap: var(--space-4);
          width: 360px;
          height: var(--control-l);
          padding: 0px var(--space-3);
          border-width: var(--focus-w);
          border-color: transparent;
          border-radius: var(--radius-m);
          color: var(--color-text);
          font-family: var(--font-family);
          font-size: var(--font-size-m);
          transition: background-color var(--motion-instant) linear;
        }
        #Box:hover { background-color: var(--color-surface-raised); }
        #Box:focus { border-color: var(--color-focus); background-color: var(--color-surface-raised); }
        #Picker { display: flex; align-items: center; column-gap: var(--space-2); }
        #Current { min-width: 120px; text-align: center; }
        #Prev, #Next {
          display: flex;
          align-items: center;
          justify-content: center;
          width: var(--control-s);
          height: var(--control-s);
          border-radius: var(--radius-s);
          background-color: transparent;
        }
        #Prev:hover, #Next:hover { background-color: var(--color-border); }
        #PrevArrow, #NextArrow {
          width: 8px;
          height: 8px;
          border-left-width: 2px;
          border-bottom-width: 2px;
          border-color: var(--color-accent);
        }
        #PrevArrow { transform: rotate(45deg); }
        #NextArrow { transform: rotate(-135deg); }
        :disabled #Current { color: var(--color-disabled-text); }
        :disabled #PrevArrow, :disabled #NextArrow { border-color: var(--color-disabled-text) !important; }
      }
    </style>
  </head>
</xt>
