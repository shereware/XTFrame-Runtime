<xt>
  <head>
    <!-- Button: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="Button" origin="center" variants="Kind=Primary|Secondary|Ghost, Size=S|M|L"
            requires="states: Hover, Pressed, Focus, Disabled; slots: label">
      <button id="Box" port:pressed="event out"
              on:hover="play(hover-in)" on:leave="play(hover-out)"
              on:press="sound(ui_click); play(press)" on:click="emit(pressed)">
        <span id="Label"><slot name="label">Button</slot></span>
      </button>
    </symbol>
    <style>
      symbol(Button) {
        #Box {
          display: flex;
          align-items: center;
          justify-content: center;
          min-width: 128px;
          height: var(--control-m);
          padding: 0px var(--space-4);
          border-width: var(--focus-w);
          border-color: transparent;
          border-radius: var(--radius-m);
          background-color: var(--color-accent);
          color: var(--color-text-on-accent);
          font-family: var(--font-family);
          font-size: var(--font-size-m);
          transition: background-color var(--motion-fast) linear;
        }
        #Label { font-weight: 600; white-space: nowrap; flex-shrink: 0; }
        #Box:hover { background-color: var(--color-accent-hover); }
        #Box:active { background-color: var(--color-accent-pressed); }
        #Box:focus { border-color: var(--color-focus); }
        .v-Kind-Secondary #Box { background-color: var(--color-surface-raised); color: var(--color-text); border-color: var(--color-border); }
        .v-Kind-Secondary #Box:hover { background-color: var(--color-border); }
        .v-Kind-Secondary #Box:active { background-color: var(--color-surface-sunken); }
        .v-Kind-Secondary #Box:focus { border-color: var(--color-focus); }
        .v-Kind-Ghost #Box { background-color: transparent; color: var(--color-text); }
        .v-Kind-Ghost #Box:hover { background-color: var(--color-surface-raised); }
        .v-Kind-Ghost #Box:active { background-color: var(--color-surface-sunken); }
        .v-Kind-Ghost #Box:focus { border-color: var(--color-focus); }
        .v-Size-S #Box { min-width: 88px; height: var(--control-s); padding: 0px var(--space-3); font-size: var(--font-size-s); }
        .v-Size-L #Box { min-width: 200px; height: var(--control-l); padding: 0px var(--space-6); font-size: var(--font-size-l); }
        :disabled #Box {
          background-color: var(--color-disabled-bg) !important;
          color: var(--color-disabled-text) !important;
          border-color: transparent !important;
        }
        @timeline hover-in {
          #Box { 0s { transform: scale(1) } 0.12s ease-out { transform: scale(1.03) } }
        }
        @timeline hover-out {
          #Box { 0s { transform: scale(1.03) } 0.12s ease-out { transform: scale(1) } }
        }
        @timeline press {
          #Box { 0s { transform: scale(0.97) } 0.15s ease-out { transform: scale(1) } }
        }
      }
    </style>
  </head>
</xt>
