<xt>
  <head>
    <!-- RadioGroup: standard symbol (docs/design/30-ui-project.md 30.4). See README.md. -->
    <symbol name="RadioGroup" requires="states: Hover, Focus, Selected, Disabled">
      <div id="Box" port:options="list&lt;struct{label: string}&gt; in" port:value="number in"
           port:select="event out">
        <repeat port="options" id="Option">
          <div id="Row" bind:state.Selected="index | eq(value)" on:press="sound(ui_select); emit(select)">
            <div id="Dot"><div id="Pip"></div></div>
            <span id="Text" bind:text="item(label)"></span>
          </div>
        </repeat>
      </div>
    </symbol>
    <style>
      symbol(RadioGroup) {
        #Box {
          display: flex;
          flex-direction: column;
          width: 220px;
          color: var(--color-text);
          font-family: var(--font-family);
          font-size: var(--font-size-m);
        }
        #Option { display: flex; flex-direction: column; row-gap: var(--space-1); }
        #Row {
          display: flex;
          align-items: center;
          column-gap: var(--space-2);
          padding: var(--space-1) var(--space-2);
          border-width: var(--focus-w);
          border-color: transparent;
          border-radius: var(--radius-s);
        }
        #Dot {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 20px;
          height: 20px;
          border-width: var(--focus-w);
          border-color: var(--color-border-strong);
          border-radius: var(--radius-full);
        }
        #Pip {
          width: 10px;
          height: 10px;
          border-radius: var(--radius-full);
          background-color: var(--color-accent);
          opacity: 0;
        }
        #Row:hover #Dot { border-color: var(--color-accent); }
        #Row:focus { border-color: var(--color-focus); }
        #Row:state(Selected) #Dot { border-color: var(--color-accent); }
        #Row:state(Selected) #Pip { opacity: 1; }
        :disabled #Row { color: var(--color-disabled-text); }
        :disabled #Dot { border-color: var(--color-disabled-bg) !important; }
        :disabled #Pip { background-color: var(--color-disabled-text) !important; }
      }
    </style>
  </head>
</xt>
