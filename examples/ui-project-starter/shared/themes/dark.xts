/* Starter UI Project: "dark" theme. Only token declarations; activating the theme (xtframe-pack
   lists it in the manifest's `themes[]`, the host calls loadThemes / Context::setTheme("dark"))
   swaps these values without recompiling. */
:root {
  --color-bg: #0e1117;
  --color-surface: #161b22;
  --color-surface-raised: #1f2630;
  --color-surface-sunken: #0b0e13;
  --color-border: #30363d;
  --color-border-strong: #4a535e;
  --color-text: #e6edf3;
  --color-text-dim: #9aa4af;
  --color-text-on-accent: #0b0e13;
  --color-accent: #4cc2ff;
  --color-accent-hover: #7ad3ff;
  --color-accent-pressed: #2aa3e6;
  --color-focus: #ffd24c;
  --color-disabled-bg: #222830;
  --color-disabled-text: #5c6570;
  --color-danger: #ff5a5f;
  --color-warning: #ffb547;
  --color-success: #4cd98a;
  --color-info: #4cc2ff;
  --color-scrim: #000000b3;
  --color-track: #2a313b;
  --color-shadow: #00000099;
}
