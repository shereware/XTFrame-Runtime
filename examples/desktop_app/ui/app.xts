body {
  height: 100%;
}

#root {
  height: 100%;
  padding: 20px;
  background-color: #ffffff;
  color: #101010;
  font-family: "Segoe UI", "Helvetica", "DejaVu Sans";
  font-size: 16px;
}

h1 {
  font-size: 24px;
  margin: 0px 0px 12px 0px;
}

.panel {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
  margin: 4px;
}

#inc {
  width: 72px;
  height: 34px;
  line-height: 34px;
  text-align: center;
  background-color: #4444ee;
  color: #ffffff;
  border-radius: 6px;
  transition: background-color 150ms;
}

#inc:hover {
  background-color: #6666ff;
}

#inc:active {
  background-color: #2222cc;
}

#name {
  width: 260px;
  height: 34px;
  line-height: 34px;
  padding: 0px 8px 0px 8px;
  border: 1px #808080;
  border-radius: 4px;
  background-color: #ffffff;
}

#name:focus {
  border: 1px #4444ee;
}

#darkToggle {
  width: 20px;
  height: 20px;
  border: 1px #808080;
  border-radius: 4px;
  background-color: #ffffff;
  transition: background-color 150ms;
}

#darkToggle:checked {
  background-color: #4444ee;
}

/* Toggled on #root by the checkbox's Change listener (see main.cpp), demonstrating a descendant
   selector reacting to an ancestor's class (docs/design/05-style-and-css.md §5.3). */
.dark {
  background-color: #202020;
  color: #f0f0f0;
}

.dark div {
  color: #e0e0e0;
}

.dark #name {
  background-color: #303030;
  color: #f0f0f0;
}
