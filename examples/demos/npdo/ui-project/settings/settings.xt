<xt>
  <head>
    <link href="../shared/base.xts"/>
    <link href="settings.xts"/>
    <title>Settings</title>
  </head>
  <body>
    <div id="settings" on:port(active)="if eq(1) show() else hide(); if eq(1) play(intro)" port:master_volume="number in = 80" port:music_volume="number in = 60" port:sfx_volume="number in = 75" port:dialogue_volume="number in = 90" port:output_device="string in = &quot;Headphones (Realtek)&quot;" port:audio_mode="string in = &quot;Night Mode&quot;" port:subtitles="bool in = true" port:gp_camera_shake="number in = 60" port:gp_autosave="bool in = true" port:gp_hints="bool in = true" port:gfx_brightness="number in = 50" port:gfx_vsync="bool in = true" port:gfx_grain="bool in = false" port:ctl_sensitivity="number in = 40" port:ctl_invert_y="bool in = false" port:acc_contrast="bool in = false" port:acc_text_size="number in = 50" port:mic_input_volume="number in = 70" port:mic_voice_chat="bool in = true" port:mic_push_to_talk="bool in = false" port:tab="number in = 0" port:tab_gameplay="event out" port:tab_graphics="event out" port:tab_audio="event out" port:tab_controls="event out" port:tab_accessibility="event out" port:tab_microphone="event out" port:audio_mode_prev="event out" port:audio_mode_next="event out" port:open_output_device="event out" port:toggle_subtitles="event out" port:play_test_sound="event out" port:apply_settings="event out" port:reset_defaults="event out" port:back="event out" port:active="bool in = true">
      <img id="settings-bg" class="s-43161f" src="../shared/img/menu-bg.png"/>
      <div id="settings-shade"/>
      <img id="settings-title" src="../shared/img/menu-title.png"/>
      <div id="settings-location">
        <div id="location-line-1">ST. REN HOSPITAL</div>
        <div id="location-line-2">TAIPEI, TAIWAN</div>
        <div id="location-line-3">1991 - 1997</div>
      </div>
      <div id="settings-tabs">
        <div id="tab-gameplay" class="tab" on:hover="sound(ui_hover); play(tabhover_gameplay)" on:leave="play(tabhover_gameplay, reverse)" on:click="sound(ui_confirm); set(tab, 1); emit(tab_gameplay)" bind:class.sel="tab | eq(1)">
          <div id="tab-gameplay-sel" class="tab-band tab-sel">
            <img id="tab-hl-1" class="band-tex" src="../shared/img/tab-hl-1.png"/>
          </div>
          <div id="tab-gameplay-hover" class="tab-band tab-hover">
            <img id="tab-hl-1-hover" class="band-tex" src="../shared/img/tab-hl-1.png"/>
          </div>
          <span id="tab-gameplay-label" class="tab-label">Gameplay</span>
        </div>
        <div id="tab-graphics" class="tab" on:hover="sound(ui_hover); play(tabhover_graphics)" on:leave="play(tabhover_graphics, reverse)" on:click="sound(ui_confirm); set(tab, 2); emit(tab_graphics)" bind:class.sel="tab | eq(2)">
          <div id="tab-graphics-sel" class="tab-band tab-sel">
            <img id="tab-hl-2" class="band-tex" src="../shared/img/tab-hl-2.png"/>
          </div>
          <div id="tab-graphics-hover" class="tab-band tab-hover">
            <img id="tab-hl-2-hover" class="band-tex" src="../shared/img/tab-hl-2.png"/>
          </div>
          <span id="tab-graphics-label" class="tab-label">Graphics</span>
        </div>
        <div id="tab-audio" class="tab sel" on:hover="sound(ui_hover); play(tabhover_audio)" on:leave="play(tabhover_audio, reverse)" on:click="sound(ui_confirm); set(tab, 0); emit(tab_audio)" bind:class.sel="tab | eq(0)">
          <div id="tab-audio-sel" class="tab-band tab-sel">
            <img id="tab-hl-3" class="band-tex" src="../shared/img/tab-hl-3.png"/>
          </div>
          <div id="tab-audio-hover" class="tab-band tab-hover">
            <img id="tab-hl-3-hover" class="band-tex" src="../shared/img/tab-hl-3.png"/>
          </div>
          <span id="tab-audio-label" class="tab-label">Audio</span>
        </div>
        <div id="tab-controls" class="tab" on:hover="sound(ui_hover); play(tabhover_controls)" on:leave="play(tabhover_controls, reverse)" on:click="sound(ui_confirm); set(tab, 3); emit(tab_controls)" bind:class.sel="tab | eq(3)">
          <div id="tab-controls-sel" class="tab-band tab-sel">
            <img id="tab-hl-4" class="band-tex" src="../shared/img/tab-hl-4.png"/>
          </div>
          <div id="tab-controls-hover" class="tab-band tab-hover">
            <img id="tab-hl-4-hover" class="band-tex" src="../shared/img/tab-hl-4.png"/>
          </div>
          <span id="tab-controls-label" class="tab-label">Controls</span>
        </div>
        <div id="tab-accessibility" class="tab" on:hover="sound(ui_hover); play(tabhover_accessibility)" on:leave="play(tabhover_accessibility, reverse)" on:click="sound(ui_confirm); set(tab, 4); emit(tab_accessibility)" bind:class.sel="tab | eq(4)">
          <div id="tab-accessibility-sel" class="tab-band tab-sel">
            <img id="tab-hl-5" class="band-tex" src="../shared/img/tab-hl-5.png"/>
          </div>
          <div id="tab-accessibility-hover" class="tab-band tab-hover">
            <img id="tab-hl-5-hover" class="band-tex" src="../shared/img/tab-hl-5.png"/>
          </div>
          <span id="tab-accessibility-label" class="tab-label">Accessibility</span>
        </div>
        <div id="tab-microphone" class="tab" on:hover="sound(ui_hover); play(tabhover_microphone)" on:leave="play(tabhover_microphone, reverse)" on:click="sound(ui_confirm); set(tab, 5); emit(tab_microphone)" bind:class.sel="tab | eq(5)">
          <div id="tab-microphone-sel" class="tab-band tab-sel">
            <img id="tab-hl-6" class="band-tex" src="../shared/img/tab-hl-6.png"/>
          </div>
          <div id="tab-microphone-hover" class="tab-band tab-hover">
            <img id="tab-hl-6-hover" class="band-tex" src="../shared/img/tab-hl-6.png"/>
          </div>
          <span id="tab-microphone-label" class="tab-label">Microphone</span>
        </div>
      </div>
      <div id="settings-panel">
        <div id="panel-gameplay" class="panel off" bind:class.off="tab | ne(1)">
          <span id="panel-gameplay-heading" class="panel-heading">Gameplay</span>
          <span id="panel-gameplay-desc" class="panel-desc">How the world treats you, and how much it forgives.</span>
          <div id="panel-gameplay-divider" class="panel-divider"/>
          <div id="row-difficulty" class="row">
            <span id="row-difficulty-label" class="row-label">Difficulty</span>
            <div id="difficulty-box" class="box">
              <span id="difficulty-text" class="box-cycle">&lt;   Standard   &gt;</span>
            </div>
          </div>
          <div id="row-shake" class="row">
            <span id="row-shake-label" class="row-label">Camera Shake</span>
            <div id="shake-track" class="sl-track">
              <div id="shake-fill" class="sl-fill s-b36e42" bind:width="gp_camera_shake | range(0,100,0%,100%)">
                <div id="shake-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="shake-value" class="sl-value" bind:text="gp_camera_shake | round">60</span>
            <div id="shake-hit" class="sl-hit" on:drag.value="set(gp_camera_shake, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-autosave" class="row">
            <span id="row-autosave-label" class="row-label">Auto-Save</span>
            <span id="autosave-state" class="sw-state" bind:text="gp_autosave | select(true: On, false: Off)">On</span>
            <div id="autosave-switch" class="sw on" on:click="sound(ui_confirm); set(gp_autosave, toggle)" bind:class.on="gp_autosave">
              <div id="autosave-knob" class="sw-knob"/>
            </div>
          </div>
          <div id="row-hints" class="row">
            <span id="row-hints-label" class="row-label">Tutorial Hints</span>
            <span id="hints-state" class="sw-state" bind:text="gp_hints | select(true: On, false: Off)">On</span>
            <div id="hints-switch" class="sw on" on:click="sound(ui_confirm); set(gp_hints, toggle)" bind:class.on="gp_hints">
              <div id="hints-knob" class="sw-knob"/>
            </div>
          </div>
          <div id="row-language" class="row last">
            <span id="row-language-label" class="row-label">Language</span>
            <div id="language-box" class="box">
              <span id="language-text" class="box-cycle">&lt;   English   &gt;</span>
            </div>
          </div>
        </div>
        <div id="panel-graphics" class="panel off" bind:class.off="tab | ne(2)">
          <span id="panel-graphics-heading" class="panel-heading">Graphics</span>
          <span id="panel-graphics-desc" class="panel-desc">Resolution, light and the grain of old film.</span>
          <div id="panel-graphics-divider" class="panel-divider"/>
          <div id="row-resolution" class="row">
            <span id="row-resolution-label" class="row-label">Resolution</span>
            <div id="resolution-box" class="box">
              <span id="resolution-text" class="box-cycle">&lt;   1920 x 1080   &gt;</span>
            </div>
          </div>
          <div id="row-display" class="row">
            <span id="row-display-label" class="row-label">Display Mode</span>
            <div id="display-box" class="box">
              <span id="display-text" class="box-cycle">&lt;   Fullscreen   &gt;</span>
            </div>
          </div>
          <div id="row-brightness" class="row">
            <span id="row-brightness-label" class="row-label">Brightness</span>
            <div id="brightness-track" class="sl-track">
              <div id="brightness-fill" class="sl-fill s-50c8d7" bind:width="gfx_brightness | range(0,100,0%,100%)">
                <div id="brightness-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="brightness-value" class="sl-value" bind:text="gfx_brightness | round">50</span>
            <div id="brightness-hit" class="sl-hit" on:drag.value="set(gfx_brightness, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-vsync" class="row">
            <span id="row-vsync-label" class="row-label">VSync</span>
            <span id="vsync-state" class="sw-state" bind:text="gfx_vsync | select(true: On, false: Off)">On</span>
            <div id="vsync-switch" class="sw on" on:click="sound(ui_confirm); set(gfx_vsync, toggle)" bind:class.on="gfx_vsync">
              <div id="vsync-knob" class="sw-knob"/>
            </div>
          </div>
          <div id="row-grain" class="row last">
            <span id="row-grain-label" class="row-label">Film Grain</span>
            <span id="grain-state" class="sw-state" bind:text="gfx_grain | select(true: On, false: Off)">Off</span>
            <div id="grain-switch" class="sw" on:click="sound(ui_confirm); set(gfx_grain, toggle)" bind:class.on="gfx_grain">
              <div id="grain-knob" class="sw-knob"/>
            </div>
          </div>
        </div>
        <div id="panel-audio" class="panel" bind:class.off="tab | ne(0)">
          <span id="panel-audio-heading" class="panel-heading">Audio</span>
          <span id="panel-audio-desc" class="panel-desc">Balance the hospital's silence against everything that breaks it.</span>
          <div id="panel-audio-divider" class="panel-divider"/>
          <div id="row-master" class="row">
            <span id="row-master-label" class="row-label">Master Volume</span>
            <div id="master-track" class="sl-track">
              <div id="master-fill" class="sl-fill" bind:width="master_volume | range(0,100,0%,100%)">
                <div id="master-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="master-value" class="sl-value" bind:text="master_volume | round">80</span>
            <div id="master-hit" class="sl-hit" on:drag.value="set(master_volume, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-music" class="row">
            <span id="row-music-label" class="row-label">Music</span>
            <div id="music-track" class="sl-track">
              <div id="music-fill" class="sl-fill s-b36e42" bind:width="music_volume | range(0,100,0%,100%)">
                <div id="music-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="music-value" class="sl-value" bind:text="music_volume | round">60</span>
            <div id="music-hit" class="sl-hit" on:drag.value="set(music_volume, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-sfx" class="row">
            <span id="row-sfx-label" class="row-label">Sound Effects</span>
            <div id="sfx-track" class="sl-track">
              <div id="sfx-fill" class="sl-fill" bind:width="sfx_volume | range(0,100,0%,100%)">
                <div id="sfx-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="sfx-value" class="sl-value" bind:text="sfx_volume | round">75</span>
            <div id="sfx-hit" class="sl-hit" on:drag.value="set(sfx_volume, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-dialogue" class="row">
            <span id="row-dialogue-label" class="row-label">Dialogue</span>
            <div id="dialogue-track" class="sl-track">
              <div id="dialogue-fill" class="sl-fill" bind:width="dialogue_volume | range(0,100,0%,100%)">
                <div id="dialogue-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="dialogue-value" class="sl-value" bind:text="dialogue_volume | round">90</span>
            <div id="dialogue-hit" class="sl-hit" on:drag.value="set(dialogue_volume, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-output" class="row">
            <span id="row-output-label" class="row-label">Output Device</span>
            <div id="output-box" class="box" on:click="sound(ui_confirm); emit(open_output_device)">
              <span id="output-text" class="box-text" bind:text="output_device">Headphones (Realtek)</span>
              <svg id="output-chevron" viewBox="0 0 18 18">
                <path id="Chevron" d="M4.5 6.75 L9 11.25 L13.5 6.75" fill="none" stroke="#e8e2d4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          <div id="row-range" class="row">
            <span id="row-range-label" class="row-label">Dynamic Range</span>
            <div id="range-prev" class="step-arrow" on:click="sound(ui_hover); emit(audio_mode_prev)">
              <svg id="range-prev-icon" class="s-84da9f" viewBox="0 0 42 42">
                <path id="Arrow" d="M24 14 L17 21 L24 28" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span id="range-value" class="step-value" bind:text="audio_mode">Night Mode</span>
            <div id="range-next" class="step-arrow" on:click="sound(ui_hover); emit(audio_mode_next)">
              <svg id="range-next-icon" class="s-84da9f" viewBox="0 0 42 42">
                <path id="Arrow" d="M18 14 L25 21 L18 28" fill="none" stroke="#e8e2d4" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          <div id="row-subtitles" class="row">
            <span id="row-subtitles-label" class="row-label">Subtitles</span>
            <span id="subtitles-state" class="sw-state" bind:text="subtitles | select(true: On, false: Off)">On</span>
            <div id="subtitles-switch" class="sw on" on:click="sound(ui_confirm); set(subtitles, toggle); emit(toggle_subtitles)" bind:class.on="subtitles">
              <div id="subtitles-knob" class="sw-knob"/>
            </div>
          </div>
          <div id="row-test" class="row last">
            <span id="row-test-label" class="row-label">Test Audio</span>
            <div id="test-button" class="box btn" on:click="sound(ui_confirm); emit(play_test_sound)">
              <span id="test-text" class="btn-text">Play Test Sound</span>
            </div>
          </div>
        </div>
        <div id="panel-controls" class="panel off" bind:class.off="tab | ne(3)">
          <span id="panel-controls-heading" class="panel-heading">Controls</span>
          <span id="panel-controls-desc" class="panel-desc">Mouse, keyboard and what each key does.</span>
          <div id="panel-controls-divider" class="panel-divider"/>
          <div id="row-sensitivity" class="row">
            <span id="row-sensitivity-label" class="row-label">Mouse Sensitivity</span>
            <div id="sensitivity-track" class="sl-track">
              <div id="sensitivity-fill" class="sl-fill" bind:width="ctl_sensitivity | range(0,100,0%,100%)">
                <div id="sensitivity-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="sensitivity-value" class="sl-value" bind:text="ctl_sensitivity | round">40</span>
            <div id="sensitivity-hit" class="sl-hit" on:drag.value="set(ctl_sensitivity, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-invert" class="row">
            <span id="row-invert-label" class="row-label">Invert Y Axis</span>
            <span id="invert-state" class="sw-state" bind:text="ctl_invert_y | select(true: On, false: Off)">Off</span>
            <div id="invert-switch" class="sw" on:click="sound(ui_confirm); set(ctl_invert_y, toggle)" bind:class.on="ctl_invert_y">
              <div id="invert-knob" class="sw-knob"/>
            </div>
          </div>
          <div id="row-forward" class="row">
            <span id="row-forward-label" class="row-label">Move Forward</span>
            <div id="forward-box" class="box">
              <span id="forward-text" class="box-text">W</span>
            </div>
          </div>
          <div id="row-interact" class="row">
            <span id="row-interact-label" class="row-label">Interact</span>
            <div id="interact-box" class="box">
              <span id="interact-text" class="box-text">E</span>
            </div>
          </div>
          <div id="row-flashlight" class="row last">
            <span id="row-flashlight-label" class="row-label">Flashlight</span>
            <div id="flashlight-box" class="box">
              <span id="flashlight-text" class="box-text">F</span>
            </div>
          </div>
        </div>
        <div id="panel-accessibility" class="panel off" bind:class.off="tab | ne(4)">
          <span id="panel-accessibility-heading" class="panel-heading">Accessibility</span>
          <span id="panel-accessibility-desc" class="panel-desc">Make the dark easier to read.</span>
          <div id="panel-accessibility-divider" class="panel-divider"/>
          <div id="row-subsize" class="row">
            <span id="row-subsize-label" class="row-label">Subtitle Size</span>
            <div id="subsize-box" class="box">
              <span id="subsize-text" class="box-cycle">&lt;   Medium   &gt;</span>
            </div>
          </div>
          <div id="row-colourblind" class="row">
            <span id="row-colourblind-label" class="row-label">Colour Blind Mode</span>
            <div id="colourblind-box" class="box">
              <span id="colourblind-text" class="box-cycle">&lt;   Off   &gt;</span>
            </div>
          </div>
          <div id="row-contrast" class="row">
            <span id="row-contrast-label" class="row-label">High Contrast</span>
            <span id="contrast-state" class="sw-state" bind:text="acc_contrast | select(true: On, false: Off)">Off</span>
            <div id="contrast-switch" class="sw" on:click="sound(ui_confirm); set(acc_contrast, toggle)" bind:class.on="acc_contrast">
              <div id="contrast-knob" class="sw-knob"/>
            </div>
          </div>
          <div id="row-textsize" class="row last">
            <span id="row-textsize-label" class="row-label">Text Size</span>
            <div id="textsize-track" class="sl-track">
              <div id="textsize-fill" class="sl-fill s-50c8d7" bind:width="acc_text_size | range(0,100,0%,100%)">
                <div id="textsize-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="textsize-value" class="sl-value" bind:text="acc_text_size | round">50</span>
            <div id="textsize-hit" class="sl-hit" on:drag.value="set(acc_text_size, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
        </div>
        <div id="panel-microphone" class="panel off" bind:class.off="tab | ne(5)">
          <span id="panel-microphone-heading" class="panel-heading">Microphone</span>
          <span id="panel-microphone-desc" class="panel-desc">Input device and voice chat.</span>
          <div id="panel-microphone-divider" class="panel-divider"/>
          <div id="row-indevice" class="row">
            <span id="row-indevice-label" class="row-label">Input Device</span>
            <div id="indevice-box" class="box">
              <span id="indevice-text" class="box-cycle">&lt;   Default Microphone   &gt;</span>
            </div>
          </div>
          <div id="row-involume" class="row">
            <span id="row-involume-label" class="row-label">Input Volume</span>
            <div id="involume-track" class="sl-track">
              <div id="involume-fill" class="sl-fill" bind:width="mic_input_volume | range(0,100,0%,100%)">
                <div id="involume-knob" class="sl-knob"/>
              </div>
            </div>
            <span id="involume-value" class="sl-value" bind:text="mic_input_volume | round">70</span>
            <div id="involume-hit" class="sl-hit" on:drag.value="set(mic_input_volume, event.value | range(0,1,0,100) | round)" draggable="axis-x"/>
          </div>
          <div id="row-voicechat" class="row">
            <span id="row-voicechat-label" class="row-label">Voice Chat</span>
            <span id="voicechat-state" class="sw-state" bind:text="mic_voice_chat | select(true: On, false: Off)">On</span>
            <div id="voicechat-switch" class="sw on" on:click="sound(ui_confirm); set(mic_voice_chat, toggle)" bind:class.on="mic_voice_chat">
              <div id="voicechat-knob" class="sw-knob"/>
            </div>
          </div>
          <div id="row-ptt" class="row last">
            <span id="row-ptt-label" class="row-label">Push to Talk</span>
            <span id="ptt-state" class="sw-state" bind:text="mic_push_to_talk | select(true: On, false: Off)">Off</span>
            <div id="ptt-switch" class="sw" on:click="sound(ui_confirm); set(mic_push_to_talk, toggle)" bind:class.on="mic_push_to_talk">
              <div id="ptt-knob" class="sw-knob"/>
            </div>
          </div>
        </div>
      </div>
      <div id="settings-footer">
        <span id="settings-version">v1.0.0</span>
        <div id="settings-hints">
          <div id="hint-apply" class="chip" on:click="sound(ui_confirm); emit(apply_settings)" on:hover="sound(ui_hover)">
            <span id="key-a" class="key">A</span>
            <span id="hint-apply-text" class="hint">Apply</span>
          </div>
          <div id="sep-1" class="sep"/>
          <div id="hint-reset" class="chip" on:click="sound(ui_confirm); set(master_volume, 80); set(music_volume, 60); set(sfx_volume, 75); set(dialogue_volume, 90); set(output_device, &quot;Headphones (Realtek)&quot;); set(audio_mode, &quot;Night Mode&quot;); set(subtitles, true); set(gp_camera_shake, 60); set(gp_autosave, true); set(gp_hints, true); set(gfx_brightness, 50); set(gfx_vsync, true); set(gfx_grain, false); set(ctl_sensitivity, 40); set(ctl_invert_y, false); set(acc_contrast, false); set(acc_text_size, 50); set(mic_input_volume, 70); set(mic_voice_chat, true); set(mic_push_to_talk, false); emit(reset_defaults)" on:hover="sound(ui_hover)">
            <span id="key-r" class="key">R</span>
            <span id="hint-reset-text" class="hint">Reset to Defaults</span>
          </div>
          <div id="sep-2" class="sep"/>
          <div id="hint-back" class="chip" on:click="sound(ui_back); emit(back)" on:hover="sound(ui_hover)">
            <span id="key-b" class="key">B</span>
            <span id="hint-back-text" class="hint">Back</span>
          </div>
        </div>
      </div>
    </div>
  </body>
</xt>
