{
  "name": "XtendUI game UI",
  "version": 1,
  "themes": {
    "dark": {
      "bg": "#0b0f14",
      "panel": "#161b22e6",
      "panelBorder": "#30363d",
      "text": "#e6edf3",
      "textDim": "#8b949e",
      "accent": "#2f81f7",
      "accentText": "#ffffff",
      "success": "#2ea043",
      "danger": "#da3633",
      "warning": "#d29922"
    }
  },
  "font": {
    "family": "\"Segoe UI\", \"Noto Sans\", sans-serif",
    "label": { "size": 12, "weight": 600, "letterSpacing": 2, "transform": "uppercase" },
    "body": { "size": 14, "weight": 400 },
    "title": { "size": 22, "weight": 600 },
    "display": { "size": 48, "weight": 700 }
  },
  "space": [4, 8, 12, 16, 20, 24, 32, 48],
  "radius": { "chip": 6, "button": 8, "panel": 12, "tile": 14 },
  "shadow": { "panel": "0 10px 28px 0 #0000008c" },
  "board": { "width": 1280, "height": 720 }
}
