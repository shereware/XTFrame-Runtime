.menu-item {
  position: relative;
  width: 332px;
  height: 64px;
  padding-top: 0px;
  padding-right: 16px;
  padding-bottom: 0px;
  padding-left: 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18px;
  background-color: #ffffff00;
  border: 0px #ffffff00;
  border-radius: 18px;
  cursor: pointer;
}

.item-hl {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 100%;
  height: 100%;
  border-radius: 18px;
  background-color: #fff8e2c7;
  opacity: 0;
  transition: opacity 160ms linear;
}

.menu-item:hover .item-hl {
  opacity: 1;
}

.icon-wrap {
  position: relative;
  width: 52px;
  height: 52px;
}

.icon {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 52px;
  height: 52px;
  object-fit: contain;
}

.icon-color {
  opacity: 0;
  transition: opacity 160ms linear;
}

.menu-item:hover .icon-color {
  opacity: 1;
}

.label-wrap {
  position: relative;
  width: 230px;
  height: 40px;
}

.label {
  position: absolute;
  left: 0px;
  top: 0px;
  font-family: 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
  font-size: 30px;
  line-height: 40px;
  font-weight: 700;
  letter-spacing: 1px;
  white-space: nowrap;
}

.label-gray {
  color: #6e6e6e;
}

.label-color {
  opacity: 0;
  transition: opacity 160ms linear;
}

.menu-item:hover .label-color {
  opacity: 1;
}

.title {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 600px;
  height: 140px;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
  text-align: center;
  font-size: 112px;
  line-height: 140px;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 2px;
  text-effect: shadow 0px 0px 8px #ffffffe6, shadow 0px 2px 2px #ffffffb3;
}

@keyframes fireflies-rise {
  from { transform: translateY(0px); }
  to { transform: translateY(-720px); }
}

@keyframes petals-fall {
  from { transform: translateY(-720px); }
  to { transform: translateY(0px); }
}

@media (prefers-reduced-motion: reduce) {
  #fx-fireflies { animation: fireflies-rise 60s linear 0s infinite paused }
  #fx-petals { animation: petals-fall 26s linear 0s infinite paused }
}

@timeline bloom {
  #bg-color { 0ms { opacity: 0; } 1800ms { opacity: 1; } }
  #fx-petals-gray { 0ms { opacity: 1; } 1800ms { opacity: 0; } }
  #fx-petals-color { 0ms { opacity: 0; } 1800ms { opacity: 1; } }
  #title-color { 0ms { opacity: 0; } 1800ms { opacity: 1; } }
  #garland-color { 200ms { opacity: 0; } 1800ms { opacity: 1; } }
  #panel-warm { 0ms { opacity: 0; } 1800ms { opacity: 1; } }
  #corner-tr-color { 300ms { opacity: 0; } 1800ms { opacity: 1; } }
  #corner-bl-color { 500ms { opacity: 0; } 1800ms { opacity: 1; } }
  #item-new-icon-color { 0ms { opacity: 1; } 1800ms { opacity: 1; } }
  #item-new-label-color { 0ms { opacity: 1; } 1800ms { opacity: 1; } }
  #item-continue-icon-color { 150ms { opacity: 0; } 1800ms { opacity: 1; } }
  #item-continue-label-color { 150ms { opacity: 0; } 1800ms { opacity: 1; } }
  #item-option-icon-color { 300ms { opacity: 0; } 1800ms { opacity: 1; } }
  #item-option-label-color { 300ms { opacity: 0; } 1800ms { opacity: 1; } }
  #item-credits-icon-color { 450ms { opacity: 0; } 1800ms { opacity: 1; } }
  #item-credits-label-color { 450ms { opacity: 0; } 1800ms { opacity: 1; } }
}

@timeline intro {
  #title-group { 0ms { opacity: 0; } 360ms { opacity: 1; } }
  #menu-panel { 60ms { opacity: 0; transform: translateX(-24px); } 420ms ease-out { opacity: 1; transform: translateX(0px); } }
}

